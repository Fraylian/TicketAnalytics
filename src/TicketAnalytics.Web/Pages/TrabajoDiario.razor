@*
   ====================================================================
   DIARIO TI DESACTIVADO (2026-10-12)
   La sección se retiró del aplicativo por decisión funcional. El archivo
   se conserva intacto para poder retomarla: para reactivarla basta con
   restaurar la directiva de abajo, el enlace del menú en MainLayout.razor
   y el mapeo de endpoints / servicio en el backend (ver comentarios
   "Diario TI desactivado" en Program.cs y DependencyInjection.cs).

@page "/trabajo-diario"
   ====================================================================
*@
@inject TicketAnalyticsApi Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject UiService Ui
@inject FileDownloadService Descargas
@implements IDisposable

<PageTitle>Diario TI · TicketAnalytics</PageTitle>

<PageHeader Titulo="Diario de actividades TI" Icono="@Icons.Material.Filled.EditCalendar"
            Bajada="@($"Registro y seguimiento del trabajo del equipo · {DateTime.Today.ToString("dddd dd 'de' MMMM", Formato.Cultura)}")"
            UltimaActualizacion="_ultimaCarga" Actualizando="_cargando" OnRefrescar="RecargarTodo">
    <Acciones>
        <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@(_exportando ? null : Icons.Material.Filled.TableView)"
                   OnClick="ExportarExcel" Disabled="_exportando">
            @if (_exportando) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /><span>Generando…</span> }
            else { <span>Excel</span> }
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@(_formVisible ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.Add)"
                   OnClick="@(() => _formVisible = !_formVisible)">
            @(_formVisible ? "Ocultar formulario" : "Nueva actividad")
        </MudButton>
    </Acciones>
</PageHeader>

<!-- ===== FORMULARIO (plegable) ===== -->
<MudCollapse Expanded="_formVisible">
<div class="panel mb-4" id="form-actividad" style="border-top:3px solid var(--bsc-azul)">
    <div class="panel-cab">
        <div>
            <h2 class="panel-titulo">
                <MudIcon Icon="@Icons.Material.Filled.EditNote" Size="Size.Small" Color="Color.Primary" />
                @(_form.ActividadId.HasValue ? "Editar actividad" : "Nueva actividad")
            </h2>
            <div class="panel-sub">Los campos con * son obligatorios. Si eliges un ticket real, la actividad queda enlazada a MDB.</div>
        </div>
        @if (_form.ActividadId.HasValue)
        {
            <span class="ta-tag info"><MudIcon Icon="@Icons.Material.Filled.Edit" Style="font-size:14px" /> Editando registro #@_form.ActividadId</span>
        }
    </div>

    <MudGrid Spacing="3">
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker Label="Fecha *" @bind-Date="_fecha" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="int" @bind-Value="_form.TecnicoId" Label="Técnico TI *" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"
                       ToStringFunc="@(id => _tecnicos.FirstOrDefault(t => t.TecnicoId == id)?.Nombre ?? "")">
                @foreach (var t in _tecnicos)
                {
                    <MudSelectItem T="int" Value="@t.TecnicoId">@t.Nombre</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="int" @bind-Value="_form.Tipo" Label="Tipo *" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true">
                @foreach (var t in TrabajoDiarioCatalogos.Tipos)
                {
                    <MudSelectItem T="int" Value="@t.Id">@t.Texto</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudAutocomplete T="OpcionTicketDto" Label="No. Solicitud / Ticket" @bind-Value="_ticketSel"
                             SearchFunc="BuscarTickets" ToStringFunc="@(o => o?.RefNum ?? "")"
                             Variant="Variant.Outlined" Margin="Margin.Dense" CoerceText="false" CoerceValue="true"
                             DebounceInterval="300" MinCharacters="3" Clearable="true"
                             AdornmentIcon="@Icons.Material.Filled.Search"
                             HelperText="Escribe 3+ caracteres para buscar en MDB">
                <ItemTemplate Context="op">
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.body2"><b>@op.RefNum</b> · @(op.TipoVinculo == "chg" ? "OC" : "Ticket")</MudText>
                        @if (!string.IsNullOrEmpty(op.Descripcion))
                        {
                            <MudText Typo="Typo.caption" Class="ta-muted">@op.Descripcion</MudText>
                        }
                    </div>
                </ItemTemplate>
                <NoItemsTemplate>
                    <MudText Typo="Typo.caption" Class="pa-2">Sin coincidencias. Puedes escribirlo libre abajo.</MudText>
                </NoItemsTemplate>
            </MudAutocomplete>
            <MudTextField @bind-Value="_form.NoSolicitud" Placeholder="O escríbelo libre: JIRA-101" Variant="Variant.Text" Margin="Margin.Dense" Class="mt-1" MaxLength="60" />
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="_form.Proyecto" Label="Proyecto" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="EIKON, Nómina…" MaxLength="120" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudNumericField @bind-Value="_form.Horas" Label="Horas trabajadas *" Variant="Variant.Outlined" Margin="Margin.Dense"
                             Min="0" Max="24" Step="0.25M" Format="0.##" Required="true" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="int" @bind-Value="_form.Estado" Label="Estado *" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true">
                @foreach (var e in TrabajoDiarioCatalogos.Estados)
                {
                    <MudSelectItem T="int" Value="@e.Id">@e.Texto</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="_form.Usuario" Label="Tu nombre (auditoría)" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>

        @* Clasificación en conjunto con la gestión: sistema → proveedor → tipo de solución *@
        <MudItem xs="12" sm="4">
            <MudSelect T="int?" Value="_form.SistemaId" ValueChanged="OnSistemaActividadChanged" Label="Sistema" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="El proveedor se completa solo">
                @foreach (var s in SistemasActividad)
                {
                    <MudSelectItem T="int?" Value="@((int?)s.Valor)">@s.Nombre</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSelect T="int?" Value="_form.ProveedorId" ValueChanged="OnProveedorActividadChanged" Label="Proveedor" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@ProveedorFijadoPorSistema"
                       HelperText="@(ProveedorFijadoPorSistema ? "Definido por el sistema" : "Filtra los sistemas de ese proveedor")">
                @foreach (var p in _catalogos.Proveedores)
                {
                    <MudSelectItem T="int?" Value="@((int?)p.Valor)">@p.Nombre</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSelect T="int?" @bind-Value="_form.TipoSolucion" Label="Tipo de solución" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var t in _catalogos.TiposSolucion)
                {
                    <MudSelectItem T="int?" Value="@((int?)t.Valor)">@t.Nombre</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12">
            <MudTextField @bind-Value="_form.Actividad" Label="Actividad realizada *" Variant="Variant.Outlined"
                          Lines="2" Placeholder="Describe el trabajo de manera específica…" Required="true" />
        </MudItem>
        <MudItem xs="12">
            <MudTextField @bind-Value="_form.Comentario" Label="Comentarios / observaciones" Variant="Variant.Outlined"
                          Lines="2" Placeholder="Opcional: bloqueos, resultados…" />
        </MudItem>

        <MudItem xs="12" Class="d-flex justify-end gap-2">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LimpiarForm">
                @(_form.ActividadId.HasValue ? "Cancelar edición" : "Limpiar")
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save"
                       OnClick="Guardar" Disabled="@(_guardando || !FormularioValido)">
                @(_guardando ? "Guardando…" : _form.ActividadId.HasValue ? "Actualizar" : "Guardar actividad")
            </MudButton>
        </MudItem>
    </MudGrid>
</div>
</MudCollapse>

<!-- ===== Filtros ===== -->
<div class="ta-filtros">
    <div class="ta-pills fila-pills">
        <span class="lbl">Período:</span>
        @foreach (var (label, dias) in RangosRapidos)
        {
            <button type="button" class="@($"ta-pill {(_rangoActivo == label ? "activa" : "")}")" @onclick="@(() => AplicarRango(label, dias))">@label</button>
        }
        <span class="lbl ml-3">Estado:</span>
        @foreach (var (id, texto, color) in EstadosRapidos)
        {
            <button type="button" class="@($"ta-pill {(_filtro.Estado == id ? "activa" : "")}")" style="@($"--pill:{color}")"
                    @onclick="@(() => FiltrarEstado(id))">@texto</button>
        }
    </div>
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="int?" Value="_filtro.TecnicoId" ValueChanged="OnTecnicoChanged" Label="Técnico" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var t in _tecnicos)
                {
                    <MudSelectItem T="int?" Value="@((int?)t.TecnicoId)">@t.Nombre</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="int?" Value="_filtro.Tipo" ValueChanged="OnTipoChanged" Label="Tipo" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var t in TrabajoDiarioCatalogos.Tipos)
                {
                    <MudSelectItem T="int?" Value="@((int?)t.Id)">@t.Texto</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField T="string" Value="_filtro.Texto" ValueChanged="OnTextoChanged" Immediate="true" Clearable="true"
                          Label="Buscar en actividad, proyecto, solicitud o técnico" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>
    </MudGrid>
    <ActiveFilterChips Filtros="FiltrosActivos" OnQuitar="QuitarFiltro" OnLimpiarTodo="LimpiarFiltros" />
</div>

@* Navegación por secciones *@
<div class="ta-pills mb-2">
    <span class="lbl">Ir a:</span>
    @foreach (var (id, texto) in Secciones)
    {
        <button type="button" class="ta-pill" @onclick="@(() => Ui.IrAAsync(id))">@texto</button>
    }
</div>

<div class="@(_cargando ? "ta-actualizando" : "")" @key="_version">

<!-- ===== 1. RESUMEN ===== -->
<SeccionBloque Id="s-resumen" Titulo="Resumen" Icono="@Icons.Material.Filled.Dashboard" Primero="true"
               Bajada="Indicadores del período filtrado y comparación con el período anterior" />

<MudGrid Spacing="3" Class="ta-stagger">
    <MudItem xs="6" md="4" lg="2"><KpiCard Titulo="Actividades" Valor="@_resumen.TotalActividades.ToString()" Icono="@Icons.Material.Filled.Assignment" Acento="azul" Tendencia="@TendenciaActividades" Sparkline="@SparkHoras" /></MudItem>
    <MudItem xs="6" md="4" lg="2"><KpiCard Titulo="Horas" Valor="@($"{_resumen.TotalHoras:0.0}h")" Icono="@Icons.Material.Filled.Schedule" Acento="verde" Tendencia="@TendenciaHoras" /></MudItem>
    <MudItem xs="6" md="4" lg="2"><KpiCard Titulo="Completadas" Valor="@_resumen.Completadas.ToString()" Icono="@Icons.Material.Filled.CheckCircle" Acento="cumplido" Progreso="@_resumen.PctCompletadas" Nota="@($"{_resumen.PctCompletadas:0.#}% del total")" Activo="@(_filtro.Estado == 2)" TextoAccion="Filtrar" OnClick="@(() => FiltrarEstado(2))" /></MudItem>
    <MudItem xs="6" md="4" lg="2"><KpiCard Titulo="Pendientes" Valor="@_resumen.Pendientes.ToString()" Icono="@Icons.Material.Filled.PendingActions" Acento="riesgo" Activo="@(_filtro.Estado == 0)" TextoAccion="Filtrar" OnClick="@(() => FiltrarEstado(0))" /></MudItem>
    <MudItem xs="6" md="4" lg="2"><KpiCard Titulo="En proceso" Valor="@_resumen.EnProceso.ToString()" Icono="@Icons.Material.Filled.Autorenew" Acento="azul" Activo="@(_filtro.Estado == 1)" TextoAccion="Filtrar" OnClick="@(() => FiltrarEstado(1))" /></MudItem>
    <MudItem xs="6" md="4" lg="2"><KpiCard Titulo="Bloqueadas" Valor="@_resumen.Bloqueadas.ToString()" Icono="@Icons.Material.Filled.Block" Acento="vencido" Activo="@(_filtro.Estado == 3)" TextoAccion="Filtrar" OnClick="@(() => FiltrarEstado(3))" /></MudItem>
</MudGrid>
<MudGrid Spacing="3" Class="mt-0 ta-stagger">
    <MudItem xs="6" md="4" lg="2"><KpiCard Titulo="Horas hoy" Valor="@($"{_resumen.HorasHoy:0.0}h")" Icono="@Icons.Material.Filled.Today" Acento="azul" /></MudItem>
    <MudItem xs="6" md="4" lg="2"><KpiCard Titulo="Horas semana" Valor="@($"{_resumen.HorasSemana:0.0}h")" Icono="@Icons.Material.Filled.DateRange" Acento="azul" /></MudItem>
    <MudItem xs="6" md="4" lg="2"><KpiCard Titulo="Horas mes" Valor="@($"{_resumen.HorasMes:0.0}h")" Icono="@Icons.Material.Filled.CalendarMonth" Acento="azul" /></MudItem>
    <MudItem xs="6" md="4" lg="2"><KpiCard Titulo="Prom. h/actividad" Valor="@($"{_resumen.PromedioHorasPorActividad:0.0}h")" Icono="@Icons.Material.Filled.Timelapse" Acento="neutro" /></MudItem>
    <MudItem xs="6" md="4" lg="2"><KpiCard Titulo="OC trabajadas" Valor="@_resumen.OrdenesCambioTrabajadas.ToString()" Icono="@Icons.Material.Filled.ChangeCircle" Acento="neutro" Activo="@(_filtro.Tipo == 0)" TextoAccion="Filtrar" OnClick="@(() => FiltrarTipo(0))" /></MudItem>
    <MudItem xs="6" md="4" lg="2"><KpiCard Titulo="Incidentes" Valor="@_resumen.IncidentesTrabajados.ToString()" Icono="@Icons.Material.Filled.ReportProblem" Acento="neutro" Activo="@(_filtro.Tipo == 1)" TextoAccion="Filtrar" OnClick="@(() => FiltrarTipo(1))" /></MudItem>
</MudGrid>

@if (!string.IsNullOrEmpty(_resumen.TecnicoMasHoras) || !string.IsNullOrEmpty(_resumen.ProyectoMasDedicacion))
{
    <MudGrid Spacing="3" Class="mt-0 ta-stagger">
        <MudItem xs="12" md="4"><KpiCard Titulo="Técnico con más horas" Valor="@(_resumen.TecnicoMasHoras ?? "—")" Icono="@Icons.Material.Filled.EmojiEvents" Acento="violeta" /></MudItem>
        <MudItem xs="12" md="4"><KpiCard Titulo="Técnico con más actividades" Valor="@(_resumen.TecnicoMasActividades ?? "—")" Icono="@Icons.Material.Filled.MilitaryTech" Acento="violeta" /></MudItem>
        <MudItem xs="12" md="4"><KpiCard Titulo="Proyecto con más dedicación" Valor="@(_resumen.ProyectoMasDedicacion ?? "—")" Icono="@Icons.Material.Filled.WorkHistory" Acento="violeta" /></MudItem>
    </MudGrid>
}

<!-- ===== 2. TENDENCIAS ===== -->
<SeccionBloque Id="s-tendencias" Titulo="Tendencias" Icono="@Icons.Material.Filled.ShowChart"
               Bajada="Cómo se distribuye el esfuerzo en el tiempo · clic en un día para ver solo sus actividades" />
<MudGrid Spacing="3">
    <MudItem xs="12" md="7">
        <ChartPanel Titulo="Horas por día" Icono="@Icons.Material.Filled.AreaChart" Vacio="@(!_resumen.HorasPorDia.Any())"
                    Clicable="true" Nota="Clic en un punto para filtrar ese día">
            <ApexChart TItem="HorasDiaDto" Options="_optDia" Height="280"
                       OnDataPointSelection="@((SelectedData<HorasDiaDto> e) => FiltrarDia(e.DataPoint?.Items?.FirstOrDefault()?.Dia))">
                <ApexPointSeries TItem="HorasDiaDto" Items="_resumen.HorasPorDia" Name="Horas"
                                 XValue="@(d => d.Dia.ToString("dd/MM"))" YValue="@(d => d.Horas)" SeriesType="SeriesType.Area" />
            </ApexChart>
        </ChartPanel>
    </MudItem>
    <MudItem xs="12" md="5">
        <ChartPanel Titulo="Horas por semana" Icono="@Icons.Material.Filled.ViewWeek" Vacio="@(!_resumen.HorasPorSemana.Any())">
            <ApexChart TItem="HorasPeriodoDto" Options="_optSemana" Height="280">
                <ApexPointSeries TItem="HorasPeriodoDto" Items="_resumen.HorasPorSemana" Name="Horas" XValue="@(x => x.Periodo)" YValue="@(x => x.Horas)" SeriesType="SeriesType.Bar" />
            </ApexChart>
        </ChartPanel>
    </MudItem>
</MudGrid>

<!-- ===== 3. DISTRIBUCIÓN ===== -->
<SeccionBloque Id="s-distribucion" Titulo="Distribución" Icono="@Icons.Material.Filled.DonutLarge"
               Bajada="En qué se va el tiempo · clic en una porción o barra para filtrar el registro" />
<MudGrid Spacing="3">
    <MudItem xs="12" md="4">
        <ChartPanel Titulo="Actividades por tipo" Icono="@Icons.Material.Filled.Category" Vacio="@(!_resumen.PorTipo.Any())" Clicable="true">
            <ApexChart TItem="ConteoDto" Options="_optTipo" Height="290"
                       OnDataPointSelection="@((SelectedData<ConteoDto> e) => FiltrarTipoPorTexto(e.DataPoint?.X?.ToString()))">
                <ApexPointSeries TItem="ConteoDto" Items="_resumen.PorTipo" Name="Tipo" XValue="@(x => x.Etiqueta)" YAggregate="@(g => g.Sum(x => x.Cantidad))" SeriesType="SeriesType.Donut" />
            </ApexChart>
        </ChartPanel>
    </MudItem>
    <MudItem xs="12" md="4">
        <ChartPanel Titulo="Por estado" Icono="@Icons.Material.Filled.PieChart" Vacio="@(!_resumen.PorEstado.Any())" Clicable="true">
            <ApexChart TItem="ConteoDto" Options="_optEstado" Height="290"
                       OnDataPointSelection="@((SelectedData<ConteoDto> e) => FiltrarEstadoPorTexto(e.DataPoint?.X?.ToString()))">
                <ApexPointSeries TItem="ConteoDto" Items="_resumen.PorEstado" Name="Estado" XValue="@(x => x.Etiqueta)" YAggregate="@(g => g.Sum(x => x.Cantidad))" SeriesType="SeriesType.Donut" />
            </ApexChart>
        </ChartPanel>
    </MudItem>
    <MudItem xs="12" md="4">
        <ChartPanel Titulo="Top proyectos por esfuerzo" Icono="@Icons.Material.Filled.WorkHistory" Vacio="@(!_resumen.HorasPorProyecto.Any())">
            <BarList Items="@_resumen.HorasPorProyecto.Select(p => new BarList.Item(p.Etiqueta, p.Etiqueta, (double)p.Horas, null, $"{p.Cantidad} act.")).ToList()"
                     Color="var(--dato-2)" Sufijo="h" MostrarPorcentaje="false" Seleccionado="@_filtro.Texto"
                     OnSeleccionar="@(i => FiltrarProyecto(i.Clave))" />
        </ChartPanel>
    </MudItem>
</MudGrid>

<!-- ===== 4. EQUIPO ===== -->
<SeccionBloque Id="s-equipo" Titulo="Equipo" Icono="@Icons.Material.Filled.Groups"
               Bajada="Carga de cada técnico · clic en un técnico para ver solo sus actividades" />
<MudGrid Spacing="3">
    <MudItem xs="12" md="5">
        <div class="panel ta-alto-total">
            <div class="panel-cab">
                <h2 class="panel-titulo"><MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" Color="Color.Primary" /> Carga por técnico</h2>
                @if (_tecnicoSel is not null)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.FilterAltOff" OnClick="@(() => FiltrarPorTecnico(_tecnicoSel!))">Quitar filtro</MudButton>
                }
            </div>
            @if (_resumen.PorTecnico.Any())
            {
                <div class="ta-stagger">
                @foreach (var t in _resumen.PorTecnico)
                {
                    var sel = _tecnicoSel == t.Tecnico;
                    <div class="@($"pa-2 mb-2 ta-clickable ta-hover-card {(sel ? "ta-tecnico-activo" : "")}")"
                         style="border:1px solid var(--bsc-borde);border-radius:10px"
                         role="button" tabindex="0" @onclick="@(() => FiltrarPorTecnico(t.Tecnico))">
                        <div class="d-flex justify-space-between align-center mb-1 gap-2">
                            <div class="d-flex align-center gap-2" style="min-width:0">
                                <span class="ta-avatar sm" style="@($"background:{Formato.ColorAvatar(t.Tecnico)}")">@Formato.Iniciales(t.Tecnico)</span>
                                <MudText Typo="Typo.body2" Style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><b>@t.Tecnico</b></MudText>
                                <span class="@($"ta-tag {(t.NivelCarga == "alta" ? "err" : t.NivelCarga == "media" ? "warn" : "ok")}")">carga @t.NivelCarga</span>
                            </div>
                            <b style="color:var(--bsc-azul)">@t.Horas.ToString("0.0")h</b>
                        </div>
                        <div class="kpi-prog" style="@($"--kpi-color:{(t.NivelCarga == "alta" ? "var(--op-vencido)" : "var(--bsc-azul)")}")">
                            <span style="@($"--w:{Math.Min(100, t.PctDelTotalHoras).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}%")"></span>
                        </div>
                        <div class="d-flex justify-space-between mt-1" style="font-size:.72rem">
                            <span class="ta-muted">@t.Completadas completadas · @t.PendientesEnProceso pendientes · @t.PctFinalizacion.ToString("0")% finalización</span>
                            @if (!string.IsNullOrEmpty(t.ProyectoPrincipal)) { <span class="ta-tenue">@t.ProyectoPrincipal</span> }
                        </div>
                    </div>
                }
                </div>
            }
            else { <EmptyState Mensaje="Sin registros en el período." /> }
        </div>
    </MudItem>
    <MudItem xs="12" md="7">
        <ChartPanel Titulo="Completadas contra pendientes" Icono="@Icons.Material.Filled.Compare" Vacio="@(!_resumen.CompletadasVsPendientes.Any())"
                    Clicable="true" Nota="Clic en un técnico para filtrar">
            <ApexChart TItem="CompletadasVsPendientesDto" Options="_optComp" Height="300"
                       OnDataPointSelection="@((SelectedData<CompletadasVsPendientesDto> e) => FiltrarPorTecnicoSiExiste(e.DataPoint?.Items?.FirstOrDefault()?.Tecnico))">
                <ApexPointSeries TItem="CompletadasVsPendientesDto" Items="_resumen.CompletadasVsPendientes" Name="Completadas" XValue="@(x => Formato.NombreCorto(x.Tecnico))" YValue="@(x => (decimal)x.Completadas)" SeriesType="SeriesType.Bar" />
                <ApexPointSeries TItem="CompletadasVsPendientesDto" Items="_resumen.CompletadasVsPendientes" Name="Pendientes" XValue="@(x => Formato.NombreCorto(x.Tecnico))" YValue="@(x => (decimal)x.Pendientes)" SeriesType="SeriesType.Bar" />
            </ApexChart>
        </ChartPanel>
        <div class="mt-3">
            <ChartPanel Titulo="Tickets atendidos por técnico" Icono="@Icons.Material.Filled.ConfirmationNumber" Vacio="@(!_resumen.TicketsPorTecnico.Any())">
                <BarList Items="@_resumen.TicketsPorTecnico.Select(x => new BarList.Item(x.Etiqueta, x.Etiqueta, x.Cantidad, Formato.ColorAvatar(x.Etiqueta))).ToList()"
                         OnSeleccionar="@(i => FiltrarPorTecnicoSiExiste(i.Clave))" Seleccionado="@_tecnicoSel" />
            </ChartPanel>
        </div>
    </MudItem>
</MudGrid>

</div>

<!-- ===== 5. REGISTRO ===== -->
<SeccionBloque Id="s-registro" Titulo="Registro" Icono="@Icons.Material.Filled.TableRows"
               Bajada="Todas las actividades del filtro · clic en el enlace MDB para ver la trazabilidad del caso" />
<div class="panel pa-0">
    <div class="d-flex justify-space-between align-center pa-4 pb-2 flex-wrap gap-2">
        <span class="ta-resumen-pag">
            @if (_totalTabla.HasValue) { <text><b>@_totalTabla</b> actividades · @_horasTabla.ToString("0.##") h en esta página</text> }
        </span>
    </div>
    <MudTable ServerData="CargarTabla" @ref="_tabla" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.Md" T="ActividadDto">
        <HeaderContent>
            <MudTh>Fecha</MudTh><MudTh>Técnico</MudTh><MudTh>Actividad</MudTh><MudTh>Tipo</MudTh>
            <MudTh>No. Solicitud</MudTh><MudTh>Sistema · solución</MudTh><MudTh>Proyecto</MudTh><MudTh Style="text-align:right">Horas</MudTh>
            <MudTh>Estado</MudTh><MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Fecha">@context.Fecha.ToString("dd/MM/yyyy")</MudTd>
            <MudTd DataLabel="Técnico">
                <div class="d-flex align-center gap-2">
                    <span class="ta-avatar sm" style="@($"background:{Formato.ColorAvatar(context.TecnicoNombre)}")">@Formato.Iniciales(context.TecnicoNombre)</span>
                    <b>@Formato.NombreCorto(context.TecnicoNombre)</b>
                </div>
            </MudTd>
            <MudTd DataLabel="Actividad" Style="max-width:280px">@context.Actividad</MudTd>
            <MudTd DataLabel="Tipo"><span class="ta-tag">@context.TipoTexto</span></MudTd>
            <MudTd DataLabel="No. Solicitud">
                @if (!string.IsNullOrEmpty(context.RefNumVinculado))
                {
                    <MudTooltip Text="@($"Enlazado a {(context.TipoVinculo == "chg" ? "OC" : "ticket")} de MDB · ver trazabilidad")">
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Text"
                                 Icon="@Icons.Material.Filled.Link" OnClick="@(() => VerDesglose(context.RefNumVinculado!))">@context.RefNumVinculado</MudChip>
                    </MudTooltip>
                }
                else if (!string.IsNullOrEmpty(context.NoSolicitud)) { <span>@context.NoSolicitud</span> }
                else { <span class="ta-tenue">—</span> }
            </MudTd>
            <MudTd DataLabel="Sistema · solución">
                @if (context.Sistema is null && context.TipoSolucionTexto is null && context.Proveedor is null) { <span class="ta-tenue">—</span> }
                else
                {
                    <div>@(context.Sistema ?? "Sin sistema")</div>
                    <small class="ta-tenue">@(context.Proveedor ?? "")@(context.Proveedor is not null && context.TipoSolucionTexto is not null ? " · " : "")@(context.TipoSolucionTexto ?? "")</small>
                }
            </MudTd>
            <MudTd DataLabel="Proyecto">@(context.Proyecto ?? "—")</MudTd>
            <MudTd DataLabel="Horas" Style="text-align:right"><b>@context.Horas.ToString("0.##")h</b></MudTd>
            <MudTd DataLabel="Estado">
                <MudChip T="string" Size="Size.Small" Color="@EstadoColor(context.Estado)" Variant="Variant.Filled">@context.EstadoTexto</MudChip>
            </MudTd>
            <MudTd DataLabel="Acciones">
                <MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" aria-label="Editar" OnClick="@(() => Editar(context))" /></MudTooltip>
                <MudTooltip Text="Eliminar"><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="Eliminar" OnClick="@(() => Eliminar(context))" /></MudTooltip>
                @if (!string.IsNullOrEmpty(context.Comentario))
                {
                    <MudTooltip Text="@context.Comentario"><MudIconButton Icon="@Icons.Material.Filled.Comment" Size="Size.Small" aria-label="Ver comentario" OnClick="@(() => VerComentario(context))" /></MudTooltip>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <EmptyState Mensaje="Sin actividades registradas para este filtro." TextoAccion="Registrar actividad" OnAccion="AbrirFormulario" />
        </NoRecordsContent>
        <LoadingContent>
            <div class="pa-4">@for (var i = 0; i < 5; i++) { <MudSkeleton Height="34px" Animation="Animation.Wave" Class="mb-1" /> }</div>
        </LoadingContent>
        <PagerContent><MudTablePager PageSizeOptions="new[]{10,25,50,100}" RowsPerPageString="Filas por página" InfoFormat="{first_item}–{last_item} de {all_items}" /></PagerContent>
    </MudTable>
</div>

@code {
    private static readonly (string Id, string Texto)[] Secciones =
    {
        ("s-resumen", "Resumen"), ("s-tendencias", "Tendencias"), ("s-distribucion", "Distribución"),
        ("s-equipo", "Equipo"), ("s-registro", "Registro")
    };

    private static readonly (int Id, string Texto, string Color)[] EstadosRapidos =
    {
        (0, "Pendientes", "#ED6C02"), (1, "En proceso", "#1976D2"), (3, "Bloqueadas", "#C62828"), (2, "Completadas", "#2E7D32")
    };

    private List<TecnicoDto> _tecnicos = new();
    private CatalogosGestionDto _catalogos = new();
    private GuardarActividadRequest _form = new();
    private DateTime? _fecha = DateTime.Today;
    private OpcionTicketDto? _ticketSel;
    private bool _guardando;
    private bool _exportando;
    private bool _cargando = true;
    private int _version;
    private Timer? _debounce;

    private ResumenJornadaDto _resumen = new();
    private ActividadFiltro _filtro = new();
    private MudTable<ActividadDto>? _tabla;
    private int? _totalTabla;
    private decimal _horasTabla;

    private bool _formVisible = true;
    private string? _tecnicoSel;
    private string _rangoActivo = "";
    private DateTime? _ultimaCarga;

    private readonly (string, int)[] RangosRapidos =
    {
        ("Hoy", 0), ("7 días", 7), ("Este mes", -1), ("Mes anterior", -2), ("30 días", 30)
    };

    private SistemaOpcion? SistemaActividad => _catalogos.Sistemas.FirstOrDefault(s => s.Valor == _form.SistemaId);

    /// <summary>Con un sistema que tiene proveedor, el proveedor no se elige: sale del sistema.</summary>
    private bool ProveedorFijadoPorSistema => SistemaActividad?.ProveedorId is not null;

    /// <summary>Si se eligió proveedor primero, solo sus sistemas.</summary>
    private IEnumerable<SistemaOpcion> SistemasActividad
        => _form.ProveedorId is null || ProveedorFijadoPorSistema
            ? _catalogos.Sistemas
            : _catalogos.Sistemas.Where(s => s.ProveedorId == _form.ProveedorId || s.Valor == _form.SistemaId);

    private void OnSistemaActividadChanged(int? id)
    {
        _form.SistemaId = id;
        var prov = SistemaActividad?.ProveedorId;
        if (prov is not null) _form.ProveedorId = prov;
    }

    private void OnProveedorActividadChanged(int? id)
    {
        _form.ProveedorId = id;
        if (id is not null && SistemaActividad is { ProveedorId: not null } s && s.ProveedorId != id) _form.SistemaId = null;
    }

    private bool FormularioValido => _form.TecnicoId > 0 && !string.IsNullOrWhiteSpace(_form.Actividad) && _form.Horas > 0 && _fecha.HasValue;

    private double? TendenciaActividades => _resumen.TotalActividadesAnterior == 0 ? null
        : Math.Round(100.0 * (_resumen.TotalActividades - _resumen.TotalActividadesAnterior) / _resumen.TotalActividadesAnterior, 0);
    private double? TendenciaHoras => _resumen.TotalHorasAnterior == 0 ? null
        : Math.Round(100.0 * (double)(_resumen.TotalHoras - _resumen.TotalHorasAnterior) / (double)_resumen.TotalHorasAnterior, 0);
    private List<double>? SparkHoras => _resumen.HorasPorDia.Count > 1 ? _resumen.HorasPorDia.Select(h => (double)h.Horas).ToList() : null;

    private static readonly List<string> ColoresTipo = new() { "#15528E", "#C62828", "#5A9BD5", "#76B82A", "#6B4EFF", "#0F3D6B" };
    private static readonly List<string> ColoresEstado = new() { "#ED6C02", "#1976D2", "#2E7D32", "#C62828", "#8FA3B8" };

    private readonly ApexChartOptions<HorasDiaDto> _optDia = ChartTheme.Area<HorasDiaDto>(new() { ChartTheme.Verde });
    private readonly ApexChartOptions<HorasPeriodoDto> _optSemana = ChartTheme.Barras<HorasPeriodoDto>(new() { ChartTheme.Azul }, etiquetas: true);
    private readonly ApexChartOptions<ConteoDto> _optTipo = ChartTheme.Dona<ConteoDto>(ColoresTipo, "Actividades");
    private readonly ApexChartOptions<ConteoDto> _optEstado = ChartTheme.Dona<ConteoDto>(ColoresEstado, "Actividades");
    private readonly ApexChartOptions<CompletadasVsPendientesDto> _optComp =
        ChartTheme.Apiladas<CompletadasVsPendientesDto>(new() { ChartTheme.Exito, ChartTheme.Ambar }, horizontal: true);

    protected override async Task OnInitializedAsync()
    {
        try { _catalogos = await Api.CatalogosGestionAsync(); }
        catch { /* sin catálogos los selectores de clasificación quedan vacíos; el registro sigue funcionando */ }
        try
        {
            var todos = await Api.TecnicosAsync();
            var grupo = await Api.GrupoAnalistasAsync();
            // Limitar a los analistas del grupo; si el filtro deja vacío, usar todos (respaldo seguro)
            var filtrados = todos.Where(t => grupo.Any(g =>
                g.Equals(t.Nombre, StringComparison.OrdinalIgnoreCase)
                || g.Contains(t.Nombre, StringComparison.OrdinalIgnoreCase)
                || t.Nombre.Contains(g, StringComparison.OrdinalIgnoreCase))).ToList();
            _tecnicos = filtrados.Any() ? filtrados : todos.ToList();

            if (!_tecnicos.Any())
            {
                try { await Api.SincronizarTecnicosAsync(); _tecnicos = (await Api.TecnicosAsync()).ToList(); } catch { }
            }
        }
        catch (Exception ex) { Snackbar.Add($"No se pudo cargar el catálogo de técnicos: {ex.Message}", Severity.Warning); }
        await CargarResumen();
    }

    private async Task<IEnumerable<OpcionTicketDto>> BuscarTickets(string valor, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(valor) || valor.Length < 3) return Array.Empty<OpcionTicketDto>();
        try { return await Api.BuscarTicketsMdbAsync(valor); }
        catch { return Array.Empty<OpcionTicketDto>(); }
    }

    private void LimpiarForm()
    {
        _form = new GuardarActividadRequest { Usuario = _form.Usuario };
        _fecha = DateTime.Today;
        _ticketSel = null;
    }

    private async Task AbrirFormulario()
    {
        _formVisible = true;
        StateHasChanged();
        await Task.Yield();
        await Ui.IrAAsync("form-actividad");
    }

    private async Task Guardar()
    {
        _guardando = true;
        try
        {
            _form.Fecha = DateOnly.FromDateTime(_fecha ?? DateTime.Today);
            // Si eligió un ticket real, enlazarlo; si no, queda el texto libre
            if (_ticketSel is not null)
            {
                _form.RefNumVinculado = _ticketSel.RefNum;
                _form.TipoVinculo = _ticketSel.TipoVinculo;
                if (string.IsNullOrWhiteSpace(_form.NoSolicitud)) _form.NoSolicitud = _ticketSel.RefNum;
            }
            var editando = _form.ActividadId.HasValue;
            await Api.GuardarActividadAsync(_form);
            Snackbar.Add(editando ? "Actividad actualizada" : "Actividad guardada", Severity.Success);
            LimpiarForm();
            await RecargarTodo();
        }
        catch (ApiException ex) { Snackbar.Add(ex.MensajeUsuario, Severity.Error); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _guardando = false; }
    }

    private async Task RecargarTodo()
    {
        await CargarResumen();
        if (_tabla is not null) await _tabla.ReloadServerData();
    }

    private async Task CargarResumen()
    {
        _cargando = true;
        StateHasChanged();
        try
        {
            _resumen = await Api.ResumenJornadaAsync(_filtro);
            _ultimaCarga = DateTime.Now;
            _version++;
        }
        catch (Exception ex) { Snackbar.Add($"No se pudo cargar el resumen: {(ex is ApiException a ? a.MensajeUsuario : ex.Message)}", Severity.Error); }
        finally { _cargando = false; StateHasChanged(); }
    }

    // ===== Filtros =====
    private async Task AplicarRango(string label, int dias)
    {
        _rangoActivo = _rangoActivo == label ? "" : label;
        if (_rangoActivo == "")
        {
            _filtro.FechaDesde = null; _filtro.FechaHasta = null;
        }
        else
        {
            var hoy = DateOnly.FromDateTime(DateTime.Today);
            if (dias == 0) { _filtro.FechaDesde = hoy; _filtro.FechaHasta = hoy; }
            else if (dias == -1) { _filtro.FechaDesde = new DateOnly(hoy.Year, hoy.Month, 1); _filtro.FechaHasta = hoy; }
            else if (dias == -2)
            {
                var primerMesAnt = new DateOnly(hoy.Year, hoy.Month, 1).AddMonths(-1);
                _filtro.FechaDesde = primerMesAnt; _filtro.FechaHasta = new DateOnly(hoy.Year, hoy.Month, 1).AddDays(-1);
            }
            else { _filtro.FechaDesde = hoy.AddDays(-dias); _filtro.FechaHasta = hoy; }
        }
        await RecargarTodo();
    }

    private async Task FiltrarDia(DateOnly? dia)
    {
        if (!dia.HasValue) return;
        _rangoActivo = "";
        _filtro.FechaDesde = dia; _filtro.FechaHasta = dia;
        await RecargarTodo();
        await Ui.IrAAsync("s-registro");
    }

    private async Task FiltrarEstado(int estado)
    {
        _filtro.Estado = _filtro.Estado == estado ? null : estado;
        await RecargarTodo();
    }

    private async Task FiltrarTipo(int tipo)
    {
        _filtro.Tipo = _filtro.Tipo == tipo ? null : tipo;
        await RecargarTodo();
    }

    private async Task FiltrarTipoPorTexto(string? texto)
    {
        var t = TrabajoDiarioCatalogos.Tipos.FirstOrDefault(x => x.Texto == texto);
        if (t.Texto is not null) await FiltrarTipo(t.Id);
    }

    private async Task FiltrarEstadoPorTexto(string? texto)
    {
        var e = TrabajoDiarioCatalogos.Estados.FirstOrDefault(x => x.Texto == texto);
        if (e.Texto is not null) await FiltrarEstado(e.Id);
    }

    private async Task FiltrarProyecto(string proyecto)
    {
        _filtro.Texto = _filtro.Texto == proyecto ? null : proyecto;
        await RecargarTodo();
    }

    private async Task OnTecnicoChanged(int? id)
    {
        _filtro.TecnicoId = id;
        _tecnicoSel = id.HasValue ? _tecnicos.FirstOrDefault(t => t.TecnicoId == id)?.Nombre : null;
        await RecargarTodo();
    }

    private async Task OnTipoChanged(int? tipo) { _filtro.Tipo = tipo; await RecargarTodo(); }

    private void OnTextoChanged(string? t)
    {
        _filtro.Texto = t;
        _debounce?.Dispose();
        _debounce = new Timer(_ => InvokeAsync(RecargarTodo), null, 400, Timeout.Infinite);
    }

    private async Task FiltrarPorTecnico(string tecnico)
    {
        if (_tecnicoSel == tecnico)
        {
            _tecnicoSel = null; _filtro.TecnicoId = null;
        }
        else
        {
            var t = _tecnicos.FirstOrDefault(x => x.Nombre == tecnico)
                    ?? _tecnicos.FirstOrDefault(x => tecnico.Contains(x.Nombre, StringComparison.OrdinalIgnoreCase));
            if (t is null) { Snackbar.Add($"{tecnico} no está en el catálogo de técnicos.", Severity.Info); return; }
            _tecnicoSel = tecnico;
            _filtro.TecnicoId = t.TecnicoId;
        }
        await RecargarTodo();
    }

    private Task FiltrarPorTecnicoSiExiste(string? tecnico)
        => string.IsNullOrWhiteSpace(tecnico) ? Task.CompletedTask : FiltrarPorTecnico(tecnico);

    private List<ActiveFilterChips.FiltroActivo> FiltrosActivos
    {
        get
        {
            var l = new List<ActiveFilterChips.FiltroActivo>();
            if (_filtro.FechaDesde.HasValue || _filtro.FechaHasta.HasValue)
            {
                var d = _filtro.FechaDesde?.ToString("dd/MM/yyyy");
                var h = _filtro.FechaHasta?.ToString("dd/MM/yyyy");
                l.Add(new("fechas", d == h ? $"Día {d}" : $"{d ?? "…"} – {h ?? "…"}"));
            }
            if (_filtro.TecnicoId.HasValue) l.Add(new("tecnico", $"Técnico: {_tecnicos.FirstOrDefault(t => t.TecnicoId == _filtro.TecnicoId)?.Nombre ?? _tecnicoSel}"));
            if (_filtro.Tipo.HasValue) l.Add(new("tipo", $"Tipo: {TrabajoDiarioCatalogos.TipoTexto(_filtro.Tipo.Value)}"));
            if (_filtro.Estado.HasValue) l.Add(new("estado", $"Estado: {TrabajoDiarioCatalogos.EstadoTexto(_filtro.Estado.Value)}"));
            if (!string.IsNullOrWhiteSpace(_filtro.Texto)) l.Add(new("texto", $"\"{_filtro.Texto}\""));
            return l;
        }
    }

    private async Task QuitarFiltro(ActiveFilterChips.FiltroActivo f)
    {
        switch (f.Clave)
        {
            case "fechas": _filtro.FechaDesde = null; _filtro.FechaHasta = null; _rangoActivo = ""; break;
            case "tecnico": _filtro.TecnicoId = null; _tecnicoSel = null; break;
            case "tipo": _filtro.Tipo = null; break;
            case "estado": _filtro.Estado = null; break;
            case "texto": _filtro.Texto = null; break;
        }
        await RecargarTodo();
    }

    private async Task LimpiarFiltros()
    {
        _filtro = new ActividadFiltro { PageSize = _filtro.PageSize };
        _tecnicoSel = null; _rangoActivo = "";
        await RecargarTodo();
    }

    private async Task<TableData<ActividadDto>> CargarTabla(TableState state, CancellationToken ct)
    {
        _filtro.Page = state.Page + 1;
        _filtro.PageSize = state.PageSize;
        try
        {
            var r = await Api.BuscarActividadesAsync(_filtro);
            _totalTabla = r.TotalCount;
            _horasTabla = r.Items.Sum(i => i.Horas);
            _ = InvokeAsync(StateHasChanged);
            return new TableData<ActividadDto> { Items = r.Items, TotalItems = r.TotalCount };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar: {(ex is ApiException a ? a.MensajeUsuario : ex.Message)}", Severity.Error);
            return new TableData<ActividadDto> { Items = new List<ActividadDto>(), TotalItems = 0 };
        }
    }

    private static Color EstadoColor(int estado) => estado switch
    {
        0 => Color.Warning,   // Pendiente
        1 => Color.Info,      // En proceso
        2 => Color.Success,   // Completado
        3 => Color.Error,     // Bloqueado
        _ => Color.Default    // Cancelado
    };

    private async Task Editar(ActividadDto a)
    {
        _form = new GuardarActividadRequest
        {
            ActividadId = a.ActividadId, TecnicoId = a.TecnicoId, Actividad = a.Actividad, Tipo = a.Tipo,
            NoSolicitud = a.NoSolicitud, RefNumVinculado = a.RefNumVinculado, TipoVinculo = a.TipoVinculo,
            Proyecto = a.Proyecto, Horas = a.Horas, Estado = a.Estado, Comentario = a.Comentario, Usuario = _form.Usuario,
            SistemaId = a.SistemaId, ProveedorId = a.ProveedorId, TipoSolucion = a.TipoSolucion > 0 ? a.TipoSolucion : null
        };
        _fecha = a.Fecha.ToDateTime(TimeOnly.MinValue);
        _ticketSel = string.IsNullOrEmpty(a.RefNumVinculado) ? null
            : new OpcionTicketDto { RefNum = a.RefNumVinculado, TipoVinculo = a.TipoVinculo ?? "cr" };
        await AbrirFormulario();
    }

    private async Task Eliminar(ActividadDto a)
    {
        var ok = await DialogService.ShowMessageBox("Eliminar actividad",
            $"¿Eliminar la actividad de {a.TecnicoNombre} del {a.Fecha:dd/MM/yyyy}?",
            yesText: "Eliminar", cancelText: "Cancelar");
        if (ok == true)
        {
            try { await Api.EliminarActividadAsync(a.ActividadId); Snackbar.Add("Actividad eliminada", Severity.Success); await RecargarTodo(); }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    private async Task VerComentario(ActividadDto a)
        => await DialogService.ShowMessageBox($"Comentario · {a.TecnicoNombre}", a.Comentario ?? "");

    private async Task VerDesglose(string refNum)
    {
        try
        {
            var acts = await Api.ActividadesDeTicketAsync(refNum);
            var horas = acts.Sum(x => x.Horas);
            var porTecnico = acts.Where(a => !string.IsNullOrEmpty(a.TecnicoNombre))
                .GroupBy(a => a.TecnicoNombre!)
                .Select(g => $"{g.Key}: {g.Sum(x => x.Horas):0.##}h")
                .ToList();

            var p = new DialogParameters
            {
                ["RefNum"] = refNum,
                ["ResumenHoras"] = $"{acts.Count} actividades · {horas:0.##} horas en total",
                ["DetalleTecnicos"] = porTecnico
            };
            await DialogService.ShowAsync<TimelineDialog>($"Trazabilidad · {refNum}", p,
                new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        }
        catch (Exception) { Snackbar.Add($"No pudimos cargar la trazabilidad de {refNum}.", Severity.Error); }
    }

    private async Task ExportarExcel()
    {
        if (_exportando) return;
        _exportando = true;
        try
        {
            // Todas las actividades del filtro (antes el pedido de 5000 caía en silencio a 10 filas).
            var bytes = await Api.ActividadesExcelBytesAsync(_filtro);
            await Descargas.DescargarExcelAsync($"Diario_TI_{DateTime.Now:yyyyMMdd_HHmm}.xlsx", bytes);
            Snackbar.Add($"Excel generado con {_totalTabla ?? 0} actividades", Severity.Success);
        }
        catch (ApiException ex) { Snackbar.Add(ex.MensajeUsuario, Severity.Error); }
        catch (Exception) { Snackbar.Add("No pudimos generar el Excel. Intenta de nuevo.", Severity.Error); }
        finally { _exportando = false; }
    }

    public void Dispose() => _debounce?.Dispose();
}

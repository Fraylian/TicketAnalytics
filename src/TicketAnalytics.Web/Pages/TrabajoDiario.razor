    protected override async Task OnInitializedAsync()
    {
        var todos = await Api.TecnicosAsync();
        var grupo = await Api.GrupoAnalistasAsync();
        // Limitar a los analistas del grupo; si el filtro deja vacío, usar todos (fallback seguro)
        var filtrados = todos.Where(t => grupo.Any(g =>
            g.Equals(t.Nombre, StringComparison.OrdinalIgnoreCase)
            || g.Contains(t.Nombre, StringComparison.OrdinalIgnoreCase)
            || t.Nombre.Contains(g, StringComparison.OrdinalIgnoreCase))).ToList();
        _tecnicos = filtrados.Any() ? filtrados : todos.ToList();

        // Si no hay técnicos en absoluto, intentar sincronizar desde mdb
        if (!_tecnicos.Any())
        {
            try { await Api.SincronizarTecnicosAsync(); _tecnicos = (await Api.TecnicosAsync()).ToList(); } catch { }
        }
        await CargarResumen();
    }

    private bool _debeRenderizar = true;
    protected override bool ShouldRender()
    {
        if (_debeRenderizar) { _debeRenderizar = false; return true; }
        return false;
    }
    private void Render() { _debeRenderizar = true; StateHasChanged(); }

    private async Task RecargarTodo()
    {
        await CargarResumen();
        if (_tabla is not null) await _tabla.ReloadServerData();
    }

    private async Task CargarResumen()
    {
        try { _resumen = await Api.ResumenJornadaAsync(_filtro); _ultimaCarga = DateTime.Now; Render(); }
        catch (Exception ex) { Snackbar.Add($"No se pudo cargar el resumen: {ex.Message}", Severity.Error); }
    }

    private async Task AplicarRango(string label, int dias)
    {
        _rangoActivo = _rangoActivo == label ? "" : label;
        if (_rangoActivo == "")
        {
            _filtro.FechaDesde = null; _filtro.FechaHasta = null;
        }
        else
        {
            var hoy = DateOnly.FromDateTime(DateTime.Today);
            if (dias == 0) { _filtro.FechaDesde = hoy; _filtro.FechaHasta = hoy; }
            else if (dias == -1) { _filtro.FechaDesde = new DateOnly(hoy.Year, hoy.Month, 1); _filtro.FechaHasta = hoy; }
            else if (dias == -2)
            {
                var primerMesAnt = new DateOnly(hoy.Year, hoy.Month, 1).AddMonths(-1);
                _filtro.FechaDesde = primerMesAnt; _filtro.FechaHasta = new DateOnly(hoy.Year, hoy.Month, 1).AddDays(-1);
            }
            else { _filtro.FechaDesde = hoy.AddDays(-dias); _filtro.FechaHasta = hoy; }
        }
        await RecargarTodo();
    }

    private async Task ToggleSoloPendientes()
    {
        _soloPendientes = !_soloPendientes;
        if (_soloPendientes) { _soloBloqueadas = false; _filtro.Estado = 0; }
        else if (_filtro.Estado == 0) _filtro.Estado = null;
        await RecargarTodo();
    }

    private async Task ToggleSoloBloqueadas()
    {
        _soloBloqueadas = !_soloBloqueadas;
        if (_soloBloqueadas) { _soloPendientes = false; _filtro.Estado = 3; }
        else if (_filtro.Estado == 3) _filtro.Estado = null;
        await RecargarTodo();
    }

    private async Task FiltrarPorTecnico(string tecnico)
    {
        if (_tecnicoSel == tecnico)
        {
            _tecnicoSel = null; _filtro.TecnicoId = null;
        }
        else
        {
            _tecnicoSel = tecnico;
            var t = _tecnicos.FirstOrDefault(x => x.Nombre == tecnico);
            _filtro.TecnicoId = t?.TecnicoId;
        }
        await RecargarTodo();
    }

    private async Task<TableData<ActividadDto>> CargarTabla(TableState state, CancellationToken ct)
    {
        _filtro.Page = state.Page + 1;
        _filtro.PageSize = state.PageSize;
        try
        {
            var r = await Api.BuscarActividadesAsync(_filtro);
            return new TableData<ActividadDto> { Items = r.Items, TotalItems = r.TotalCount };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar: {ex.Message}", Severity.Error);
            return new TableData<ActividadDto> { Items = new List<ActividadDto>(), TotalItems = 0 };
        }
    }

    private async Task Recargar()
    {
        await CargarResumen();
        if (_tabla is not null) await _tabla.ReloadServerData();
    }

    private double PorcentajeHoras(decimal horas)
    {
        var max = _resumen.PorTecnico.Any() ? _resumen.PorTecnico.Max(t => t.Horas) : 0;
        return max > 0 ? (double)(horas / max * 100) : 0;
    }

    private static string Acortar(string n)
    {
        var p = n.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length >= 1 ? p[0] : n;
    }

    private static Color EstadoColor(int estado) => estado switch
    {
        0 => Color.Warning,   // Pendiente
        1 => Color.Info,      // En proceso
        2 => Color.Success,   // Completado
        3 => Color.Error,     // Bloqueado
        _ => Color.Default    // Cancelado
    };

    private void Editar(ActividadDto a)
    {
        _form = new GuardarActividadRequest
        {
            ActividadId = a.ActividadId, TecnicoId = a.TecnicoId, Actividad = a.Actividad, Tipo = a.Tipo,
            NoSolicitud = a.NoSolicitud, RefNumVinculado = a.RefNumVinculado, TipoVinculo = a.TipoVinculo,
            Proyecto = a.Proyecto, Horas = a.Horas, Estado = a.Estado, Comentario = a.Comentario, Usuario = _form.Usuario
        };
        _fecha = a.Fecha.ToDateTime(TimeOnly.MinValue);
        _ticketSel = string.IsNullOrEmpty(a.RefNumVinculado) ? null
            : new OpcionTicketDto { RefNum = a.RefNumVinculado, TipoVinculo = a.TipoVinculo ?? "cr" };
        _formVisible = true;
        Render();
    }

    private async Task Eliminar(ActividadDto a)
    {
        var ok = await DialogService.ShowMessageBox("Eliminar actividad",
            $"¿Eliminar la actividad de {a.TecnicoNombre} del {a.Fecha:dd/MM/yyyy}?",
            yesText: "Eliminar", cancelText: "Cancelar");
        if (ok == true)
        {
            try { await Api.EliminarActividadAsync(a.ActividadId); Snackbar.Add("Eliminada", Severity.Success); await RecargarTodo(); }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    private async Task VerComentario(ActividadDto a)
        => await DialogService.ShowMessageBox($"Comentario · {a.TecnicoNombre}", a.Comentario ?? "");

    private async Task VerDesglose(string refNum)
    {
        var acts = await Api.ActividadesDeTicketAsync(refNum);
        var horas = acts.Sum(x => x.Horas);
        var porTecnico = acts.Where(a => !string.IsNullOrEmpty(a.TecnicoNombre))
            .GroupBy(a => a.TecnicoNombre!)
            .Select(g => $"{g.Key}: {g.Sum(x => x.Horas):0.##}h")
            .ToList();

        var p = new DialogParameters
        {
            ["RefNum"] = refNum,
            ["ResumenHoras"] = $"{acts.Count} actividades · {horas:0.##} horas en total",
            ["DetalleTecnicos"] = porTecnico
        };
        await DialogService.ShowAsync<TimelineDialog>($"Trazabilidad · {refNum}", p,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
    }

    private async Task ExportarExcel()
    {
        try
        {
            var todo = new ActividadFiltro
            {
                FechaDesde = _filtro.FechaDesde, FechaHasta = _filtro.FechaHasta, TecnicoId = _filtro.TecnicoId,
                Tipo = _filtro.Tipo, Estado = _filtro.Estado, Texto = _filtro.Texto, Page = 1, PageSize = 5000
            };
            var data = await Api.BuscarActividadesAsync(todo);
            await CsvExport.DescargarActividadesAsync(data.Items);
            Snackbar.Add($"Exportadas {data.Items.Count} actividades", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"No se pudo exportar: {ex.Message}", Severity.Error); }
    }

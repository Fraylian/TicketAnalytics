@page "/ordenes-cambio"
@inject TicketAnalyticsApi Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject UiService Ui
@inject NavigationManager Nav
@inject FileDownloadService Descargas
@implements IDisposable

<PageTitle>Órdenes de cambio · TicketAnalytics</PageTitle>

<PageHeader Titulo="Órdenes de cambio" Icono="@Icons.Material.Filled.ChangeCircle"
            Bajada="Seguimiento, vencimientos y control por analista"
            UltimaActualizacion="_ultimaActualizacion" Actualizando="_cargando" OnRefrescar="RecargarTodo">
    <Acciones>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@(_exportando ? null : Icons.Material.Filled.TableView)"
                   OnClick="ExportarOc" Disabled="_exportando">
            @if (_exportando)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Generando…</span>
            }
            else { <span>Exportar a Excel</span> }
        </MudButton>
    </Acciones>
</PageHeader>

@* ===== Barra de filtros (mismo diseño que el resto de pantallas) ===== *@
<div class="ta-filtros">
    <div class="ta-pills fila-pills">
        <span class="lbl">Vencimiento:</span>
        <button type="button" class="@($"ta-pill {(_filtrarPorMes && _mes == DateTime.Today.Month && _anio == DateTime.Today.Year ? "activa" : "")}")"
                @onclick="@(() => AtajoMes(DateTime.Today))">Este mes</button>
        <button type="button" class="@($"ta-pill {(_filtrarPorMes && _mes == DateTime.Today.AddMonths(1).Month && _anio == DateTime.Today.AddMonths(1).Year ? "activa" : "")}")"
                @onclick="@(() => AtajoMes(DateTime.Today.AddMonths(1)))">Próximo mes</button>
        <button type="button" class="@($"ta-pill {(!_filtrarPorMes ? "activa" : "")}")" @onclick="TodoElAnio">Todo @_anio</button>
        <span class="lbl ml-3">Estado:</span>
        <button type="button" class="@($"ta-pill {(_filtro.SoloAbiertas == true ? "activa" : "")}")" style="--pill:#ED6C02"
                @onclick="ToggleAbiertas">Solo abiertas</button>
    </div>
    <MudGrid Spacing="2">
        <MudItem xs="6" md="2">
            <MudSelect T="int" Value="_mes" ValueChanged="OnMesChanged" Label="Mes de vencimiento" Variant="Variant.Outlined" Margin="Margin.Dense">
                @for (int m = 1; m <= 12; m++)
                {
                    var mm = m;
                    <MudSelectItem T="int" Value="@mm">@Formato.NombreMes(mm)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" md="2">
            <MudSelect T="int" Value="_anio" ValueChanged="OnAnioChanged" Label="Año" Variant="Variant.Outlined" Margin="Margin.Dense">
                @for (int a = DateTime.Today.Year - 1; a <= DateTime.Today.Year + 1; a++)
                {
                    var aa = a;
                    <MudSelectItem T="int" Value="@aa">@aa</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="string" Value="_analista" ValueChanged="OnAnalistaChanged" Label="Analista" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense" AdornmentIcon="@Icons.Material.Filled.Person">
                @foreach (var a in _analistas)
                {
                    <MudSelectItem T="string" Value="@a">@a</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect T="string" Value="_filtro.ComplejidadOC" ValueChanged="OnComplejidadChanged" Label="Complejidad" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="string" Value="@("Alta")">Alta (90 días)</MudSelectItem>
                <MudSelectItem T="string" Value="@("Media")">Media (60 días)</MudSelectItem>
                <MudSelectItem T="string" Value="@("Baja")">Baja (30 días)</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudTextField T="string" Value="_filtro.Texto" ValueChanged="OnTextoChanged" Immediate="true" Clearable="true"
                          Label="Buscar OC o resumen" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>
    </MudGrid>
    <ActiveFilterChips Filtros="FiltrosActivos" OnQuitar="QuitarFiltro" OnLimpiarTodo="LimpiarFiltros" />
</div>

@if (_error is not null)
{
    <ErrorState Mensaje="No se pudieron cargar las órdenes de cambio." Detalle="@_error" OnReintentar="RecargarTodo" />
}
else
{
<MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-4" @bind-ActivePanelIndex="_tab">

    <MudTabPanel Text="Dashboard" Icon="@Icons.Material.Filled.Dashboard">
        @if (_cargando && !_cargadoAlgunaVez)
        {
            <MudGrid Spacing="3">
                @for (var i = 0; i < 6; i++) { <MudItem xs="6" md="2"><KpiCard Cargando="true" /></MudItem> }
                <MudItem xs="12" md="8"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="320px" Animation="Animation.Wave" /></MudItem>
                <MudItem xs="12" md="4"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="320px" Animation="Animation.Wave" /></MudItem>
            </MudGrid>
        }
        else
        {
            <div class="@(_cargando ? "ta-actualizando" : "")" @key="@($"d{_version}")">@DashboardContent</div>
        }
    </MudTabPanel>

    <MudTabPanel Text="Control de vencimientos" Icon="@Icons.Material.Filled.Warning">
        @if (_cargando && !_cargadoAlgunaVez) { <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="400px" Animation="Animation.Wave" /> }
        else { <div class="@(_cargando ? "ta-actualizando" : "")" @key="@($"v{_version}")">@VencimientosContent</div> }
    </MudTabPanel>

    <MudTabPanel Text="Listado" Icon="@Icons.Material.Filled.TableRows">
        @ListadoContent
    </MudTabPanel>

    <MudTabPanel Text="Por técnico" Icon="@Icons.Material.Filled.Groups">
        @if (_cargando && !_cargadoAlgunaVez)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" Class="mb-2" Animation="Animation.Wave" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" Animation="Animation.Wave" />
        }
        else
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.Info">
                Esta vista cuenta solo las OC asignadas a los analistas del grupo (@_tablero.Total).
                El Dashboard incluye además las que todavía no tienen analista (@_dash.SinAnalista sin asignar).
            </MudAlert>
            <MudGrid Spacing="3" Class="mb-4 ta-stagger">
                <MudItem xs="6" md="3"><KpiCard Titulo="Vencidas" Valor="@_tablero.Vencidas.ToString()" Icono="@Icons.Material.Filled.Error" Acento="vencido" Nota="abiertas, pasó el SLA" /></MudItem>
                <MudItem xs="6" md="3"><KpiCard Titulo="Vencen este mes" Valor="@_tablero.VencenEsteMes.ToString()" Icono="@Icons.Material.Filled.Event" Acento="riesgo" Nota="@($"{Formato.NombreMes(_mes)} {_anio}")" /></MudItem>
                <MudItem xs="6" md="3"><KpiCard Titulo="Por vencer (7d)" Valor="@_tablero.VencenPronto.ToString()" Icono="@Icons.Material.Filled.HourglassBottom" Acento="riesgo" /></MudItem>
                <MudItem xs="6" md="3"><KpiCard Titulo="OC del grupo" Valor="@_tablero.Total.ToString()" Icono="@Icons.Material.Filled.ChangeCircle" Acento="azul" Nota="@($"{_tablero.Completadas} cerradas · {_tablero.EnCurso} en curso")" /></MudItem>
            </MudGrid>

            <div class="panel">
                <div class="panel-cab">
                    <div>
                        <h2 class="panel-titulo"><MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" Color="Color.Primary" /> Carga por técnico</h2>
                        <div class="panel-sub">Clic en un técnico para abrir su listado de órdenes</div>
                    </div>
                </div>
                @if (!_tablero.PorTecnico.Any())
                {
                    <EmptyState Icono="@Icons.Material.Filled.Inbox" Mensaje="No hay órdenes de cambio en el período." />
                }
                else
                {
                    var maxTotal = Math.Max(1, _tablero.PorTecnico.Max(x => x.Total));
                    <div class="ta-stagger">
                    @foreach (var t in _tablero.PorTecnico)
                    {
                        <div>
                            <MudPaper Class="@($"pa-3 mb-2 ta-clickable ta-hover-card {(_tecnicoSel == t.Tecnico ? "ta-tecnico-activo" : "")}")"
                                      Elevation="0" Style="border:1px solid var(--bsc-borde);border-radius:12px"
                                      @onclick="@(() => SeleccionarTecnico(t.Tecnico))">
                                <div class="d-flex justify-space-between align-center flex-wrap gap-2">
                                    <div class="d-flex align-center gap-3" style="min-width:220px">
                                        <span class="ta-avatar" style="@($"background:{Formato.ColorAvatar(t.Tecnico)}")">@Formato.Iniciales(t.Tecnico)</span>
                                        <div>
                                            <MudText Typo="Typo.subtitle2"><b>@t.Tecnico</b></MudText>
                                            <MudText Typo="Typo.caption" Class="ta-muted">@t.Total OC · @t.Abiertas abiertas</MudText>
                                        </div>
                                    </div>
                                    <div class="d-flex gap-1 flex-wrap align-center">
                                        @if (t.Vencidas > 0) { <span class="ta-tag err">@t.Vencidas vencidas</span> }
                                        @if (t.VencenEsteMes > 0) { <span class="ta-tag warn">@t.VencenEsteMes vencen en @Formato.NombreMes(_mes).ToLowerInvariant()</span> }
                                        @if (t.VencenPronto > 0) { <span class="ta-tag warn">@t.VencenPronto por vencer</span> }
                                        @if (t.EnCurso > 0) { <span class="ta-tag info">@t.EnCurso en curso</span> }
                                        @if (t.Completadas > 0) { <span class="ta-tag ok">@t.Completadas cerradas</span> }
                                        <MudIcon Icon="@(_tecnicoSel == t.Tecnico ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Class="ta-tenue" />
                                    </div>
                                </div>
                                <div class="ta-apilada mt-2">
                                    <div class="barra" style="height:8px" title="@($"{t.Vencidas} vencidas · {t.VencenPronto} por vencer · {t.EnCurso} en curso · {t.Completadas} cerradas")">
                                        @foreach (var (n, color) in new[] { (t.Vencidas, "var(--op-vencido)"), (t.VencenPronto, "var(--op-riesgo)"), (t.EnCurso, "var(--op-curso)"), (t.Completadas, "var(--op-cumplido)") })
                                        {
                                            if (n > 0)
                                            {
                                                <span class="seg" style="@($"--w:{(n * 100.0 / maxTotal).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%;background:{color}")"></span>
                                            }
                                        }
                                    </div>
                                </div>
                            </MudPaper>

                            @if (_tecnicoSel == t.Tecnico)
                            {
                                <PanelTecnico Tecnico="@t.Tecnico" EsOrdenCambio="true" VistaInicial="mes" Mes="_mes" Anio="_anio"
                                              OnCerrar="@(() => _tecnicoSel = null)" />
                            }
                        </div>
                    }
                    </div>
                }
            </div>
        }
    </MudTabPanel>

    @* Al final para no mover los índices de las pestañas existentes (?vista=... usa 0..3). *@
    <MudTabPanel Text="Atención por persona" Icon="@Icons.Material.Filled.PriorityHigh">
        <AtencionPorPersona Anio="_anio" Mes="_mes" />
    </MudTabPanel>
</MudTabs>
}

@code {
    private int _tab;
    private string? _tecnicoSel;
    private bool _cargando = true;
    private bool _cargadoAlgunaVez;
    private bool _exportando;
    private string? _error;
    private DateTime? _ultimaActualizacion;
    private int _version;
    private Timer? _debounce;

    private OrdenCambioFiltro _filtro = new() { AnioVencimiento = DateTime.Today.Year };
    private int _mes = DateTime.Today.Month;
    private int _anio = DateTime.Today.Year;
    private string? _analista;
    private bool _filtrarPorMes;
    /// <summary>Filtro rápido activo (KPI, semáforo o gráfico). Solo uno a la vez.</summary>
    private string? _rapido;

    private OrdenCambioDashboardDto _dash = new();
    private ControlVencimientosDto _venc = new();
    private TableroOcDto _tablero = new();
    private List<string> _analistas = new();

    private void SeleccionarTecnico(string tecnico) => _tecnicoSel = _tecnicoSel == tecnico ? null : tecnico;

    protected override async Task OnInitializedAsync()
    {
        try { _analistas = await Api.GrupoAnalistasAsync(); } catch { _analistas = new(); }

        // Drill-down desde el Dashboard: /ordenes-cambio?vista=vencidas|semana|sinanalista|listado
        var q = UrlQuery.Leer(Nav);
        if (q.TryGetValue("vista", out var v))
        {
            switch (v)
            {
                case "vencidas": AplicarRapido("vencidas"); _tab = 2; break;
                case "semana": AplicarRapido("vence7"); _tab = 2; break;
                case "sinanalista": AplicarRapido("sinanalista"); _tab = 2; break;
                case "listado": _tab = 2; break;
                case "vencimientos": _tab = 1; break;
                case "atencion": _tab = 4; break;
            }
        }
        if (q.TryGetValue("analista", out var a)) { _analista = a; _filtro.AsignatarioNombre = a; }
        if (q.TryGetValue("texto", out var tx) && !string.IsNullOrWhiteSpace(tx)) _filtro.Texto = tx;
        await RecargarTodo();
    }

    // ===== Filtros =====
    private async Task OnMesChanged(int m) { _mes = m; _filtrarPorMes = true; AplicarMes(); await RecargarTodo(); }
    private async Task OnAnioChanged(int a) { _anio = a; _filtro.AnioVencimiento = a; if (_filtrarPorMes) AplicarMes(); await RecargarTodo(); }
    private async Task OnAnalistaChanged(string? a) { _analista = a; _filtro.AsignatarioNombre = a; await RecargarTodo(); }
    private async Task OnComplejidadChanged(string? c) { _filtro.ComplejidadOC = c; await RecargarTodo(); }
    private async Task ToggleAbiertas() { _filtro.SoloAbiertas = _filtro.SoloAbiertas == true ? null : true; await RecargarTodo(); }

    private void OnTextoChanged(string? t)
    {
        _filtro.Texto = t;
        _debounce?.Dispose();
        _debounce = new Timer(_ => InvokeAsync(RecargarTodo), null, 400, Timeout.Infinite);
    }

    private async Task AtajoMes(DateTime fecha)
    {
        _mes = fecha.Month; _anio = fecha.Year; _filtrarPorMes = true;
        AplicarMes();
        await RecargarTodo();
    }

    private async Task TodoElAnio()
    {
        _filtrarPorMes = false;
        _filtro.MesVencimiento = null;
        _filtro.AnioVencimiento = _anio;
        await RecargarTodo();
    }

    private void AplicarMes()
    {
        _filtro.MesVencimiento = _mes;
        _filtro.AnioVencimiento = _anio;
    }

    /// <summary>Aplica (o quita, si ya estaba) un filtro rápido. Los rápidos son excluyentes entre sí.</summary>
    private void AplicarRapido(string? clave)
    {
        _filtro.Vencidas = null; _filtro.VencenHoy = null; _filtro.VencenEnDias = null; _filtro.SinAnalista = null;
        _filtro.SinFechaVencimiento = null; _filtro.VencenProximoMes = null; _filtro.VencenEsteMes = null;
        _filtro.Estados = null; _filtro.ConTicketCerradoOcPendiente = null;
        _rapido = _rapido == clave ? null : clave;
        switch (_rapido)
        {
            case "vencidas": _filtro.Vencidas = true; break;
            case "hoy": _filtro.VencenHoy = true; break;
            case "vence7": _filtro.VencenEnDias = 7; break;
            case "vence15": _filtro.VencenEnDias = 15; break;
            case "vence30": _filtro.VencenEnDias = 30; break;
            case "estemes": _filtro.VencenEsteMes = true; break;
            case "proxmes": _filtro.VencenProximoMes = true; break;
            case "sinfecha": _filtro.SinFechaVencimiento = true; break;
            case "sinanalista": _filtro.SinAnalista = true; break;
            case "ocpendiente": _filtro.ConTicketCerradoOcPendiente = true; break;
        }
    }

    private async Task FiltroRapido(string clave, bool irAlListado = true)
    {
        AplicarRapido(clave);
        if (irAlListado && _rapido is not null) _tab = 2;
        await RecargarTodo();
    }

    private async Task FiltrarEstado(string? estado)
    {
        if (string.IsNullOrWhiteSpace(estado)) return;
        AplicarRapido(null);
        _filtro.Estados = new() { estado };
        _rapido = $"estado:{estado}";
        _tab = 2;
        await RecargarTodo();
    }

    private async Task FiltrarAnalista(string? etiqueta, bool soloVencidas = false)
    {
        // Las barras muestran el nombre corto: buscamos el nombre completo del grupo.
        var nombre = _dash.PorAnalista.Concat(_dash.VencidasPorAnalista).Select(x => x.Etiqueta)
                         .FirstOrDefault(n => Formato.NombreCorto(n) == etiqueta || n == etiqueta) ?? etiqueta;
        if (string.IsNullOrWhiteSpace(nombre) || nombre == "Sin asignar") { await FiltroRapido("sinanalista"); return; }
        _analista = nombre;
        _filtro.AsignatarioNombre = nombre;
        if (soloVencidas) AplicarRapido("vencidas");
        _tab = 2;
        await RecargarTodo();
    }

    private List<ActiveFilterChips.FiltroActivo> FiltrosActivos
    {
        get
        {
            var l = new List<ActiveFilterChips.FiltroActivo>();
            if (_filtrarPorMes) l.Add(new("mes", $"Vencen en {Formato.NombreMes(_mes).ToLowerInvariant()} {_anio}"));
            if (!string.IsNullOrEmpty(_analista)) l.Add(new("analista", $"Analista: {_analista}"));
            if (!string.IsNullOrEmpty(_filtro.ComplejidadOC)) l.Add(new("complejidad", $"Complejidad {_filtro.ComplejidadOC}"));
            if (_filtro.SoloAbiertas == true) l.Add(new("abiertas", "Solo abiertas"));
            if (!string.IsNullOrWhiteSpace(_filtro.Texto)) l.Add(new("texto", $"\"{_filtro.Texto}\""));
            if (_rapido is not null) l.Add(new("rapido", TextoRapido(_rapido)));
            return l;
        }
    }

    private static string TextoRapido(string r) => r switch
    {
        "vencidas" => "Vencidas",
        "hoy" => "Vencen hoy",
        "vence7" => "Vencen en 7 días",
        "vence15" => "Vencen en 15 días",
        "vence30" => "Vencen en 30 días",
        "estemes" => "Vencen este mes",
        "proxmes" => "Vencen el próximo mes",
        "sinfecha" => "Sin fecha de vencimiento",
        "sinanalista" => "Sin analista",
        "ocpendiente" => "Ticket cerrado con OC pendiente",
        _ when r.StartsWith("estado:") => $"Estado: {r[7..]}",
        _ => r
    };

    private async Task QuitarFiltro(ActiveFilterChips.FiltroActivo f)
    {
        switch (f.Clave)
        {
            case "mes": _filtrarPorMes = false; _filtro.MesVencimiento = null; break;
            case "analista": _analista = null; _filtro.AsignatarioNombre = null; break;
            case "complejidad": _filtro.ComplejidadOC = null; break;
            case "abiertas": _filtro.SoloAbiertas = null; break;
            case "texto": _filtro.Texto = null; break;
            case "rapido": AplicarRapido(_rapido); break;
        }
        await RecargarTodo();
    }

    private async Task LimpiarFiltros()
    {
        _filtro = new OrdenCambioFiltro { AnioVencimiento = DateTime.Today.Year };
        _analista = null; _filtrarPorMes = false; _rapido = null;
        _mes = DateTime.Today.Month; _anio = DateTime.Today.Year;
        await RecargarTodo();
    }

    private async Task RecargarTodo()
    {
        _cargando = true; _error = null;
        StateHasChanged();
        try
        {
            var tDash = Api.OcDashboardAsync(_filtro);
            var tVenc = Api.OcControlVencimientosAsync(_filtro);
            var tTablero = Api.TableroOrdenesCambioAsync(FiltroTablero());
            await Task.WhenAll(tDash, tVenc, tTablero);
            _dash = tDash.Result;
            _venc = tVenc.Result;
            _tablero = tTablero.Result;
            _ultimaActualizacion = DateTime.Now;
            _cargadoAlgunaVez = true;
            _version++;
        }
        catch (ApiException ex) { _error = ex.MensajeUsuario; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _cargando = false; StateHasChanged(); }
        await RecargarListado();
    }

    // Filtro del tablero por técnico (fuente chg directa + SLA real). FechaDesde marca el MES de
    // referencia para "vencen este mes"; el backend amplía la ventana 100 días hacia atrás.
    private TicketFiltro FiltroTablero() => new()
    {
        FechaDesde = new DateTime(_anio, _mes, 1),
        FechaHasta = null,
        AsignatarioNombre = _filtro.AsignatarioNombre,
        ComplejidadOC = _filtro.ComplejidadOC
        // Sin PageSize: el tablero se agrupa en el servidor y no devuelve filas.
    };

    // ===== Opciones de gráficos =====
    private readonly ApexChartOptions<ConteoOc> _optAnalista = ChartTheme.Barras<ConteoOc>(new() { ChartTheme.Azul }, horizontal: true, etiquetas: true);
    private readonly ApexChartOptions<ConteoOc> _optVencidasAnalista = ChartTheme.Barras<ConteoOc>(new() { ChartTheme.Rojo }, horizontal: true, etiquetas: true);
    private readonly ApexChartOptions<ConteoOc> _optVencAnalista = ChartTheme.Barras<ConteoOc>(new() { ChartTheme.Ambar }, horizontal: true, etiquetas: true);
    private readonly ApexChartOptions<ConteoOc> _optDona = ChartTheme.Dona<ConteoOc>(null, "OC");
    private readonly ApexChartOptions<ConteoOc> _optDonaCat = ChartTheme.Dona<ConteoOc>(null, "OC");
    private readonly ApexChartOptions<AntiguedadOc> _optAntiguedad =
        ChartTheme.Barras<AntiguedadOc>(new() { "#2E7D32", "#76B82A", "#F9A825", "#ED6C02", "#C62828", "#7B1FA2" }, distribuidas: true, etiquetas: true);
    private readonly ApexChartOptions<TendenciaMesOc> _optTendencia = ChartTheme.Area<TendenciaMesOc>(new() { ChartTheme.Azul, ChartTheme.Verde });
    private readonly ApexChartOptions<VencimientoSemanaOc> _optSemana = ChartTheme.Barras<VencimientoSemanaOc>(new() { ChartTheme.Ambar }, etiquetas: true);
    private readonly ApexChartOptions<VencimientoSemanaOc> _optSemana2 = ChartTheme.Barras<VencimientoSemanaOc>(new() { ChartTheme.Ambar }, etiquetas: true);


            <MudTable ServerData="CargarListado" @ref="_tabla" Dense="true" Hover="true" Elevation="0" Class="ta-tabla-click"
                      Breakpoint="Breakpoint.Md" T="OrdenCambioConTicketsDto" RowClassFunc="@FilaClass"

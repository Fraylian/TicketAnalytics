                    <ApexChart TItem="ConteoOc" Options="_optDonaCat" Height="300">
                        <ApexPointSeries TItem="ConteoOc" Items="_venc.PorCategoria" Name="Cat" XValue="@(x => Formato.CategoriaCorta(x.Etiqueta))" YAggregate="@(g => g.Sum(x => x.Cantidad))" SeriesType="SeriesType.Donut" />

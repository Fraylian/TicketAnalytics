    private MudTable<OrdenCambioConTicketsDto>? _tabla;
    private int? _totalListado;

    private async Task<TableData<OrdenCambioConTicketsDto>> CargarListado(TableState state, CancellationToken ct)
    {
        _filtro.Page = state.Page + 1;
        _filtro.PageSize = state.PageSize;
        try
        {
            var r = await Api.BuscarOcAvanzadoAsync(_filtro);
            _totalListado = r.TotalCount;
            _ = InvokeAsync(StateHasChanged);
            return new TableData<OrdenCambioConTicketsDto> { Items = r.Items, TotalItems = r.TotalCount };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar: {(ex is ApiException a ? a.MensajeUsuario : ex.Message)}", Severity.Error);
            return new TableData<OrdenCambioConTicketsDto> { Items = new List<OrdenCambioConTicketsDto>(), TotalItems = 0 };
        }
    }

    private async Task RecargarListado() { if (_tabla is not null) await _tabla.ReloadServerData(); }

    private string FilaClass(OrdenCambioConTicketsDto o, int _) => o.EstadoVencimiento == "vencida" ? "fila-critica" : "";

    private async Task AbrirGestion(string refOC)
    {
        var p = new DialogParameters { ["RefNum"] = refOC, ["EsOrdenCambio"] = true };
        var d = await DialogService.ShowAsync<ReporteGestionDialog>($"Gestión · {refOC}", p,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        var res = await d.Result;
        if (res is { Canceled: false }) await RecargarTodo();
    }

    private async Task VerDetalle(OrdenCambioConTicketsDto oc)
    {
        var p = new DialogParameters { ["Orden"] = oc };
        await DialogService.ShowAsync<OrdenCambioDetalleDialog>($"OC {oc.NoOC}", p,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
    }

    private async Task VerTimeline(string refOC)
        => await DialogService.ShowAsync<TimelineDialog>($"Timeline · {refOC}", new DialogParameters { ["RefNum"] = refOC },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });

    private async Task Copiar(string texto)
    {
        if (await Ui.CopiarAsync(texto)) Snackbar.Add($"Copiado: {texto}", Severity.Info);
        else Snackbar.Add("No se pudo copiar al portapapeles.", Severity.Warning);
    }

    private async Task ExportarOc()
    {
        if (_exportando) return;
        _exportando = true;
        try
        {
            // Exporta TODAS las OC que cumplen los filtros actuales (antes salían solo 25).
            var bytes = await Api.OcExcelBytesAsync(_filtro);
            await Descargas.DescargarExcelAsync($"Ordenes_Cambio_{DateTime.Now:yyyyMMdd_HHmm}.xlsx", bytes);
            Snackbar.Add($"Excel generado con {_totalListado ?? 0} órdenes", Severity.Success);
        }
        catch (ApiException ex) { Snackbar.Add(ex.MensajeUsuario, Severity.Error); }
        catch (Exception) { Snackbar.Add("No pudimos generar el Excel. Intenta de nuevo.", Severity.Error); }
        finally { _exportando = false; }
    }

    private static string TiempoClass(double pct) => pct >= 100 ? "tiempo-vencido" : pct >= 80 ? "tiempo-riesgo" : "tiempo-ok";

    public void Dispose() => _debounce?.Dispose();
}

@page "/seguimiento"
@inject TicketAnalyticsApi Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject UiService Ui
@implements IDisposable

<PageTitle>Seguimiento · TicketAnalytics</PageTitle>

<PageHeader Titulo="Seguimiento operativo" Icono="@Icons.Material.Filled.Assignment"
            Bajada="Etapas de trabajo, timeline auditable y continuidad bajo orden de cambio"
            UltimaActualizacion="_ultimaCarga" Actualizando="_cargando" OnRefrescar="Cargar">
    <Acciones>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AbrirCrear">Nuevo seguimiento</MudButton>
    </Acciones>
</PageHeader>

<div class="ta-pills mb-3">
    <span class="lbl">Bandeja:</span>
    <button type="button" class="@($"ta-pill {(!_verFinalizadas ? "activa" : "")}")" @onclick="@(() => CambiarBandeja(false))">
        <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Style="font-size:16px" /> Gestiones activas
        @if (!_verFinalizadas) { <span class="cnt">@_resumen.Total</span> }
    </button>
    <button type="button" class="@($"ta-pill {(_verFinalizadas ? "activa" : "")}")" style="--pill:#2E7D32" @onclick="@(() => CambiarBandeja(true))">
        <MudIcon Icon="@Icons.Material.Filled.TaskAlt" Style="font-size:16px" /> Gestiones finalizadas
        @if (_verFinalizadas) { <span class="cnt">@_resumen.Total</span> }
    </button>
</div>

<!-- ===== Filtros (mismo diseño que el resto de pantallas) ===== -->
<div class="ta-filtros">
    <div class="ta-pills fila-pills">
        <span class="lbl">Rápidos:</span>
        <button type="button" class="@($"ta-pill {(_sinActualizacion ? "activa" : "")}")" style="--pill:#ED6C02" @onclick="@(() => Toggle("sinact"))">Sin actualizar 7d+</button>
        <button type="button" class="@($"ta-pill {(_conJira ? "activa" : "")}")" style="--pill:#1976D2" @onclick="@(() => Toggle("jira"))">Con JIRA</button>
        <button type="button" class="@($"ta-pill {(_enVP ? "activa" : "")}")" style="--pill:#6B4EFF" @onclick="@(() => Toggle("vp"))">En reporte VP</button>
        <button type="button" class="@($"ta-pill {(_proveedorPendiente ? "activa" : "")}")" style="--pill:#C75100" @onclick="@(() => Toggle("prov"))">Proveedor pendiente</button>
    </div>
    <MudGrid Spacing="2">
        <MudItem xs="12" md="4">
            <MudTextField T="string" Value="_busquedaRef" ValueChanged="OnBusquedaChanged" Immediate="true" Clearable="true"
                          Label="Buscar por No. de ticket u OC" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudSelect T="int?" Label="Etapa" Value="_etapaFiltro" ValueChanged="OnEtapaChanged" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var e in EtapasSeguimiento.Todas)
                {
                    <MudSelectItem T="int?" Value="@((int?)e.Id)">@e.Texto</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudSelect T="string" Label="Responsable" Value="_responsable" ValueChanged="OnResponsableChanged" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var g in _grupo)
                {
                    <MudSelectItem T="string" Value="@g">@g</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>
    <ActiveFilterChips Filtros="FiltrosActivos" OnQuitar="QuitarFiltro" OnLimpiarTodo="LimpiarFiltros" />
</div>

<MudGrid Spacing="3" Class="mb-2 ta-stagger">
    <MudItem xs="6" md="4" lg="2"><KpiCard Titulo="@(_verFinalizadas ? "Finalizadas" : "En seguimiento")" Valor="@_resumen.Total.ToString()" Icono="@Icons.Material.Filled.Assignment" Acento="azul" Nota="con los filtros actuales" Cargando="@(_cargando && !_cargadoAlgunaVez)" /></MudItem>
    <MudItem xs="6" md="4" lg="2"><KpiCard Titulo="Requieren atención" Valor="@_resumen.RequierenAtencion.ToString()" Icono="@Icons.Material.Filled.NotificationImportant" Acento="riesgo" Nota="pasó su próximo seguimiento" Cargando="@(_cargando && !_cargadoAlgunaVez)" /></MudItem>
    <MudItem xs="6" md="4" lg="2"><KpiCard Titulo="Sin actualizar 7d+" Valor="@_resumen.SinActualizar.ToString()" Icono="@Icons.Material.Filled.UpdateDisabled" Acento="vencido" Activo="_sinActualizacion" TextoAccion="Filtrar" OnClick="@(() => Toggle("sinact"))" Cargando="@(_cargando && !_cargadoAlgunaVez)" /></MudItem>
    <MudItem xs="6" md="4" lg="2"><KpiCard Titulo="Con JIRA" Valor="@_resumen.ConJira.ToString()" Icono="@Icons.Material.Filled.BugReport" Acento="azul" Activo="_conJira" TextoAccion="Filtrar" OnClick="@(() => Toggle("jira"))" Cargando="@(_cargando && !_cargadoAlgunaVez)" /></MudItem>
    <MudItem xs="6" md="4" lg="2"><KpiCard Titulo="Reportados a proveedor" Valor="@_resumen.ConProveedor.ToString()" Icono="@Icons.Material.Filled.Business" Acento="cumplido" Cargando="@(_cargando && !_cargadoAlgunaVez)" /></MudItem>
    <MudItem xs="6" md="4" lg="2"><KpiCard Titulo="En reporte VP" Valor="@_resumen.EnReporteVP.ToString()" Icono="@Icons.Material.Filled.Summarize" Acento="violeta" Activo="_enVP" TextoAccion="Filtrar" OnClick="@(() => Toggle("vp"))" Cargando="@(_cargando && !_cargadoAlgunaVez)" /></MudItem>
</MudGrid>

<div class="d-flex justify-space-between align-center flex-wrap gap-2 my-3" id="lista-seguimiento">
    <span class="ta-resumen-pag">
        @if (_total > 0)
        {
            <text>Mostrando <b>@Desde–@Hasta</b> de <b>@_total</b> casos</text>
        }
        else if (!_cargando)
        {
            <text>Sin casos para estos filtros</text>
        }
    </span>
    <div class="d-flex align-center gap-2">
        <MudText Typo="Typo.caption" Class="ta-muted">Por página</MudText>
        <MudSelect T="int" Value="_tamano" ValueChanged="OnTamanoChanged" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:90px">
            <MudSelectItem T="int" Value="12">12</MudSelectItem>
            <MudSelectItem T="int" Value="24">24</MudSelectItem>
            <MudSelectItem T="int" Value="48">48</MudSelectItem>
            <MudSelectItem T="int" Value="96">96</MudSelectItem>
        </MudSelect>
    </div>
</div>

@if (_cargando && !_cargadoAlgunaVez)
{
    <MudGrid Spacing="3">
        @for (var i = 0; i < 6; i++)
        {
            <MudItem xs="12" md="6" lg="4"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="230px" Animation="Animation.Wave" /></MudItem>
        }
    </MudGrid>
}
else if (!_seguimientos.Any())
{
    <div class="panel">
        <EmptyState Icono="@Icons.Material.Filled.Assignment"
                    Mensaje="@(_verFinalizadas ? "No hay gestiones finalizadas con estos filtros." : "No hay seguimientos con estos filtros.")"
                    Detalle="Crea uno con «Nuevo seguimiento» o ajusta los filtros."
                    TextoAccion="Nuevo seguimiento" OnAccion="AbrirCrear" />
    </div>
}
else
{
    <MudGrid Spacing="3" Class="@($"ta-stagger {(_cargando ? "ta-actualizando" : "")}")" @key="_version">
        @foreach (var s in _seguimientos)
        {
            <MudItem xs="12" md="6" lg="4">
                <MudCard Elevation="0" Class="@("oc-card ta-seg-card " + (RequiereAtencion(s) ? "pendiente" : ""))"
                         Style="height:100%;border:1px solid var(--bsc-borde);border-radius:12px;display:flex;flex-direction:column">
                    <MudCardContent Style="flex:1">
                        <div class="d-flex justify-space-between align-start mb-2 gap-2">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@(s.TipoOrigen == "chg" ? Icons.Material.Filled.ChangeCircle : Icons.Material.Filled.ConfirmationNumber)"
                                         Size="Size.Small" Color="@(s.TipoOrigen == "chg" ? Color.Secondary : Color.Primary)" />
                                <MudText Typo="Typo.h6" Style="font-weight:700">@s.RefNum</MudText>
                            </div>
                            <MudChip T="string" Size="Size.Small" Color="@EtapaColor(s.EtapaActual)">@s.EtapaActualTexto</MudChip>
                        </div>
                        <div class="d-flex align-center gap-2 mb-1">
                            @if (!string.IsNullOrWhiteSpace(s.TecnicoResponsable))
                            {
                                <span class="ta-avatar sm" style="@($"background:{Formato.ColorAvatar(s.TecnicoResponsable)}")">@Formato.Iniciales(s.TecnicoResponsable)</span>
                            }
                            <MudText Typo="Typo.caption" Class="ta-muted">
                                @(s.TipoCaso ?? (s.TipoOrigen == "chg" ? "Orden de cambio" : "Ticket"))@(string.IsNullOrWhiteSpace(s.TecnicoResponsable) ? "" : $" · {s.TecnicoResponsable}")
                            </MudText>
                        </div>
                        @if (s.ContinuaBajoOC && !string.IsNullOrEmpty(s.OrdenCambioRef) && s.OrdenCambioRef != s.RefNum)
                        {
                            <MudTooltip Text="El trabajo de este ticket continúa bajo esta orden de cambio">
                                <span class="ta-tag info mt-1"><MudIcon Icon="@Icons.Material.Filled.ArrowForward" Style="font-size:14px" /> Continúa en OC @s.OrdenCambioRef</span>
                            </MudTooltip>
                        }

                        @* Estado de un vistazo: proveedor, JIRA, VP y clasificación *@
                        <div class="ta-estado-gestion mt-2">
                            <span class="@($"ta-tag {(s.ReportadoProveedor == 1 ? "ok" : s.ReportadoProveedor == 2 ? "warn" : "")}")">
                                Proveedor: @(s.ReportadoProveedor switch { 1 => "sí", 0 => "no", _ => "pendiente" })
                            </span>
                            <span class="@($"ta-tag {(s.CantidadJiras > 0 ? "info" : "")}")">@(s.CantidadJiras > 0 ? $"JIRA ({s.CantidadJiras})" : "Sin JIRA")</span>
                            @if (s.VaReporteVP) { <span class="ta-tag vp">Reportado al VP</span> }
                            @if (!string.IsNullOrWhiteSpace(s.CausaRaiz)) { <span class="ta-tag ok">Causa raíz</span> }
                        </div>

                        @if (s.Sistema > 0 || s.TipoSolucion > 0)
                        {
                            <MudText Typo="Typo.caption" Class="mt-2 d-block ta-muted">
                                @(s.Sistema > 0 ? s.SistemaTexto : "")@(s.Sistema > 0 && s.TipoSolucion > 0 ? " · " : "")@(s.TipoSolucion > 0 ? s.TipoSolucionTexto : "")
                            </MudText>
                        }

                        @if (!string.IsNullOrEmpty(s.ProximosPasos))
                        {
                            <MudText Typo="Typo.body2" Class="mt-2"><b>Próximo:</b> @Formato.Corto(s.ProximosPasos, 140)</MudText>
                        }

                        <MudDivider Class="my-2" />
                        <div class="d-flex justify-space-between align-center flex-wrap gap-2">
                            <div class="d-flex gap-3 ta-muted" style="font-size:.82rem">
                                <MudTooltip Text="Actualizaciones"><span><MudIcon Icon="@Icons.Material.Filled.History" Style="font-size:16px;vertical-align:middle" /> @s.CantidadActualizaciones</span></MudTooltip>
                                <MudTooltip Text="JIRA"><span><MudIcon Icon="@Icons.Material.Filled.BugReport" Style="font-size:16px;vertical-align:middle" /> @s.CantidadJiras</span></MudTooltip>
                                <MudTooltip Text="Reportes a proveedor"><span><MudIcon Icon="@Icons.Material.Filled.Business" Style="font-size:16px;vertical-align:middle" /> @s.CantidadReportesProveedor</span></MudTooltip>
                                <MudTooltip Text="Evidencias"><span><MudIcon Icon="@Icons.Material.Filled.AttachFile" Style="font-size:16px;vertical-align:middle" /> @s.CantidadEvidencias</span></MudTooltip>
                            </div>
                            <MudTooltip Text="@($"Última actualización: {s.ActualizadoEn.ToLocalTime():dd/MM/yyyy HH:mm}")">
                                <span class="@(DiasSinActualizar(s) >= 7 ? "ta-tag warn" : "ta-tenue")" style="font-size:.75rem">@Formato.Hace(s.ActualizadoEn.ToLocalTime())</span>
                            </MudTooltip>
                        </div>
                    </MudCardContent>
                    <MudCardActions Class="d-flex flex-wrap gap-1 px-3 pb-3">
                        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Timeline" OnClick="@(() => AbrirDetalle(s.RefNum))">Timeline</MudButton>
                        <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.EditNote"
                                   OnClick="@(() => AbrirGestion(s))">Gestionar</MudButton>
                        <MudSpacer />
                        @if (_verFinalizadas)
                        {
                            <MudButton Size="Size.Small" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Replay" OnClick="@(() => Reabrir(s))">Reabrir</MudButton>
                        }
                        else
                        {
                            <MudButton Size="Size.Small" Color="Color.Success" StartIcon="@Icons.Material.Filled.TaskAlt" OnClick="@(() => Finalizar(s))">Finalizar</MudButton>
                        }
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>

    @if (TotalPaginas > 1)
    {
        <div class="d-flex justify-center mt-4">
            <MudPagination Count="TotalPaginas" Selected="_pagina" SelectedChanged="CambiarPagina" Color="Color.Primary"
                           ShowFirstButton="true" ShowLastButton="true" Rectangular="true" />
        </div>
    }
}

@code {
    private TicketFiltro _filtro = new();
    private List<SeguimientoDto> _seguimientos = new();
    private ResumenSeguimientoDto _resumen = new();
    private List<string> _grupo = new();
    private bool _cargando = true;
    private bool _cargadoAlgunaVez;
    private DateTime? _ultimaCarga;
    private int _version;
    private Timer? _debounce;

    private string? _busquedaRef;
    private int? _etapaFiltro;
    private string? _responsable;
    private bool _sinActualizacion;
    private bool _conJira;
    private bool _enVP;
    private bool _proveedorPendiente;
    private bool _verFinalizadas;

    private int _pagina = 1;
    private int _tamano = 24;
    private int _total;

    private int TotalPaginas => _tamano <= 0 ? 0 : (int)Math.Ceiling(_total / (double)_tamano);
    private int Desde => _total == 0 ? 0 : (_pagina - 1) * _tamano + 1;
    private int Hasta => Math.Min(_pagina * _tamano, _total);

    protected override async Task OnInitializedAsync()
    {
        try { _grupo = await Api.GrupoAnalistasAsync(); } catch { _grupo = new(); }
        await Cargar();
    }

    private async Task Cargar()
    {
        _cargando = true;
        StateHasChanged();
        try
        {
            _filtro = new TicketFiltro
            {
                FechaDesde = null,
                Texto = _busquedaRef,
                EtapaSeguimiento = _etapaFiltro,
                AsignatarioNombre = _responsable,
                SinActualizacionReciente = _sinActualizacion ? true : null,
                ConJira = _conJira ? true : null,
                ReportadoVP = _enVP ? true : null,
                ReportadoProveedor = _proveedorPendiente ? 2 : null,
                SoloActivos = !_verFinalizadas,
                Page = _pagina,
                PageSize = _tamano
            };
            var tLista = Api.BuscarSeguimientosAsync(_filtro);
            var tResumen = Api.SeguimientoResumenAsync(_filtro);
            await Task.WhenAll(tLista, tResumen);
            _seguimientos = tLista.Result.Items;
            _total = tLista.Result.TotalCount;
            _resumen = tResumen.Result;
            // Si un filtro dejó la página actual vacía, volvemos a la última con datos.
            if (_seguimientos.Count == 0 && _total > 0 && _pagina > 1)
            {
                _pagina = TotalPaginas;
                await Cargar();
                return;
            }
            _ultimaCarga = DateTime.Now;
            _cargadoAlgunaVez = true;
            _version++;
        }
        catch (ApiException ex) { Snackbar.Add(ex.MensajeUsuario, Severity.Error); }
        catch (Exception ex) { Snackbar.Add($"No se pudieron cargar los seguimientos: {ex.Message}", Severity.Error); }
        finally { _cargando = false; StateHasChanged(); }
    }

    // ===== Filtros =====
    private async Task Toggle(string clave)
    {
        switch (clave)
        {
            case "sinact": _sinActualizacion = !_sinActualizacion; break;
            case "jira": _conJira = !_conJira; break;
            case "vp": _enVP = !_enVP; break;
            case "prov": _proveedorPendiente = !_proveedorPendiente; break;
        }
        _pagina = 1;
        await Cargar();
    }

    private async Task CambiarBandeja(bool finalizadas)
    {
        _verFinalizadas = finalizadas;
        _pagina = 1;
        await Cargar();
    }

    private async Task OnEtapaChanged(int? e) { _etapaFiltro = e; _pagina = 1; await Cargar(); }
    private async Task OnResponsableChanged(string? r) { _responsable = r; _pagina = 1; await Cargar(); }
    private async Task OnTamanoChanged(int t) { _tamano = t; _pagina = 1; await Cargar(); }

    private void OnBusquedaChanged(string? t)
    {
        _busquedaRef = t;
        _pagina = 1;
        _debounce?.Dispose();
        _debounce = new Timer(_ => InvokeAsync(Cargar), null, 400, Timeout.Infinite);
    }

    private async Task CambiarPagina(int p)
    {
        _pagina = p;
        await Cargar();
        await Ui.IrAAsync("lista-seguimiento");
    }

    private List<ActiveFilterChips.FiltroActivo> FiltrosActivos
    {
        get
        {
            var l = new List<ActiveFilterChips.FiltroActivo>();
            if (!string.IsNullOrWhiteSpace(_busquedaRef)) l.Add(new("texto", $"\"{_busquedaRef}\""));
            if (_etapaFiltro.HasValue) l.Add(new("etapa", $"Etapa: {EtapasSeguimiento.Texto(_etapaFiltro.Value)}"));
            if (!string.IsNullOrWhiteSpace(_responsable)) l.Add(new("responsable", $"Responsable: {_responsable}"));
            if (_sinActualizacion) l.Add(new("sinact", "Sin actualizar 7d+"));
            if (_conJira) l.Add(new("jira", "Con JIRA"));
            if (_enVP) l.Add(new("vp", "En reporte VP"));
            if (_proveedorPendiente) l.Add(new("prov", "Proveedor pendiente"));
            return l;
        }
    }

    private async Task QuitarFiltro(ActiveFilterChips.FiltroActivo f)
    {
        switch (f.Clave)
        {
            case "texto": _busquedaRef = null; break;
            case "etapa": _etapaFiltro = null; break;
            case "responsable": _responsable = null; break;
            case "sinact": _sinActualizacion = false; break;
            case "jira": _conJira = false; break;
            case "vp": _enVP = false; break;
            case "prov": _proveedorPendiente = false; break;
        }
        _pagina = 1;
        await Cargar();
    }

    private async Task LimpiarFiltros()
    {
        _busquedaRef = null; _etapaFiltro = null; _responsable = null;
        _sinActualizacion = _conJira = _enVP = _proveedorPendiente = false;
        _pagina = 1;
        await Cargar();
    }

    // ===== Acciones =====
    /// <summary>Abre la MISMA ventana de gestión que se usa en Tickets, con todo el detalle.</summary>
    private async Task AbrirGestion(SeguimientoDto s)
    {
        var p = new DialogParameters
        {
            ["RefNum"] = s.RefNum,
            ["EsOrdenCambio"] = s.TipoOrigen == "chg",
            ["OrdenCambioRef"] = s.OrdenCambioRef
        };
        var d = await DialogService.ShowAsync<ReporteGestionDialog>($"Gestión · {s.RefNum}", p,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        var r = await d.Result;
        if (r is { Canceled: false }) await Cargar();
    }

    private async Task Finalizar(SeguimientoDto s)
    {
        var ok = await DialogService.ShowMessageBox(
            "Finalizar gestión",
            $"¿Dar por finalizada la gestión de {s.RefNum}? Pasará a «Gestiones finalizadas». El historial se conserva y puedes reabrirla luego.",
            yesText: "Finalizar", cancelText: "Cancelar");
        if (ok != true) return;

        try
        {
            await Api.FinalizarGestionAsync(s.SeguimientoId, "Gestión finalizada desde Seguimiento.", null);
            Snackbar.Add($"Gestión de {s.RefNum} finalizada", Severity.Success);
            await Cargar();
        }
        catch (ApiException ex) { Snackbar.Add(ex.MensajeUsuario, Severity.Error); }
    }

    private async Task Reabrir(SeguimientoDto s)
    {
        try
        {
            await Api.ReabrirGestionAsync(s.SeguimientoId, null);
            Snackbar.Add($"Gestión de {s.RefNum} reabierta", Severity.Success);
            await Cargar();
        }
        catch (ApiException ex) { Snackbar.Add(ex.MensajeUsuario, Severity.Error); }
    }

    private static bool RequiereAtencion(SeguimientoDto s)
        => s.ProximoSeguimiento.HasValue && s.ProximoSeguimiento.Value <= DateTime.Now;

    private static int DiasSinActualizar(SeguimientoDto s) => (int)(DateTime.UtcNow - s.ActualizadoEn).TotalDays;

    private static Color EtapaColor(int etapa) => etapa switch
    {
        12 => Color.Success,       // Cerrado
        13 => Color.Default,       // Cancelado
        3 or 4 => Color.Warning,   // Espera / reportado proveedor
        14 => Color.Error,         // Reabierto
        _ => Color.Primary
    };

    private async Task AbrirCrear()
    {
        var dialog = await DialogService.ShowAsync<CrearSeguimientoDialog>("Nuevo seguimiento",
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        var res = await dialog.Result;
        if (res is { Canceled: false }) { Snackbar.Add("Seguimiento creado", Severity.Success); await Cargar(); }
    }

    private async Task AbrirDetalle(string refNum)
    {
        var p = new DialogParameters { ["RefNum"] = refNum };
        await DialogService.ShowAsync<TimelineDialog>($"Timeline · {refNum}", p,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
    }

    public void Dispose() => _debounce?.Dispose();
}

@page "/seguimiento"
@inject TicketAnalyticsApi Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Seguimiento · TicketAnalytics</PageTitle>

<div class="d-flex justify-space-between align-center mb-1">
    <MudText Typo="Typo.h4">Seguimiento operativo</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AbrirCrear">
        Nuevo seguimiento
    </MudButton>
</div>
<MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">Etapas de trabajo, timeline auditable y continuidad bajo orden de cambio</MudText>

<div class="d-flex gap-2 mb-3 flex-wrap align-center">
    <MudChip T="string" Size="Size.Medium" OnClick="@(() => CambiarBandeja(false))"
             Style="@(!_verFinalizadas
                      ? "background:var(--bsc-azul);color:#fff;cursor:pointer;font-weight:600"
                      : "background:transparent;color:var(--bsc-azul);border:1px solid var(--bsc-azul);cursor:pointer")">
        Gestiones activas
    </MudChip>
    <MudChip T="string" Size="Size.Medium" OnClick="@(() => CambiarBandeja(true))"
             Style="@(_verFinalizadas
                      ? "background:#2E7D32;color:#fff;cursor:pointer;font-weight:600"
                      : "background:transparent;color:#2E7D32;border:1px solid #2E7D32;cursor:pointer")">
        Gestiones finalizadas
    </MudChip>
</div>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid Spacing="2" AlignItems="Center">
        <MudItem xs="12" md="4">
            <MudTextField @bind-Value="_busquedaRef" Label="Buscar por No. de ticket" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="false" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudSelect T="int?" Label="Etapa" @bind-Value="_etapaFiltro" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var e in EtapasSeguimiento.Todas)
                {
                    <MudSelectItem T="int?" Value="@e.Id">@e.Texto</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4" Class="d-flex gap-2">
            <MudCheckBox T="bool" @bind-Value="_sinActualizacion" Label="Sin actualizar (7d+)" Color="Color.Warning" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Cargar">Filtrar</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_cargando)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else if (!_seguimientos.Any())
{
    <MudPaper Class="pa-8 text-center" Elevation="1">
        <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Large" Class="mud-text-secondary mb-2" />
        <MudText>No hay seguimientos. Crea uno con el botón "Nuevo seguimiento" o búscalo por número de ticket.</MudText>
    </MudPaper>
}
else
{
    <MudGrid Spacing="3" Class="mb-3">
        <MudItem xs="6" md="3"><KpiCard Titulo="En seguimiento" Valor="@_seguimientos.Count.ToString()" Icono="@Icons.Material.Filled.Assignment" Acento="azul" /></MudItem>
        <MudItem xs="6" md="3"><KpiCard Titulo="Con JIRA" Valor="@_seguimientos.Count(s => s.CantidadJiras > 0).ToString()" Icono="@Icons.Material.Filled.BugReport" Acento="neutro" /></MudItem>
        <MudItem xs="6" md="3"><KpiCard Titulo="Reportados a proveedor" Valor="@_seguimientos.Count(s => s.CantidadReportesProveedor > 0).ToString()" Icono="@Icons.Material.Filled.Business" Acento="cumplido" /></MudItem>
        <MudItem xs="6" md="3"><KpiCard Titulo="Requieren atención" Valor="@_seguimientos.Count(RequiereAtencion).ToString()" Icono="@Icons.Material.Filled.Warning" Acento="riesgo" /></MudItem>
    </MudGrid>

    <MudGrid Spacing="3">
        @foreach (var s in _seguimientos)
        {
            <MudItem xs="12" md="6" lg="4">
                <MudCard Elevation="1" Class="@("oc-card " + (RequiereAtencion(s) ? "pendiente" : ""))" Style="height:100%;">
                    <MudCardContent>
                        <div class="d-flex justify-space-between align-center mb-2">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@(s.TipoOrigen == "chg" ? Icons.Material.Filled.ChangeCircle : Icons.Material.Filled.ConfirmationNumber)"
                                         Size="Size.Small" Color="@(s.TipoOrigen == "chg" ? Color.Secondary : Color.Primary)" />
                                <MudText Typo="Typo.h6"><b>@s.RefNum</b></MudText>
                            </div>
                            <MudChip T="string" Size="Size.Small" Color="@EtapaColor(s.EtapaActual)">@s.EtapaActualTexto</MudChip>
                        </div>
                        @if (!string.IsNullOrEmpty(s.TipoCaso))
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@s.TipoCaso · @s.TecnicoResponsable</MudText>
                        }
                        @if (s.ContinuaBajoOC && !string.IsNullOrEmpty(s.OrdenCambioRef) && s.OrdenCambioRef != s.RefNum)
                        {
                            <MudTooltip Text="El trabajo de este ticket continúa bajo esta orden de cambio">
                                <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.ArrowForward"
                                         Color="Color.Secondary" Variant="Variant.Outlined" Class="mt-1">
                                    Continúa en OC @s.OrdenCambioRef
                                </MudChip>
                            </MudTooltip>
                        }
                        else if (s.TipoOrigen == "chg")
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Text" Class="mt-1">
                                Orden de cambio
                            </MudChip>
                        }
                        @* Estado de un vistazo: proveedor, JIRA, VP y clasificación *@
                        <div class="d-flex gap-1 flex-wrap mt-2">
                            <MudChip T="string" Size="Size.Small"
                                     Style="@($"background:{ColorProveedor(s.ReportadoProveedor)};color:#fff;font-weight:600")">
                                @IconoTextoProveedor(s.ReportadoProveedor)
                            </MudChip>
                            <MudChip T="string" Size="Size.Small"
                                     Style="@(s.CantidadJiras > 0
                                              ? "background:#1976D2;color:#fff;font-weight:600"
                                              : "background:transparent;color:#667085;border:1px solid #D2DBE6")">
                                @(s.CantidadJiras > 0 ? $"JIRA ({s.CantidadJiras})" : "Sin JIRA")
                            </MudChip>
                            @if (s.VaReporteVP)
                            {
                                <MudChip T="string" Size="Size.Small" Style="background:#6B4EFF;color:#fff;font-weight:600">
                                    Reportado al VP
                                </MudChip>
                            }
                            @if (!string.IsNullOrWhiteSpace(s.CausaRaiz))
                            {
                                <MudChip T="string" Size="Size.Small" Style="background:#2E7D32;color:#fff;font-weight:600">
                                    Causa raíz
                                </MudChip>
                            }
                        </div>

                        @if (s.Sistema > 0 || s.TipoSolucion > 0)
                        {
                            <MudText Typo="Typo.caption" Class="mt-2 d-block" Style="color:var(--texto-secundario)">
                                @(s.Sistema > 0 ? s.SistemaTexto : "")@(s.Sistema > 0 && s.TipoSolucion > 0 ? " · " : "")@(s.TipoSolucion > 0 ? s.TipoSolucionTexto : "")
                            </MudText>
                        }

                        <MudDivider Class="my-2" />
                        <div class="d-flex gap-3">
                            <MudTooltip Text="Actualizaciones"><span><MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" /> @s.CantidadActualizaciones</span></MudTooltip>
                            <MudTooltip Text="JIRA"><span><MudIcon Icon="@Icons.Material.Filled.BugReport" Size="Size.Small" /> @s.CantidadJiras</span></MudTooltip>
                            <MudTooltip Text="Proveedor"><span><MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" /> @s.CantidadReportesProveedor</span></MudTooltip>
                            <MudTooltip Text="Evidencias"><span><MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" /> @s.CantidadEvidencias</span></MudTooltip>
                        </div>
                        @if (!string.IsNullOrEmpty(s.ProximosPasos))
                        {
                            <MudText Typo="Typo.body2" Class="mt-2"><b>Próximo:</b> @s.ProximosPasos</MudText>
                        }
                    </MudCardContent>
                    <MudCardActions Class="d-flex flex-wrap gap-1">
                        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Timeline"
                                   OnClick="@(() => AbrirDetalle(s.RefNum))">Timeline</MudButton>
                        <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.EditNote"
                                   OnClick="@(() => AbrirGestion(s))">Gestionar</MudButton>
                        @if (_verFinalizadas)
                        {
                            <MudButton Size="Size.Small" Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.Replay"
                                       OnClick="@(() => Reabrir(s))">Reabrir</MudButton>
                        }
                        else
                        {
                            <MudButton Size="Size.Small" Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.TaskAlt"
                                       OnClick="@(() => Finalizar(s))">Finalizar</MudButton>
                        }
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private TicketFiltro _filtro = new() { PageSize = 60 };
    private List<SeguimientoDto> _seguimientos = new();
    private bool _cargando = true;
    private string? _busquedaRef;
    private int? _etapaFiltro;
    private bool _sinActualizacion;
    private bool _verFinalizadas;

    private async Task CambiarBandeja(bool finalizadas)
    {
        _verFinalizadas = finalizadas;
        await Cargar();
    }

    /// <summary>Abre la MISMA ventana de gestión que se usa en Tickets, con todo el detalle.</summary>
    private async Task AbrirGestion(SeguimientoDto s)
    {
        var p = new DialogParameters
        {
            ["RefNum"] = s.RefNum,
            ["EsOrdenCambio"] = s.TipoOrigen == "chg",
            ["OrdenCambioRef"] = s.OrdenCambioRef
        };
        var d = await DialogService.ShowAsync<ReporteGestionDialog>($"Gestión · {s.RefNum}", p,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        var r = await d.Result;
        if (!r.Canceled) await Cargar();
    }

    private async Task Finalizar(SeguimientoDto s)
    {
        var motivo = await DialogService.ShowMessageBox(
            "Finalizar gestión",
            $"¿Dar por finalizada la gestión de {s.RefNum}? Pasará a 'Gestiones finalizadas'. El historial se conserva y puedes reabrirla luego.",
            yesText: "Finalizar", cancelText: "Cancelar");
        if (motivo != true) return;

        try
        {
            await Api.FinalizarGestionAsync(s.SeguimientoId, "Gestión finalizada desde Seguimiento.", null);
            Snackbar.Add($"Gestión de {s.RefNum} finalizada", Severity.Success);
            await Cargar();
        }
        catch (ApiException ex) { Snackbar.Add(ex.MensajeUsuario, Severity.Error); }
    }

    private async Task Reabrir(SeguimientoDto s)
    {
        try
        {
            await Api.ReabrirGestionAsync(s.SeguimientoId, null);
            Snackbar.Add($"Gestión de {s.RefNum} reabierta", Severity.Success);
            await Cargar();
        }
        catch (ApiException ex) { Snackbar.Add(ex.MensajeUsuario, Severity.Error); }
    }

    private static string ColorProveedor(int estado) => estado switch
    {
        1 => "#2E7D32",   // Sí
        0 => "#667085",   // No
        _ => "#ED6C02"    // Pendiente
    };

    private static string IconoTextoProveedor(int estado) => estado switch
    {
        1 => "Proveedor: Sí",
        0 => "Proveedor: No",
        _ => "Proveedor: pendiente"
    };

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        _cargando = true; StateHasChanged();
        try
        {
            _filtro.Texto = _busquedaRef;
            _filtro.EtapaSeguimiento = _etapaFiltro;
            _filtro.SinActualizacionReciente = _sinActualizacion ? true : null;
            _filtro.SoloActivos = !_verFinalizadas;
            var r = await Api.BuscarSeguimientosAsync(_filtro);
            _seguimientos = r.Items.ToList();
        }
        finally { _cargando = false; StateHasChanged(); }
    }

    private static bool RequiereAtencion(SeguimientoDto s)
        => s.ProximoSeguimiento.HasValue && s.ProximoSeguimiento.Value <= DateTime.Now;

    private static Color EtapaColor(int etapa) => etapa switch
    {
        12 => Color.Success,       // Cerrado
        13 => Color.Default,       // Cancelado
        3 or 4 => Color.Warning,   // Espera / reportado proveedor
        14 => Color.Error,         // Reabierto
        _ => Color.Primary
    };

    private async Task AbrirCrear()
    {
        var dialog = await DialogService.ShowAsync<CrearSeguimientoDialog>("Nuevo seguimiento",
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var res = await dialog.Result;
        if (!res.Canceled) { Snackbar.Add("Seguimiento creado", Severity.Success); await Cargar(); }
    }

    private async Task AbrirActualizar(string refNum)
    {
        var p = new DialogParameters { ["RefNum"] = refNum };
        var dialog = await DialogService.ShowAsync<ActualizarSeguimientoDialog>($"Actualizar {refNum}", p,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var res = await dialog.Result;
        if (!res.Canceled) { Snackbar.Add("Actualización registrada", Severity.Success); await Cargar(); }
    }

    private async Task AbrirDetalle(string refNum)
    {
        var p = new DialogParameters { ["RefNum"] = refNum };
        await DialogService.ShowAsync<TimelineDialog>($"Timeline · {refNum}", p,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
    }
}

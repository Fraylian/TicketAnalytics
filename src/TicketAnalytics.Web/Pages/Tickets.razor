@page "/tickets"
@inject TicketAnalyticsApi Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject FileDownloadService Descargas

<PageTitle>Tickets · TicketAnalytics</PageTitle>

<PageHeader Titulo="Tickets" Icono="@Icons.Material.Filled.ConfirmationNumber"
            Bajada="Solicitudes e incidentes con su orden de cambio asociada">
    <Acciones>
        <MudButton StartIcon="@(_exportando ? null : Icons.Material.Filled.TableView)" Variant="Variant.Filled" Color="Color.Success"
                   OnClick="Exportar" Disabled="@(_exportando || _resultado is null || _resultado.TotalCount == 0)">
            @if (_exportando)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Generando…</span>
            }
            else
            {
                <span>Exportar a Excel</span>
            }
        </MudButton>
    </Acciones>
</PageHeader>

@* Vistas rápidas: al entrar, la pantalla se enfoca en lo que requiere atención *@
<div class="ta-pills mb-3">
    <span class="lbl">Vista:</span>
    @foreach (var v in Vistas)
    {
        <button type="button" class="@($"ta-pill {(_vista == v.Clave ? "activa" : "")}")" style="@($"--pill:{v.Color}")"
                @onclick="@(() => CambiarVista(v.Clave))">
            <MudIcon Icon="@v.Icono" Style="font-size:16px" /> @v.Texto
        </button>
    }
</div>

<FiltroPanel Filtro="_filtro" OnAplicar="Recargar" Contexto="tickets" />

<MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-4">
<MudTabPanel Text="Listado" Icon="@Icons.Material.Filled.TableRows">

@if (_error is not null)
{
    <ErrorState Mensaje="No se pudieron cargar los tickets." Detalle="@_error"
                Secundario="Si el problema persiste, revisa que existan categorías en alcance (GET /api/admin/categorias)."
                OnReintentar="Recargar" />
}

<div class="panel pa-0">
    <div class="d-flex justify-space-between align-center flex-wrap gap-2 pa-4 pb-2">
        <span class="ta-resumen-pag">
            @if (_resultado is not null)
            {
                @if (_resultado.TotalCount == 0)
                {
                    <text>Sin resultados para esta vista</text>
                }
                else
                {
                    var desde = (_resultado.Page - 1) * _resultado.PageSize + 1;
                    var hasta = Math.Min(_resultado.Page * _resultado.PageSize, _resultado.TotalCount);
                    @if (Buscando)
                    {
                        <text><MudIcon Icon="@Icons.Material.Filled.Search" Style="font-size:15px;vertical-align:middle" /> <b>@_resultado.TotalCount</b> resultados para "@_filtro.Texto" en <b>todos</b> los tickets · mostrando @desde–@hasta</text>
                    }
                    else
                    {
                        <text><MudIcon Icon="@Icons.Material.Filled.Schedule" Style="font-size:15px;vertical-align:middle" /> Más recientes primero · mostrando <b>@desde–@hasta</b> de <b>@_resultado.TotalCount</b> tickets · @TextoVista</text>
                    }
                }
            }
        </span>
        <div class="d-flex gap-2 flex-wrap">
            @if (_resultado is not null && _resultado.Items.Any(i => i.ReqCerradoConCambioPendiente))
            {
                <span class="ta-tag warn"><MudIcon Icon="@Icons.Material.Filled.LinkOff" Style="font-size:14px" /> @_resultado.Items.Count(i => i.ReqCerradoConCambioPendiente) cerrados con OC pendiente en esta página</span>
            }
            @if (_resultado is not null && _resultado.Items.Any(i => i.EstadoVencimiento is "vencido" or "vence_hoy"))
            {
                <span class="ta-tag err"><MudIcon Icon="@Icons.Material.Filled.Error" Style="font-size:14px" /> @_resultado.Items.Count(i => i.EstadoVencimiento is "vencido" or "vence_hoy") vencidos o vencen hoy</span>
            }
        </div>
    </div>

    <MudTable ServerData="CargarServer" @ref="_tabla" Dense="true" Hover="true" Striped="false" RowsPerPage="15"
              Breakpoint="Breakpoint.Md" Elevation="0" Class="ta-tabla-click"
              OnRowClick="AbrirDetalle" T="TicketEnriquecidoDto" RowClassFunc="@FilaClass">
        <HeaderContent>
            <MudTh>Tipo</MudTh>
            <MudTh>No. Ticket</MudTh>
            <MudTh>Resumen</MudTh>
            <MudTh>Categoría</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Asignatario</MudTh>
            <MudTh>Apertura</MudTh>
            <MudTh>Vencimiento</MudTh>
            <MudTh>SLA</MudTh>
            <MudTh>OC</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Tipo">
                <span class="@($"ta-tag {(context.TipoCaso == "Incidente" ? "err" : "info")}")">@context.TipoCaso</span>
            </MudTd>
            <MudTd DataLabel="No. Ticket"><b>@context.NoTicket</b></MudTd>
            <MudTd DataLabel="Resumen" Style="max-width:220px">
                <MudText Typo="Typo.body2" Style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="@context.Descripcion">
                    @Formato.Corto(context.Descripcion, 60)
                </MudText>
            </MudTd>
            <MudTd DataLabel="Categoría"><span title="@context.Categoria">@Formato.Area(context.Categoria)</span></MudTd>
            <MudTd DataLabel="Estado">@context.Estado</MudTd>
            <MudTd DataLabel="Asignatario">
                @if (string.IsNullOrWhiteSpace(context.Asignatario))
                {
                    <span class="ta-tag warn">Sin asignar</span>
                }
                else
                {
                    <div class="d-flex align-center gap-2">
                        <span class="ta-avatar sm" style="@($"background:{Formato.ColorAvatar(context.Asignatario)}")">@Formato.Iniciales(context.Asignatario)</span>
                        <span>@Formato.NombreCorto(context.Asignatario)</span>
                    </div>
                }
            </MudTd>
            <MudTd DataLabel="Apertura">@context.FechaApertura?.ToString("dd/MM/yyyy")</MudTd>
            <MudTd DataLabel="Vencimiento">
                @if (ReglaAlertas.VenceEnLaProximaHora(context.FechaVencimiento) && context.EstadoVencimiento != "cerrado")
                {
                    <span class="ta-tag urgente"><MudIcon Icon="@Icons.Material.Filled.AlarmOn" Style="font-size:14px" /> vence en @((int)Math.Ceiling((context.FechaVencimiento!.Value - DateTime.Now).TotalMinutes)) min</span>
                }
                else if (context.FechaVencimiento.HasValue && context.EstadoVencimiento is not ("cerrado" or "sin_fecha"))
                {
                    <EstadoVencimientoChip Estado="@context.EstadoVencimiento" DiasRestantes="@context.DiasParaVencer" />
                }
                else
                {
                    <span class="ta-tenue">@(context.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "—")</span>
                }
            </MudTd>
            <MudTd DataLabel="SLA">
                <span class="@($"ta-tag {(context.ResueltoDentroSLA == "SI" ? "ok" : context.ResueltoDentroSLA == "NO" ? "err" : "")}")">
                    @(context.ResueltoDentroSLA switch { "SI" => "Dentro", "NO" => "Fuera", "EN CURSO" => "En curso", _ => context.ResueltoDentroSLA })
                </span>
            </MudTd>
            <MudTd DataLabel="OC">
                @if (context.TieneOrdenCambio)
                {
                    <MudTooltip Text="@($"OC {context.NoOC} · {context.EstadoOC}")">
                        <span class="@($"ta-tag {(context.ReqCerradoConCambioPendiente ? "warn" : "ok")}")">
                            <MudIcon Icon="@Icons.Material.Filled.ChangeCircle" Style="font-size:14px" /> @context.NoOC
                        </span>
                    </MudTooltip>
                }
                else { <span class="ta-tenue">—</span> }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <EmptyState Icono="@Icons.Material.Filled.SearchOff" Mensaje="No hay tickets para estos filtros."
                        Detalle="Amplía el rango de fechas, cambia de vista o quita algún criterio." />
        </NoRecordsContent>
        <LoadingContent>
            <div class="pa-4">
                @for (var i = 0; i < 6; i++) { <MudSkeleton Height="34px" Animation="Animation.Wave" Class="mb-1" /> }
            </div>
        </LoadingContent>
        <PagerContent><MudTablePager PageSizeOptions="new[]{15,25,50,100}" RowsPerPageString="Filas por página" InfoFormat="{first_item}–{last_item} de {all_items}" /></PagerContent>
    </MudTable>
</div>

</MudTabPanel>

<MudTabPanel Text="Pendientes de proveedor" Icon="@Icons.Material.Filled.Business" BadgeData="@(_pendientes.Count > 0 ? _pendientes.Count : null)" BadgeColor="Color.Warning">
    <MudText Typo="Typo.body2" Class="mb-3" Style="color:var(--texto-secundario)">
        Casos cuyo reporte al proveedor está en <b>No</b> o <b>Pendiente</b>: todavía requieren
        escalamiento o confirmación de que se resolvieron internamente. Clic en una fila para gestionarlo.
    </MudText>

    @if (_cargandoPendientes)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (!_pendientes.Any())
    {
        <EmptyState Icono="@Icons.Material.Filled.CheckCircle" ColorIcono="var(--op-cumplido)"
                    Mensaje="No hay casos pendientes de escalar a proveedor." />
    }
    else
    {
        <div class="panel pa-0">
            <MudTable Items="_pendientes" Dense="true" Hover="true" Elevation="0" Class="ta-tabla-sticky ta-tabla-click"
                      Breakpoint="Breakpoint.Sm" T="PendienteEscalarDto"
                      OnRowClick="@((TableRowClickEventArgs<PendienteEscalarDto> a) => GestionarPendiente(a.Item!))">
                <HeaderContent>
                    <MudTh>Caso</MudTh>
                    <MudTh>Tipo</MudTh>
                    <MudTh>Categoría</MudTh>
                    <MudTh>Responsable</MudTh>
                    <MudTh>Estado proveedor</MudTh>
                    <MudTh>Próximos pasos</MudTh>
                    <MudTh>Actualizado</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Caso"><b>@context.RefNum</b></MudTd>
                    <MudTd DataLabel="Tipo">@(context.TipoOrigen == "chg" ? "Orden de cambio" : "Ticket")</MudTd>
                    <MudTd DataLabel="Categoría">@(context.Categoria ?? "—")</MudTd>
                    <MudTd DataLabel="Responsable">@(context.TecnicoResponsable ?? "—")</MudTd>
                    <MudTd DataLabel="Estado proveedor">
                        <span class="@($"ta-tag {(context.Estado == 2 ? "warn" : "")}")">@context.EstadoTexto</span>
                    </MudTd>
                    <MudTd DataLabel="Próximos pasos">@Formato.Corto(context.ProximosPasos, 80)</MudTd>
                    <MudTd DataLabel="Actualizado">@Formato.Hace(context.ActualizadoEn)</MudTd>
                </RowTemplate>
            </MudTable>
        </div>
    }
</MudTabPanel>

<MudTabPanel Text="Bandeja por analista" Icon="@Icons.Material.Filled.NotificationsActive">
    <BandejaVencimientos />
</MudTabPanel>

</MudTabs>

@code {
    // Vista por defecto: lo que requiere atención (abiertos / pendientes de gestión)
    private TicketFiltro _filtro = new() { SoloAbiertos = true };
    private string _vista = "abiertos";
    private bool _exportando;

    public record Vista(string Clave, string Texto, string Icono, string Color);
    public static readonly Vista[] Vistas =
    {
        new("abiertos",    "Abiertos / pendientes",      Icons.Material.Filled.FolderOpen,  "#15528E"),
        new("vencidos",    "SLA vencido",                Icons.Material.Filled.Error,       "#C62828"),
        new("proveedor",   "Pendientes de proveedor",    Icons.Material.Filled.Business,    "#ED6C02"),
        new("ocpendiente", "Cerrado con OC pendiente",   Icons.Material.Filled.LinkOff,     "#7B1FA2"),
        new("todos",       "Todos",                      Icons.Material.Filled.AllInbox,    "#455A64")
    };

    /// <summary>?ticket=REF abre el detalle; funciona también si ya estamos en /tickets (p. ej. desde una alerta).</summary>
    [SupplyParameterFromQuery(Name = "ticket")] public string? TicketQuery { get; set; }
    private string? _ultimoTicketQuery;

    /// <summary>Con texto de búsqueda se busca en TODOS los tickets: la vista rápida no recorta resultados.</summary>
    private bool Buscando => !string.IsNullOrWhiteSpace(_filtro.Texto);

    private string TextoVista => Vistas.FirstOrDefault(v => v.Clave == _vista)?.Texto.ToLowerInvariant() ?? "";

    private List<PendienteEscalarDto> _pendientes = new();
    private bool _cargandoPendientes = true;

    private MudTable<TicketEnriquecidoDto> _tabla = default!;
    private PagedResult<TicketEnriquecidoDto>? _resultado;
    private string? _error;
    private string? _ticketAAbrir;

    protected override async Task OnInitializedAsync()
    {
        // Drill-down desde otras pantallas: /tickets?vista=vencidos&asignatario=…&sistema=…&ticket=…
        var q = UrlQuery.Leer(Nav);
        if (q.TryGetValue("vista", out var v) && Vistas.Any(x => x.Clave == v)) AplicarVista(v);
        if (q.TryGetValue("asignatario", out var a)) _filtro.AsignatarioNombre = a;
        if (q.TryGetValue("sla", out var sla)) _filtro.EstadoSla = sla;
        if (q.TryGetValue("sistema", out var s) && int.TryParse(s, out var si)) _filtro.Sistema = si;
        if (q.TryGetValue("tiposolucion", out var t) && int.TryParse(t, out var ti)) _filtro.TipoSolucion = ti;
        if (q.TryGetValue("texto", out var tx)) _filtro.Texto = tx;

        await CargarPendientes();
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(TicketQuery) && TicketQuery != _ultimoTicketQuery)
        {
            _ultimoTicketQuery = TicketQuery;
            _ticketAAbrir = TicketQuery;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_ticketAAbrir is null) return;
        var refNum = _ticketAAbrir;
        _ticketAAbrir = null;
        var t = await Api.ObtenerTicketAsync(refNum);
        if (t is not null) await MostrarDetalle(t);
    }

    private async Task CargarPendientes()
    {
        _cargandoPendientes = true;
        try { _pendientes = await Api.PendientesEscalarAsync(); }
        catch { _pendientes = new(); }
        finally { _cargandoPendientes = false; }
    }

    private void AplicarVista(string clave)
    {
        _vista = clave;
        _filtro.SoloAbiertos = null;
        _filtro.PendienteEscalarProveedor = null;
        _filtro.EstadoSla = null;
        _filtro.SoloReqCerradoCambioPendiente = null;

        switch (clave)
        {
            case "abiertos": _filtro.SoloAbiertos = true; break;
            case "proveedor": _filtro.PendienteEscalarProveedor = true; break;
            case "vencidos": _filtro.EstadoSla = "NO"; break;
            case "ocpendiente": _filtro.SoloReqCerradoCambioPendiente = true; break;
        }
    }

    private async Task CambiarVista(string clave)
    {
        AplicarVista(clave);
        _filtro.Page = 1;
        await Recargar();
    }

    private async Task<TableData<TicketEnriquecidoDto>> CargarServer(TableState state, CancellationToken ct)
    {
        try
        {
            _error = null;
            _filtro.Page = state.Page + 1;
            _filtro.PageSize = state.PageSize;
            _filtro.OrderBy = "fechaapertura";   // siempre los más recientes primero
            _filtro.OrderDesc = true;
            _resultado = await Api.BuscarTicketsAsync(FiltroEfectivo());
            // La tabla se redibuja sola, pero el resumen y el botón Exportar viven en la página.
            _ = InvokeAsync(StateHasChanged);
            return new TableData<TicketEnriquecidoDto> { Items = _resultado.Items, TotalItems = _resultado.TotalCount };
        }
        catch (Exception ex)
        {
            _error = ex is ApiException api ? api.MensajeUsuario : ex.Message;
            _resultado = null;
            StateHasChanged();
            return new TableData<TicketEnriquecidoDto> { Items = new List<TicketEnriquecidoDto>(), TotalItems = 0 };
        }
    }

    private async Task Recargar() { if (_tabla is not null) await _tabla.ReloadServerData(); }

    /// <summary>
    /// Filtro que se envía al backend. Si hay texto de búsqueda, se quitan las restricciones de la
    /// vista rápida (abiertos, vencidos, proveedor, OC pendiente) para que el ticket siempre aparezca;
    /// el resto de filtros que el usuario eligió a mano se respetan.
    /// </summary>
    private TicketFiltro FiltroEfectivo()
    {
        var f = System.Text.Json.JsonSerializer.Deserialize<TicketFiltro>(System.Text.Json.JsonSerializer.Serialize(_filtro))!;
        if (Buscando)
        {
            f.SoloAbiertos = null;
            f.PendienteEscalarProveedor = null;
            f.SoloReqCerradoCambioPendiente = null;
            if (_vista == "vencidos") f.EstadoSla = null;
        }
        return f;
    }

    private string FilaClass(TicketEnriquecidoDto t, int _) => t.ReqCerradoConCambioPendiente ? "fila-critica" : "";

    private Task AbrirDetalle(TableRowClickEventArgs<TicketEnriquecidoDto> args) => MostrarDetalle(args.Item!);

    private async Task MostrarDetalle(TicketEnriquecidoDto t)
    {
        var d = await DialogService.ShowAsync<TicketDetalleDialog>($"Ticket {t.NoTicket}",
            new DialogParameters { ["Ticket"] = t },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        var r = await d.Result;
        if (r is { Canceled: false }) { await CargarPendientes(); await Recargar(); }
    }

    private async Task GestionarPendiente(PendienteEscalarDto p)
    {
        var d = await DialogService.ShowAsync<ReporteGestionDialog>($"Gestión · {p.RefNum}",
            new DialogParameters { ["RefNum"] = p.RefNum, ["EsOrdenCambio"] = p.TipoOrigen == "chg" },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        var r = await d.Result;
        if (r is { Canceled: false }) await CargarPendientes();
    }

    private async Task Exportar()
    {
        if (_exportando) return;
        _exportando = true;
        try
        {
            // El backend exporta TODO lo que cumple el filtro actual (no solo la página visible).
            var bytes = await Api.TicketsExcelBytesAsync(FiltroEfectivo());
            await Descargas.DescargarExcelAsync($"Tickets_{DateTime.Now:yyyyMMdd_HHmm}.xlsx", bytes);
            Snackbar.Add($"Excel generado con {_resultado?.TotalCount ?? 0} tickets", Severity.Success);
        }
        catch (ApiException ex) { Snackbar.Add(ex.MensajeUsuario, Severity.Error); }
        catch (Exception) { Snackbar.Add("No pudimos generar el Excel. Intenta de nuevo.", Severity.Error); }
        finally { _exportando = false; }
    }
}

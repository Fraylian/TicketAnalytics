@page "/tickets"
@inject TicketAnalyticsApi Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Tickets · TicketAnalytics</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <div>
        <h1 class="seccion-titulo">Tickets</h1>
        <p class="seccion-bajada">Solicitudes e incidentes con su orden de cambio asociada</p>
    </div>
    <MudButton StartIcon="@Icons.Material.Filled.Download" Variant="Variant.Outlined" Color="Color.Primary"
               OnClick="Exportar" Disabled="@(_resultado is null || !_resultado.Items.Any())">
        Exportar
    </MudButton>
</div>

@* Vistas rápidas: al entrar, la pantalla se enfoca en lo que requiere atención *@
<div class="d-flex gap-2 mb-3 flex-wrap align-center">
    <MudText Typo="Typo.caption" Style="color:var(--texto-secundario)">Vista:</MudText>
    @foreach (var v in Vistas)
    {
        <MudChip T="string" Size="Size.Small" OnClick="@(() => CambiarVista(v.Clave))"
                 Style="@(_vista == v.Clave
                          ? "background:var(--bsc-azul);color:#fff;cursor:pointer;font-weight:600"
                          : "background:transparent;color:var(--bsc-azul);border:1px solid var(--bsc-azul);cursor:pointer")">
            @v.Texto
        </MudChip>
    }
</div>

<FiltroPanel Filtro="_filtro" OnAplicar="Recargar" Contexto="tickets" />

<MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-4">
<MudTabPanel Text="Listado" Icon="@Icons.Material.Filled.TableRows">

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">
        <b>No se pudieron cargar los tickets.</b> @_error
        <div class="mt-1" style="font-size:.8rem">
            Si el problema persiste, revisa que existan categorías en alcance: <code>GET /api/admin/categorias</code>
        </div>
    </MudAlert>
}

<div class="panel pa-0">
    <div class="d-flex justify-space-between align-center pa-4 pb-2">
        <MudText Typo="Typo.body2" Style="color:var(--texto-secundario)">
            @if (_resultado is not null)
            {
                <text><b>@_resultado.TotalCount</b> tickets</text>
            }
        </MudText>
        @if (_resultado is not null && _resultado.Items.Any(i => i.ReqCerradoConCambioPendiente))
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Warning" Variant="Variant.Text">
                @_resultado.Items.Count(i => i.ReqCerradoConCambioPendiente) cerrados con OC pendiente
            </MudChip>
        }
    </div>

    <MudTable ServerData="CargarServer" @ref="_tabla" Dense="true" Hover="true" Striped="false"
              Breakpoint="Breakpoint.Md" Elevation="0" RowClass="cursor-pointer"
              OnRowClick="AbrirDetalle" T="TicketEnriquecidoDto" RowClassFunc="@FilaClass">
        <HeaderContent>
            <MudTh>Tipo</MudTh>
            <MudTh>No. Ticket</MudTh>
            <MudTh>Categoría</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Asignatario</MudTh>
            <MudTh>Apertura</MudTh>
            <MudTh>SLA</MudTh>
            <MudTh>OC</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Tipo">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                         Color="@(context.TipoCaso == "Incidente" ? Color.Error : Color.Primary)">@context.TipoCaso</MudChip>
            </MudTd>
            <MudTd DataLabel="No. Ticket"><b>@context.NoTicket</b></MudTd>
            <MudTd DataLabel="Categoría">@CortarCategoria(context.Categoria)</MudTd>
            <MudTd DataLabel="Estado">@context.Estado</MudTd>
            <MudTd DataLabel="Asignatario">@context.Asignatario</MudTd>
            <MudTd DataLabel="Apertura">@context.FechaApertura?.ToString("dd/MM/yyyy")</MudTd>
            <MudTd DataLabel="SLA">
                <MudChip T="string" Size="Size.Small"
                         Color="@(context.ResueltoDentroSLA == "SI" ? Color.Success : context.ResueltoDentroSLA == "NO" ? Color.Error : Color.Default)"
                         Variant="Variant.Filled">@context.ResueltoDentroSLA</MudChip>
            </MudTd>
            <MudTd DataLabel="OC">
                @if (context.TieneOrdenCambio)
                {
                    <MudTooltip Text="@($"OC {context.NoOC} · {context.EstadoOC}")">
                        <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.ChangeCircle"
                                 Color="@(context.ReqCerradoConCambioPendiente ? Color.Warning : Color.Secondary)"
                                 Variant="Variant.Text">@context.NoOC</MudChip>
                    </MudTooltip>
                }
                else { <span style="color:var(--texto-tenue)">—</span> }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <div class="vacio">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Class="vacio-icono" />
                <MudText Typo="Typo.body1">No hay tickets para estos filtros.</MudText>
                <MudText Typo="Typo.caption" Class="mt-1">Amplía el rango de fechas o quita algún criterio.</MudText>
            </div>
        </NoRecordsContent>
        <LoadingContent><MudText Class="pa-4">Cargando tickets…</MudText></LoadingContent>
        <PagerContent><MudTablePager PageSizeOptions="new[]{25,50,100}" /></PagerContent>
    </MudTable>
</div>

</MudTabPanel>

<MudTabPanel Text="Pendientes de proveedor" Icon="@Icons.Material.Filled.Business">
    <MudText Typo="Typo.body2" Class="mb-3" Style="color:var(--texto-secundario)">
        Casos cuyo reporte al proveedor está en <b>No</b> o <b>Pendiente</b>: todavía requieren
        escalamiento o confirmación de que se resolvieron internamente.
    </MudText>

    @if (_cargandoPendientes)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (!_pendientes.Any())
    {
        <EmptyState Icono="@Icons.Material.Filled.CheckCircle"
                    Mensaje="No hay casos pendientes de escalar a proveedor." />
    }
    else
    {
        <MudTable Items="_pendientes" Dense="true" Hover="true" Elevation="0" Class="ta-tabla-sticky"
                  Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Caso</MudTh>
                <MudTh>Tipo</MudTh>
                <MudTh>Categoría</MudTh>
                <MudTh>Responsable</MudTh>
                <MudTh>Estado proveedor</MudTh>
                <MudTh>Próximos pasos</MudTh>
                <MudTh>Actualizado</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Caso"><b>@context.RefNum</b></MudTd>
                <MudTd DataLabel="Tipo">@(context.TipoOrigen == "chg" ? "Orden de Cambio" : "Ticket")</MudTd>
                <MudTd DataLabel="Categoría">@(context.Categoria ?? "—")</MudTd>
                <MudTd DataLabel="Responsable">@(context.TecnicoResponsable ?? "—")</MudTd>
                <MudTd DataLabel="Estado proveedor">
                    <MudChip T="string" Size="Size.Small"
                             Style="@($"background:{(context.Estado == 2 ? "#ED6C02" : "#667085")};color:#fff")">
                        @context.EstadoTexto
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Próximos pasos">@(context.ProximosPasos ?? "—")</MudTd>
                <MudTd DataLabel="Actualizado">@context.ActualizadoEn.ToString("dd/MM/yyyy")</MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudTabPanel>

<MudTabPanel Text="Bandeja por analista" Icon="@Icons.Material.Filled.NotificationsActive">
    <BandejaVencimientos />
</MudTabPanel>

</MudTabs>

@code {
    // Vista por defecto: lo que requiere atención (abiertos / pendientes de gestión)
    private TicketFiltro _filtro = new() { SoloAbiertos = true };
    private string _vista = "abiertos";

    public record Vista(string Clave, string Texto);
    public static readonly Vista[] Vistas =
    {
        new("abiertos", "Abiertos / pendientes"),
        new("proveedor", "Pendientes de proveedor"),
        new("vencidos", "SLA vencido"),
        new("todos", "Todos")
    };

    private List<PendienteEscalarDto> _pendientes = new();
    private bool _cargandoPendientes = true;

    protected override async Task OnInitializedAsync() => await CargarPendientes();

    private async Task CargarPendientes()
    {
        _cargandoPendientes = true;
        try { _pendientes = await Api.PendientesEscalarAsync(); }
        catch { _pendientes = new(); }
        finally { _cargandoPendientes = false; }
    }

    private async Task CambiarVista(string clave)
    {
        _vista = clave;
        // Limpiamos los atajos y aplicamos solo el de la vista elegida
        _filtro.SoloAbiertos = null;
        _filtro.PendienteEscalarProveedor = null;
        _filtro.EstadoSla = null;

        switch (clave)
        {
            case "abiertos": _filtro.SoloAbiertos = true; break;
            case "proveedor": _filtro.PendienteEscalarProveedor = true; break;
            case "vencidos": _filtro.EstadoSla = "NO"; break;
            case "todos": break;
        }
        await Recargar();
    }
    private MudTable<TicketEnriquecidoDto> _tabla = default!;
    private PagedResult<TicketEnriquecidoDto>? _resultado;
    private string? _error;

    private async Task<TableData<TicketEnriquecidoDto>> CargarServer(TableState state, CancellationToken ct)
    {
        try
        {
            _error = null;
            _filtro.Page = state.Page + 1;
            _filtro.PageSize = state.PageSize;
            _filtro.OrderBy = "fechaapertura";
            _filtro.OrderDesc = true;
            _resultado = await Api.BuscarTicketsAsync(_filtro);
            return new TableData<TicketEnriquecidoDto> { Items = _resultado.Items, TotalItems = _resultado.TotalCount };
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            StateHasChanged();
            return new TableData<TicketEnriquecidoDto> { Items = new List<TicketEnriquecidoDto>(), TotalItems = 0 };
        }
    }

    private async Task Recargar() => await _tabla.ReloadServerData();

    private string FilaClass(TicketEnriquecidoDto t, int _) => t.ReqCerradoConCambioPendiente ? "fila-critica" : "";

    private async Task AbrirDetalle(TableRowClickEventArgs<TicketEnriquecidoDto> args)
    {
        var p = new DialogParameters { ["Ticket"] = args.Item };
        await DialogService.ShowAsync<TicketDetalleDialog>($"Ticket {args.Item.NoTicket}", p,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
    }

    private async Task Exportar()
    {
        try
        {
            var todo = new TicketFiltro
            {
                FechaDesde = _filtro.FechaDesde, FechaHasta = _filtro.FechaHasta,
                TipoCaso = _filtro.TipoCaso, EstadoSla = _filtro.EstadoSla, Texto = _filtro.Texto,
                ComplejidadOC = _filtro.ComplejidadOC, ConOrdenCambio = _filtro.ConOrdenCambio,
                SoloReqCerradoCambioPendiente = _filtro.SoloReqCerradoCambioPendiente,
                Page = 1, PageSize = 500, OrderBy = "fechaapertura", OrderDesc = true
            };
            var data = await Api.BuscarTicketsAsync(todo);
            await CsvExport.DescargarTicketsAsync(data.Items);
            Snackbar.Add($"Exportados {data.Items.Count} tickets", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"No se pudo exportar: {ex.Message}", Severity.Error); }
    }

    private static string CortarCategoria(string? c)
    {
        if (string.IsNullOrEmpty(c)) return "";
        var p = c.Split('.');
        return p.Length > 0 ? p[^1] : c;
    }
}

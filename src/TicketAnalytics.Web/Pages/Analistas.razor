@page "/analistas"
@inject TicketAnalyticsApi Api

<PageTitle>Analistas · TicketAnalytics</PageTitle>

<div class="mb-4">
    <h1 class="seccion-titulo">Analistas</h1>
    <p class="seccion-bajada">Asignaciones, cierres y ritmo de trabajo según el período</p>
</div>

<FiltroPanel Filtro="_filtro" OnAplicar="Cargar" Contexto="analistas" />

@if (_metricas.Any())
{
    <MudPaper Class="pa-3 mb-3" Elevation="0" Style="border:1px solid var(--bsc-borde);border-radius:12px;">
        <MudGrid Spacing="2" AlignItems="Center">
            <MudItem xs="12" md="5">
                <MudSelect T="string" Value="_analistaSel" ValueChanged="OnAnalistaSeleccionado" Label="Ver detalle de un analista"
                           Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" AdornmentIcon="@Icons.Material.Filled.Person">
                    @foreach (var m in _metricas.OrderBy(x => x.Analista))
                    {
                        <MudSelectItem T="string" Value="@m.Analista">@m.Analista</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="7">
                <MudText Typo="Typo.caption" Style="color:var(--texto-secundario)">
                    Selecciona un analista para ver sus números en detalle, o revisa la tabla completa abajo.
                </MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@if (_detalle is not null)
{
    <div class="panel mb-4" style="border-left:4px solid var(--bsc-azul)">
        <div class="d-flex justify-space-between align-center mb-3">
            <div class="d-flex align-center gap-2">
                <MudAvatar Color="Color.Primary" Size="Size.Medium">@Iniciales(_detalle.Analista)</MudAvatar>
                <div>
                    <MudText Typo="Typo.h6" Style="font-weight:600">@_detalle.Analista</MudText>
                    <MudText Typo="Typo.caption" Style="color:var(--texto-secundario)">Detalle del período seleccionado</MudText>
                </div>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => OnAnalistaSeleccionado(null))" />
        </div>

        <MudGrid Spacing="3" Class="mb-3">
            <MudItem xs="6" md="3"><KpiCard Titulo="Tickets recibidos" Valor="@_detalle.TotalRecibidos.ToString()" Icono="@Icons.Material.Filled.MoveToInbox" Acento="azul" Nota="@($"{_detalle.PromedioRecibidosDia}/día")" /></MudItem>
            <MudItem xs="6" md="3"><KpiCard Titulo="Tickets cerrados" Valor="@_detalle.TotalCerrados.ToString()" Icono="@Icons.Material.Filled.CheckCircle" Acento="cumplido" Nota="@($"{_detalle.PromedioCerradosDia}/día")" /></MudItem>
            <MudItem xs="6" md="3"><KpiCard Titulo="Abiertos ahora" Valor="@_detalle.TotalActivos.ToString()" Icono="@Icons.Material.Filled.FolderOpen" Acento="riesgo" /></MudItem>
            <MudItem xs="6" md="3"><KpiCard Titulo="Balance" Valor="@($"{(_detalle.TotalCerrados - _detalle.TotalRecibidos >= 0 ? "+" : "")}{_detalle.TotalCerrados - _detalle.TotalRecibidos}")" Icono="@Icons.Material.Filled.Balance" Acento="@(_detalle.TotalCerrados - _detalle.TotalRecibidos >= 0 ? "cumplido" : "riesgo")" Nota="cerrados − recibidos" /></MudItem>
        </MudGrid>

        <MudGrid Spacing="3">
            <MudItem xs="6" md="3"><KpiCard Titulo="OC recibidas" Valor="@_detalle.OcRecibidas.ToString()" Icono="@Icons.Material.Filled.ChangeCircle" Acento="azul" Nota="@($"{_detalle.OcPromedioRecibidasDia}/día")" /></MudItem>
            <MudItem xs="6" md="3"><KpiCard Titulo="OC cerradas" Valor="@_detalle.OcCerradas.ToString()" Icono="@Icons.Material.Filled.TaskAlt" Acento="cumplido" Nota="@($"{_detalle.OcPromedioCerradasDia}/día")" /></MudItem>
            <MudItem xs="6" md="3"><KpiCard Titulo="Pend. seguimiento" Valor="@_detalle.CasosPendientesSeguimiento.ToString()" Icono="@Icons.Material.Filled.PendingActions" Acento="riesgo" /></MudItem>
            <MudItem xs="6" md="3"><KpiCard Titulo="Espera proveedor" Valor="@_detalle.CasosEnEsperaProveedor.ToString()" Icono="@Icons.Material.Filled.Business" Acento="neutro" Nota="@($"{_detalle.ActualizacionesRealizadas} actualizaciones")" /></MudItem>
        </MudGrid>

        <div class="mt-3">
            <MudText Typo="Typo.overline" Style="color:var(--texto-secundario)">Recibidos contra cerrados por día (promedio sobre días con actividad)</MudText>
            <ApexChart TItem="PuntoAnalista" Options="@_opcionesDetalle" Height="200">
                <ApexPointSeries TItem="PuntoAnalista" Items="_detalleGrafico" Name="Por día" XValue="@(x => x.Analista)" YValue="@(x => x.Recibidos)" SeriesType="SeriesType.Bar" />
            </ApexChart>
        </div>

        @* Listado real de los casos del analista: su cola de trabajo *@
        <div class="mt-4">
            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-3">
                <MudTabPanel Text="Tickets del analista" Icon="@Icons.Material.Filled.ConfirmationNumber">
                    <PanelTecnico Tecnico="@_detalle.Analista" EsOrdenCambio="false"
                                  VistaInicial="abiertas"
                                  OnCerrar="@(() => OnAnalistaSeleccionado(null))" />
                </MudTabPanel>
                <MudTabPanel Text="Órdenes de cambio" Icon="@Icons.Material.Filled.ChangeCircle">
                    <PanelTecnico Tecnico="@_detalle.Analista" EsOrdenCambio="true"
                                  VistaInicial="mes"
                                  OnCerrar="@(() => OnAnalistaSeleccionado(null))" />
                </MudTabPanel>
            </MudTabs>
        </div>
    </div>
}

@if (_cargando)
{
    <MudGrid Spacing="3">
        @for (var i = 0; i < 4; i++) { <MudItem xs="12" sm="6" md="3"><MudSkeleton Height="130px" /></MudItem> }
        <MudItem xs="12"><MudSkeleton Height="340px" /></MudItem>
    </MudGrid>
}
else if (!_metricas.Any())
{
    <div class="panel">
        <div class="vacio">
            <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Large" Class="vacio-icono" />
            <MudText>No hay asignaciones en el período seleccionado.</MudText>
        </div>
    </div>
}
else
{
    <!-- Indicadores globales -->
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <div class="kpi kpi--acento-azul">
                <div>
                    <div class="kpi-etiqueta">Analistas activos</div>
                    <div class="kpi-valor" style="color:var(--bsc-azul)">@_metricas.Count</div>
                    <div class="kpi-nota">con movimiento en el período</div>
                </div>
            </div>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <div class="kpi kpi--acento-azul">
                <div>
                    <div class="kpi-etiqueta">Asignados</div>
                    <div class="kpi-valor" style="color:var(--bsc-azul)">@_metricas.Sum(m => m.TotalRecibidos)</div>
                    <div class="kpi-nota">@_metricas.Sum(m => m.TotalActivos) siguen abiertos</div>
                </div>
            </div>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <div class="kpi kpi--acento-cumplido">
                <div>
                    <div class="kpi-etiqueta">Cerrados</div>
                    <div class="kpi-valor" style="color:var(--op-cumplido)">@_metricas.Sum(m => m.TotalCerrados)</div>
                    <div class="kpi-nota">
                        @{ var bal = _metricas.Sum(m => m.TotalCerrados) - _metricas.Sum(m => m.TotalRecibidos); }
                        Balance @(bal >= 0 ? "+" : "")@bal contra lo recibido
                    </div>
                </div>
            </div>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <div class="kpi kpi--acento-riesgo">
                <div>
                    <div class="kpi-etiqueta">Pendientes de seguimiento</div>
                    <div class="kpi-valor" style="color:var(--op-riesgo)">@_metricas.Sum(m => m.CasosPendientesSeguimiento)</div>
                    <div class="kpi-nota">@_metricas.Sum(m => m.CasosEnEsperaProveedor) en espera del proveedor</div>
                </div>
            </div>
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" md="7">
            <div class="panel">
                <h2 class="panel-titulo">
                    <MudIcon Icon="@Icons.Material.Filled.BarChart" Size="Size.Small" Color="Color.Primary" />
                    Recibidos contra cerrados
                </h2>
                <ApexChart TItem="PuntoAnalista" Options="@_opcionesBarras" Height="320">
                    <ApexPointSeries TItem="PuntoAnalista" Items="_grafico" Name="Recibidos"
                                     XValue="@(p => p.Analista)" YValue="@(p => p.Recibidos)" SeriesType="SeriesType.Bar" />
                    <ApexPointSeries TItem="PuntoAnalista" Items="_grafico" Name="Cerrados"
                                     XValue="@(p => p.Analista)" YValue="@(p => p.Cerrados)" SeriesType="SeriesType.Bar" />
                </ApexChart>
            </div>
        </MudItem>
        <MudItem xs="12" md="5">
            <div class="panel">
                <h2 class="panel-titulo">
                    <MudIcon Icon="@Icons.Material.Filled.Speed" Size="Size.Small" Color="Color.Primary" />
                    Ritmo diario
                </h2>
                <ApexChart TItem="PuntoAnalista" Options="@_opcionesRitmo" Height="320">
                    <ApexPointSeries TItem="PuntoAnalista" Items="_grafico" Name="Recibidos/día"
                                     XValue="@(p => p.Analista)" YValue="@(p => p.PromRecibidos)" SeriesType="SeriesType.Bar" />
                    <ApexPointSeries TItem="PuntoAnalista" Items="_grafico" Name="Cerrados/día"
                                     XValue="@(p => p.Analista)" YValue="@(p => p.PromCerrados)" SeriesType="SeriesType.Bar" />
                </ApexChart>
                <MudText Typo="Typo.caption" Style="color:var(--texto-secundario)">
                    Promedio sobre días con actividad real, no días calendario.
                </MudText>
            </div>
        </MudItem>
    </MudGrid>

    <!-- Detalle por analista -->
    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="panel mt-2">
        <MudTabPanel Text="Tickets" Icon="@Icons.Material.Filled.ConfirmationNumber">
            <MudTable Items="_metricas" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.Md">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<MetricaAnalistaDto,object>(x=>x.Analista)">Analista</MudTableSortLabel></MudTh>
                    <MudTh Style="text-align:right"><MudTableSortLabel SortBy="new Func<MetricaAnalistaDto,object>(x=>x.TotalRecibidos)" InitialDirection="SortDirection.Descending">Recibidos</MudTableSortLabel></MudTh>
                    <MudTh Style="text-align:right">Días</MudTh>
                    <MudTh Style="text-align:right">Prom/día</MudTh>
                    <MudTh Style="text-align:right">Cerrados</MudTh>
                    <MudTh Style="text-align:right">Días</MudTh>
                    <MudTh Style="text-align:right">Prom/día</MudTh>
                    <MudTh Style="text-align:right">Abiertos</MudTh>
                    <MudTh>Balance</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Analista"><b>@context.Analista</b></MudTd>
                    <MudTd DataLabel="Recibidos" Style="text-align:right">@context.TotalRecibidos</MudTd>
                    <MudTd DataLabel="Días apertura" Style="text-align:right">@context.DiasConApertura</MudTd>
                    <MudTd DataLabel="Prom recibidos" Style="text-align:right"><b>@context.PromedioRecibidosDia</b></MudTd>
                    <MudTd DataLabel="Cerrados" Style="text-align:right">@context.TotalCerrados</MudTd>
                    <MudTd DataLabel="Días cierre" Style="text-align:right">@context.DiasConCierre</MudTd>
                    <MudTd DataLabel="Prom cerrados" Style="text-align:right"><b>@context.PromedioCerradosDia</b></MudTd>
                    <MudTd DataLabel="Abiertos" Style="text-align:right">@context.TotalActivos</MudTd>
                    <MudTd DataLabel="Balance">
                        @{ var b = context.TotalCerrados - context.TotalRecibidos; }
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(b >= 0 ? Color.Success : Color.Warning)">
                            @(b >= 0 ? "+" : "")@b
                        </MudChip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Órdenes de cambio" Icon="@Icons.Material.Filled.ChangeCircle">
            <MudTable Items="_metricas.Where(m => m.OcRecibidas > 0 || m.OcCerradas > 0)" Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Analista</MudTh>
                    <MudTh Style="text-align:right">Recibidas</MudTh>
                    <MudTh Style="text-align:right">Prom/día</MudTh>
                    <MudTh Style="text-align:right">Cerradas</MudTh>
                    <MudTh Style="text-align:right">Prom/día</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Analista"><b>@context.Analista</b></MudTd>
                    <MudTd DataLabel="Recibidas" Style="text-align:right">@context.OcRecibidas</MudTd>
                    <MudTd DataLabel="Prom recibidas" Style="text-align:right">@context.OcPromedioRecibidasDia</MudTd>
                    <MudTd DataLabel="Cerradas" Style="text-align:right">@context.OcCerradas</MudTd>
                    <MudTd DataLabel="Prom cerradas" Style="text-align:right">@context.OcPromedioCerradasDia</MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Seguimiento" Icon="@Icons.Material.Filled.Assignment">
            <MudTable Items="_metricas" Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Analista</MudTh>
                    <MudTh Style="text-align:right">Pendientes</MudTh>
                    <MudTh Style="text-align:right">En espera proveedor</MudTh>
                    <MudTh Style="text-align:right">Actualizaciones</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Analista"><b>@context.Analista</b></MudTd>
                    <MudTd DataLabel="Pendientes" Style="text-align:right">
                        @if (context.CasosPendientesSeguimiento > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">@context.CasosPendientesSeguimiento</MudChip>
                        }
                        else { <span style="color:var(--texto-tenue)">0</span> }
                    </MudTd>
                    <MudTd DataLabel="Espera proveedor" Style="text-align:right">@context.CasosEnEsperaProveedor</MudTd>
                    <MudTd DataLabel="Actualizaciones" Style="text-align:right">@context.ActualizacionesRealizadas</MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>
    </MudTabs>
}

<div class="panel mt-4">
    <h2 class="panel-titulo mb-1"><MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Size="Size.Small" Color="Color.Primary" /> Bandeja del equipo — tickets por vencer</h2>
    <p class="seccion-bajada mb-3">Qué tiene cada analista abierto, con alertas de vencimiento por su Incumplimiento previsto</p>
    <BandejaVencimientos Analista="_analistaSel" />
</div>

@code {
    private TicketFiltro _filtro = new();
    private List<MetricaAnalistaDto> _metricas = new();
    private List<PuntoAnalista> _grafico = new();
    private bool _cargando = true;

    private ApexChartOptions<PuntoAnalista> _opcionesBarras = new();
    private ApexChartOptions<PuntoAnalista> _opcionesRitmo = new();

    public class PuntoAnalista
    {
        public string Analista { get; set; } = "";
        public decimal Recibidos { get; set; }
        public decimal Cerrados { get; set; }
        public decimal PromRecibidos { get; set; }
        public decimal PromCerrados { get; set; }
    }

    protected override void OnInitialized()
    {
        _opcionesBarras = new ApexChartOptions<PuntoAnalista>
        {
            Chart = new Chart { Toolbar = new Toolbar { Show = false } },
            Colors = new List<string> { "#15528E", "#76B82A" },
            PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { Horizontal = true } },
            DataLabels = new ApexCharts.DataLabels { Enabled = false },
            Legend = new Legend { Position = LegendPosition.Top }
        };
        _opcionesRitmo = new ApexChartOptions<PuntoAnalista>
        {
            Chart = new Chart { Toolbar = new Toolbar { Show = false } },
            Colors = new List<string> { "#0F3D6B", "#76B82A" },
            DataLabels = new ApexCharts.DataLabels { Enabled = false },
            Legend = new Legend { Position = LegendPosition.Top }
        };
    }

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private bool _debeRenderizar = true;
    protected override bool ShouldRender()
    {
        if (_debeRenderizar) { _debeRenderizar = false; return true; }
        return false;
    }
    private void Render() { _debeRenderizar = true; StateHasChanged(); }

    private string? _analistaSel;
    private MetricaAnalistaDto? _detalle;
    private List<PuntoAnalista> _detalleGrafico = new();
    private ApexChartOptions<PuntoAnalista> _opcionesDetalle = new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false } },
        Colors = new List<string> { "#15528E", "#76B82A" },
        DataLabels = new ApexCharts.DataLabels { Enabled = false },
        Legend = new Legend { Position = LegendPosition.Top }
    };

    private void OnAnalistaSeleccionado(string? analista)
    {
        _analistaSel = analista;
        _detalle = string.IsNullOrEmpty(analista) ? null : _metricas.FirstOrDefault(m => m.Analista == analista);
        if (_detalle is not null)
        {
            _detalleGrafico = new()
            {
                new PuntoAnalista { Analista = "Recibidos/día", Recibidos = _detalle.PromedioRecibidosDia },
                new PuntoAnalista { Analista = "Cerrados/día", Recibidos = _detalle.PromedioCerradosDia }
            };
        }
        Render();
    }

    private static string Iniciales(string nombre)
    {
        var p = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length >= 2 ? $"{p[0][0]}{p[^1][0]}" : nombre.Length >= 2 ? nombre[..2] : nombre;
    }

    private async Task Cargar()
    {
        _cargando = true; Render();
        try
        {
            _metricas = await Api.MetricasAnalistaAsync(_filtro);
            _grafico = _metricas.OrderByDescending(m => m.TotalRecibidos).Take(10).Select(m => new PuntoAnalista
            {
                Analista = Acortar(m.Analista),
                Recibidos = m.TotalRecibidos,
                Cerrados = m.TotalCerrados,
                PromRecibidos = m.PromedioRecibidosDia,
                PromCerrados = m.PromedioCerradosDia
            }).ToList();
        }
        finally { _cargando = false; Render(); }
    }

    private static string Acortar(string n)
    {
        var p = n.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length >= 2 ? $"{p[0]} {p[^1]}" : n;
    }
}

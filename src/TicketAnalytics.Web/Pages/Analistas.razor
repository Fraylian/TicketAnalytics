@page "/analistas"
@inject TicketAnalyticsApi Api
@inject NavigationManager Nav
@inject UiService Ui

<PageTitle>Analistas · TicketAnalytics</PageTitle>

<PageHeader Titulo="Analistas" Icono="@Icons.Material.Filled.Groups"
            Bajada="Asignaciones, cierres, backlog y ritmo de trabajo del equipo"
            UltimaActualizacion="_ultimaCarga" Actualizando="_cargando" OnRefrescar="Cargar" />

<FiltroPanel Filtro="_filtro" OnAplicar="Cargar" Contexto="analistas" />

@if (_error is not null)
{
    <ErrorState Mensaje="No pudimos cargar las métricas del equipo." Detalle="@_error" OnReintentar="Cargar" />
}
else if (_cargando && !_metricas.Any())
{
    <MudGrid Spacing="3">
        @for (var i = 0; i < 4; i++) { <MudItem xs="6" md="3"><KpiCard Cargando="true" /></MudItem> }
        @for (var i = 0; i < 6; i++) { <MudItem xs="12" sm="6" lg="4"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="190px" Animation="Animation.Wave" /></MudItem> }
    </MudGrid>
}
else if (!_metricas.Any())
{
    <div class="panel">
        <EmptyState Icono="@Icons.Material.Filled.Groups" Mensaje="No hay asignaciones en el período seleccionado."
                    Detalle="Amplía el rango de fechas para ver la actividad del equipo." />
    </div>
}
else
{
    <div class="@(_cargando ? "ta-actualizando" : "")" @key="_version">

    @* ===== Indicadores del equipo ===== *@
    <MudGrid Spacing="3" Class="ta-stagger mb-1">
        <MudItem xs="6" md="3">
            <KpiCard Titulo="Asignados" Valor="@TotalRecibidos.ToString()" Icono="@Icons.Material.Filled.MoveToInbox" Acento="azul"
                     Nota="@($"{_metricas.Count} analistas con movimiento")" />
        </MudItem>
        <MudItem xs="6" md="3">
            <KpiCard Titulo="Cerrados" Valor="@TotalCerrados.ToString()" Icono="@Icons.Material.Filled.TaskAlt" Acento="cumplido"
                     Progreso="@Pct(TotalCerrados, TotalRecibidos)" Nota="@($"tasa de cierre {Formato.Porcentaje(TotalCerrados, TotalRecibidos)}")" />
        </MudItem>
        <MudItem xs="6" md="3">
            <KpiCard Titulo="Backlog del equipo" Valor="@TotalBacklog.ToString()" Icono="@Icons.Material.Filled.Inbox" Acento="riesgo"
                     Nota="@($"balance {(TotalCerrados - TotalRecibidos >= 0 ? "+" : "")}{TotalCerrados - TotalRecibidos} contra lo recibido")" />
        </MudItem>
        <MudItem xs="6" md="3">
            <KpiCard Titulo="Órdenes de cambio" Valor="@_metricas.Sum(m => m.OcRecibidas).ToString()" Icono="@Icons.Material.Filled.ChangeCircle" Acento="violeta"
                     Nota="@($"{_metricas.Sum(m => m.OcCerradas)} cerradas en el período")" TextoAccion="Ver órdenes" OnClick="@(() => Nav.NavigateTo("/ordenes-cambio"))" />
        </MudItem>
    </MudGrid>

    @* ===== Ranking del equipo ===== *@
    <SeccionBloque Titulo="El equipo" Icono="@Icons.Material.Filled.Leaderboard"
                   Bajada="Ordenado por tickets recibidos · clic en una tarjeta para ver el detalle del analista">
        <Acciones>
            <MudToggleGroup T="string" Value="_orden" ValueChanged="@(v => _orden = v)" SelectionMode="SelectionMode.SingleSelection"
                            Color="Color.Primary" Size="Size.Small" CheckMark="false">
                <MudToggleItem Value="@("recibidos")">Recibidos</MudToggleItem>
                <MudToggleItem Value="@("backlog")">Backlog</MudToggleItem>
                <MudToggleItem Value="@("cierre")">% cierre</MudToggleItem>
                <MudToggleItem Value="@("oc")">OC</MudToggleItem>
            </MudToggleGroup>
        </Acciones>
    </SeccionBloque>

    <MudGrid Spacing="3" Class="ta-stagger">
        @{ var rank = 0; }
        @foreach (var m in MetricasOrdenadas)
        {
            // Copia local: el contenido de MudItem se evalúa después del bucle.
            var posicion = ++rank;
            var cierre = Pct(m.TotalCerrados, m.TotalRecibidos);
            <MudItem xs="12" sm="6" lg="4">
                <div class="@($"ta-analista {(_analistaSel == m.Analista ? "sel" : "")}")" tabindex="0" role="button"
                     @onclick="@(() => Seleccionar(m.Analista))" @onkeydown="@(e => e.Key is "Enter" or " " ? Seleccionar(m.Analista) : Task.CompletedTask)">
                    <span class="rank">#@posicion</span>
                    <div class="cab">
                        <span class="ta-avatar" style="@($"background:{Formato.ColorAvatar(m.Analista)}")">@Formato.Iniciales(m.Analista)</span>
                        <div style="min-width:0">
                            <div class="nombre">@m.Analista</div>
                            <div class="rol">@m.PromedioRecibidosDia recibidos/día · @m.PromedioCerradosDia cerrados/día</div>
                        </div>
                    </div>
                    <div class="metricas">
                        <div><b><AnimatedNumber Valor="m.TotalRecibidos" /></b><span>Recibidos</span></div>
                        <div><b><AnimatedNumber Valor="m.TotalCerrados" /></b><span>Cerrados</span></div>
                        <div><b style="@(m.TotalActivos > 0 ? "color:var(--op-riesgo)" : "")"><AnimatedNumber Valor="m.TotalActivos" /></b><span>Backlog</span></div>
                        <div><b><AnimatedNumber Valor="m.OcRecibidas" /></b><span>OC</span></div>
                    </div>
                    <div class="pie">
                        <div style="flex:1">
                            <div class="d-flex justify-space-between" style="font-size:.72rem">
                                <span class="ta-muted">Cierre</span>
                                <b style="@($"color:{ColorCierre(cierre)}")">@cierre.ToString("0")%</b>
                            </div>
                            <div class="kpi-prog" style="@($"--kpi-color:{ColorCierre(cierre)}")"><span style="@($"--w:{Math.Min(100, cierre).ToString(System.Globalization.CultureInfo.InvariantCulture)}%")"></span></div>
                        </div>
                        @if (_series.TryGetValue(m.Analista, out var serie) && serie.Count > 1)
                        {
                            <svg class="kpi-spark" viewBox="0 0 100 30" preserveAspectRatio="none" aria-label="Tendencia de tickets recibidos">
                                <polyline class="linea" points="@Puntos(serie)" fill="none" stroke="@Formato.ColorAvatar(m.Analista)" stroke-width="2"
                                          stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
                            </svg>
                        }
                    </div>
                </div>
            </MudItem>
        }
    </MudGrid>

    @* ===== Detalle del analista seleccionado ===== *@
    @if (_detalle is not null)
    {
        <div class="panel mt-4 ta-enter" id="detalle-analista" style="@($"border-left:4px solid {Formato.ColorAvatar(_detalle.Analista)}")">
            <div class="d-flex justify-space-between align-center mb-3 flex-wrap gap-2">
                <div class="d-flex align-center gap-3">
                    <span class="ta-avatar" style="@($"background:{Formato.ColorAvatar(_detalle.Analista)};width:48px;height:48px")">@Formato.Iniciales(_detalle.Analista)</span>
                    <div>
                        <MudText Typo="Typo.h6" Style="font-weight:650">@_detalle.Analista</MudText>
                        <MudText Typo="Typo.caption" Class="ta-muted">Detalle del período seleccionado</MudText>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ConfirmationNumber"
                               Href="@UrlQuery.Url("/tickets", ("vista", "abiertos"), ("asignatario", _detalle.Analista))">Ver sus tickets</MudButton>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-label="Cerrar detalle" OnClick="@(() => Seleccionar(null))" />
                </div>
            </div>

            <MudGrid Spacing="3" Class="mb-3 ta-stagger">
                <MudItem xs="6" md="3"><KpiCard Titulo="Tickets recibidos" Valor="@_detalle.TotalRecibidos.ToString()" Icono="@Icons.Material.Filled.MoveToInbox" Acento="azul" Nota="@($"{_detalle.PromedioRecibidosDia}/día con actividad")" Sparkline="@SerieDe(_detalle.Analista)" /></MudItem>
                <MudItem xs="6" md="3"><KpiCard Titulo="Tickets cerrados" Valor="@_detalle.TotalCerrados.ToString()" Icono="@Icons.Material.Filled.CheckCircle" Acento="cumplido" Progreso="@Pct(_detalle.TotalCerrados, _detalle.TotalRecibidos)" Nota="@($"{_detalle.PromedioCerradosDia}/día · cierre {Formato.Porcentaje(_detalle.TotalCerrados, _detalle.TotalRecibidos)}")" /></MudItem>
                <MudItem xs="6" md="3"><KpiCard Titulo="Backlog" Valor="@_detalle.TotalActivos.ToString()" Icono="@Icons.Material.Filled.Inbox" Acento="riesgo" Nota="tickets abiertos ahora" /></MudItem>
                <MudItem xs="6" md="3"><KpiCard Titulo="Resolución promedio" Valor="@($"{_detalle.PromedioHorasResolucion:0.#}h")" Icono="@Icons.Material.Filled.Timelapse" Acento="neutro" Nota="@($"≈ {_detalle.PromedioHorasResolucion / 24:0.#} días por ticket cerrado")" /></MudItem>
                <MudItem xs="6" md="3"><KpiCard Titulo="OC recibidas" Valor="@_detalle.OcRecibidas.ToString()" Icono="@Icons.Material.Filled.ChangeCircle" Acento="azul" Nota="@($"{_detalle.OcCerradas} cerradas")" /></MudItem>
                <MudItem xs="6" md="3"><KpiCard Titulo="Actualizaciones" Valor="@_detalle.ActualizacionesRealizadas.ToString()" Icono="@Icons.Material.Filled.History" Acento="violeta" Nota="gestiones registradas en el período" /></MudItem>
                <MudItem xs="6" md="3"><KpiCard Titulo="Pend. seguimiento" Valor="@_detalle.CasosPendientesSeguimiento.ToString()" Icono="@Icons.Material.Filled.PendingActions" Acento="riesgo" Nota="pasó su próximo seguimiento" /></MudItem>
                <MudItem xs="6" md="3"><KpiCard Titulo="Espera proveedor" Valor="@_detalle.CasosEnEsperaProveedor.ToString()" Icono="@Icons.Material.Filled.Business" Acento="neutro"
                                                Nota="casos detenidos por el proveedor" TextoAccion="Ver cuáles son" OnClick="VerEsperaProveedor" /></MudItem>
            </MudGrid>

            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-3" @bind-ActivePanelIndex="_tabDetalle">
                <MudTabPanel Text="Tickets del analista" Icon="@Icons.Material.Filled.ConfirmationNumber">
                    <PanelTecnico Tecnico="@_detalle.Analista" EsOrdenCambio="false" VistaInicial="abiertas"
                                  OnCerrar="@(() => Seleccionar(null))" />
                </MudTabPanel>
                <MudTabPanel Text="Órdenes de cambio" Icon="@Icons.Material.Filled.ChangeCircle">
                    <PanelTecnico Tecnico="@_detalle.Analista" EsOrdenCambio="true" VistaInicial="mes"
                                  OnCerrar="@(() => Seleccionar(null))" />
                </MudTabPanel>
                @* Antes la tarjeta mostraba solo el número: aquí se ve cuáles son y desde cuándo esperan. *@
                <MudTabPanel Text="Espera de proveedor" Icon="@Icons.Material.Filled.Business"
                             BadgeData="@(_espera.Count > 0 ? _espera.Count : null)" BadgeColor="Color.Warning">
                    @if (_cargandoEspera)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    }
                    else if (!_espera.Any())
                    {
                        <EmptyState Icono="@Icons.Material.Filled.CheckCircle" ColorIcono="var(--op-cumplido)"
                                    Mensaje="Este analista no tiene casos en espera de proveedor." />
                    }
                    else
                    {
                        <MudTable Items="_espera" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.Sm" T="CasoProveedorDto">
                            <HeaderContent>
                                <MudTh>Caso</MudTh><MudTh>Sistema</MudTh><MudTh>Proveedor</MudTh><MudTh>Caso del proveedor</MudTh>
                                <MudTh Style="text-align:right">En espera desde</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Caso"><b>@context.RefNum</b> <span class="ta-tenue">@(context.TipoOrigen == "chg" ? "OC" : "Ticket")</span></MudTd>
                                <MudTd DataLabel="Sistema">@(context.Sistema ?? "Sin sistema")</MudTd>
                                <MudTd DataLabel="Proveedor">@(context.Proveedor ?? "Por asignar")</MudTd>
                                <MudTd DataLabel="Caso del proveedor">@(context.TicketProveedor ?? "—")</MudTd>
                                <MudTd DataLabel="En espera desde" Style="text-align:right">
                                    @context.Desde.ToLocalTime().ToString("dd/MM/yyyy")
                                    <span style="@($"color:{(context.Dias > 7 ? "var(--op-vencido)" : "var(--texto-tenue)")};font-weight:600")"> · @context.Dias d</span>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudTabPanel>
            </MudTabs>
        </div>
    }

    @* ===== Comparativos ===== *@
    <SeccionBloque Titulo="Comparativo" Icono="@Icons.Material.Filled.BarChart" Bajada="Clic en una barra para abrir el detalle del analista" />
    <MudGrid Spacing="3">
        <MudItem xs="12" md="7">
            <ChartPanel Titulo="Recibidos contra cerrados" Icono="@Icons.Material.Filled.BarChart" Clicable="true" Nota="Clic en un analista para ver su detalle">
                <ApexChart TItem="PuntoAnalista" Options="_opcionesBarras" Height="330"
                           OnDataPointSelection="@((SelectedData<PuntoAnalista> e) => Seleccionar(e.DataPoint?.Items?.FirstOrDefault()?.Nombre))">
                    <ApexPointSeries TItem="PuntoAnalista" Items="_grafico" Name="Recibidos" XValue="@(p => p.Analista)" YValue="@(p => p.Recibidos)" SeriesType="SeriesType.Bar" />
                    <ApexPointSeries TItem="PuntoAnalista" Items="_grafico" Name="Cerrados" XValue="@(p => p.Analista)" YValue="@(p => p.Cerrados)" SeriesType="SeriesType.Bar" />
                    <ApexPointSeries TItem="PuntoAnalista" Items="_grafico" Name="Backlog" XValue="@(p => p.Analista)" YValue="@(p => p.Backlog)" SeriesType="SeriesType.Bar" />
                </ApexChart>
            </ChartPanel>
        </MudItem>
        <MudItem xs="12" md="5">
            <ChartPanel Titulo="Ritmo diario" Icono="@Icons.Material.Filled.Speed" Nota="Promedio sobre días con actividad real, no días calendario.">
                <ApexChart TItem="PuntoAnalista" Options="_opcionesRitmo" Height="330">
                    <ApexPointSeries TItem="PuntoAnalista" Items="_grafico" Name="Recibidos/día" XValue="@(p => p.Analista)" YValue="@(p => p.PromRecibidos)" SeriesType="SeriesType.Bar" />
                    <ApexPointSeries TItem="PuntoAnalista" Items="_grafico" Name="Cerrados/día" XValue="@(p => p.Analista)" YValue="@(p => p.PromCerrados)" SeriesType="SeriesType.Bar" />
                </ApexChart>
            </ChartPanel>
        </MudItem>
    </MudGrid>

    @* ===== Tablas completas ===== *@
    <SeccionBloque Titulo="Detalle en tabla" Icono="@Icons.Material.Filled.TableChart" Bajada="Todas las métricas, ordenables por columna" />
    <div class="panel">
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-2">
            <MudTabPanel Text="Tickets" Icon="@Icons.Material.Filled.ConfirmationNumber">
                <MudTable Items="_metricas" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.Md" Class="ta-tabla-click" T="MetricaAnalistaDto"
                          OnRowClick="@((TableRowClickEventArgs<MetricaAnalistaDto> a) => Seleccionar(a.Item!.Analista))">
                    <HeaderContent>
                        <MudTh><MudTableSortLabel SortBy="new Func<MetricaAnalistaDto,object>(x=>x.Analista)">Analista</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right"><MudTableSortLabel SortBy="new Func<MetricaAnalistaDto,object>(x=>x.TotalRecibidos)" InitialDirection="SortDirection.Descending">Recibidos</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right"><MudTableSortLabel SortBy="new Func<MetricaAnalistaDto,object>(x=>x.PromedioRecibidosDia)">Prom/día</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right"><MudTableSortLabel SortBy="new Func<MetricaAnalistaDto,object>(x=>x.TotalCerrados)">Cerrados</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right"><MudTableSortLabel SortBy="new Func<MetricaAnalistaDto,object>(x=>x.PromedioCerradosDia)">Prom/día</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right"><MudTableSortLabel SortBy="new Func<MetricaAnalistaDto,object>(x=>x.TotalActivos)">Backlog</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right"><MudTableSortLabel SortBy="new Func<MetricaAnalistaDto,object>(x=>x.PromedioHorasResolucion)">Resolución</MudTableSortLabel></MudTh>
                        <MudTh>Balance</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Analista">
                            <div class="d-flex align-center gap-2">
                                <span class="ta-avatar sm" style="@($"background:{Formato.ColorAvatar(context.Analista)}")">@Formato.Iniciales(context.Analista)</span>
                                <b>@context.Analista</b>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Recibidos" Style="text-align:right">@context.TotalRecibidos</MudTd>
                        <MudTd DataLabel="Prom recibidos" Style="text-align:right">@context.PromedioRecibidosDia</MudTd>
                        <MudTd DataLabel="Cerrados" Style="text-align:right">@context.TotalCerrados</MudTd>
                        <MudTd DataLabel="Prom cerrados" Style="text-align:right">@context.PromedioCerradosDia</MudTd>
                        <MudTd DataLabel="Backlog" Style="text-align:right">@context.TotalActivos</MudTd>
                        <MudTd DataLabel="Resolución" Style="text-align:right">@Formato.Horas(context.PromedioHorasResolucion)</MudTd>
                        <MudTd DataLabel="Balance">
                            @{ var b = context.TotalCerrados - context.TotalRecibidos; }
                            <span class="@($"ta-tag {(b >= 0 ? "ok" : "warn")}")">@(b >= 0 ? "+" : "")@b</span>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudTabPanel>

            <MudTabPanel Text="Órdenes de cambio" Icon="@Icons.Material.Filled.ChangeCircle">
                <MudTable Items="_metricas.Where(m => m.OcRecibidas > 0 || m.OcCerradas > 0)" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.Sm">
                    <HeaderContent>
                        <MudTh>Analista</MudTh>
                        <MudTh Style="text-align:right">Recibidas</MudTh>
                        <MudTh Style="text-align:right">Prom/día</MudTh>
                        <MudTh Style="text-align:right">Cerradas</MudTh>
                        <MudTh Style="text-align:right">Prom/día</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Analista"><b>@context.Analista</b></MudTd>
                        <MudTd DataLabel="Recibidas" Style="text-align:right">@context.OcRecibidas</MudTd>
                        <MudTd DataLabel="Prom recibidas" Style="text-align:right">@context.OcPromedioRecibidasDia</MudTd>
                        <MudTd DataLabel="Cerradas" Style="text-align:right">@context.OcCerradas</MudTd>
                        <MudTd DataLabel="Prom cerradas" Style="text-align:right">@context.OcPromedioCerradasDia</MudTd>
                    </RowTemplate>
                    <NoRecordsContent><EmptyState Mensaje="Sin órdenes de cambio en el período." /></NoRecordsContent>
                </MudTable>
            </MudTabPanel>

            <MudTabPanel Text="Seguimiento" Icon="@Icons.Material.Filled.Assignment">
                <MudTable Items="_metricas" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.Sm">
                    <HeaderContent>
                        <MudTh>Analista</MudTh>
                        <MudTh Style="text-align:right">Pendientes</MudTh>
                        <MudTh Style="text-align:right">En espera proveedor</MudTh>
                        <MudTh Style="text-align:right">Actualizaciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Analista"><b>@context.Analista</b></MudTd>
                        <MudTd DataLabel="Pendientes" Style="text-align:right">
                            @if (context.CasosPendientesSeguimiento > 0) { <span class="ta-tag warn">@context.CasosPendientesSeguimiento</span> }
                            else { <span class="ta-tenue">0</span> }
                        </MudTd>
                        <MudTd DataLabel="Espera proveedor" Style="text-align:right">@context.CasosEnEsperaProveedor</MudTd>
                        <MudTd DataLabel="Actualizaciones" Style="text-align:right">@context.ActualizacionesRealizadas</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudTabPanel>
        </MudTabs>
    </div>
    </div>
}

<SeccionBloque Id="bandeja-equipo" Titulo="Bandeja del equipo · tickets por vencer" Icono="@Icons.Material.Filled.NotificationsActive"
               Bajada="Qué tiene cada analista abierto, con alertas por su incumplimiento previsto" />
<div class="panel">
    <BandejaVencimientos Analista="@_analistaSel" />
</div>

@code {
    private TicketFiltro _filtro = new();
    private List<MetricaAnalistaDto> _metricas = new();
    private List<PuntoAnalista> _grafico = new();
    private Dictionary<string, List<double>> _series = new();
    private bool _cargando = true;
    private string? _error;
    private DateTime? _ultimaCarga;
    private int _version;
    private string _orden = "recibidos";

    private string? _analistaSel;
    private MetricaAnalistaDto? _detalle;
    private int _tabDetalle;
    private List<CasoProveedorDto> _espera = new();
    private bool _cargandoEspera;
    private string? _esperaDe;

    private readonly ApexChartOptions<PuntoAnalista> _opcionesBarras =
        ChartTheme.Barras<PuntoAnalista>(new() { ChartTheme.Azul, ChartTheme.Verde, ChartTheme.Ambar }, horizontal: true);
    private readonly ApexChartOptions<PuntoAnalista> _opcionesRitmo =
        ChartTheme.Barras<PuntoAnalista>(new() { ChartTheme.AzulProfundo, ChartTheme.Verde });

    public class PuntoAnalista
    {
        public string Analista { get; set; } = "";
        public string Nombre { get; set; } = "";
        public decimal Recibidos { get; set; }
        public decimal Cerrados { get; set; }
        public decimal Backlog { get; set; }
        public decimal PromRecibidos { get; set; }
        public decimal PromCerrados { get; set; }
    }

    private int TotalRecibidos => _metricas.Sum(m => m.TotalRecibidos);
    private int TotalCerrados => _metricas.Sum(m => m.TotalCerrados);
    private int TotalBacklog => _metricas.Sum(m => m.TotalActivos);

    private IEnumerable<MetricaAnalistaDto> MetricasOrdenadas => _orden switch
    {
        "backlog" => _metricas.OrderByDescending(m => m.TotalActivos),
        "cierre" => _metricas.OrderByDescending(m => Pct(m.TotalCerrados, m.TotalRecibidos)),
        "oc" => _metricas.OrderByDescending(m => m.OcRecibidas),
        _ => _metricas.OrderByDescending(m => m.TotalRecibidos)
    };

    protected override async Task OnInitializedAsync()
    {
        var q = UrlQuery.Leer(Nav);
        if (q.TryGetValue("analista", out var a)) _analistaSel = a;
        await Cargar();
        if (_detalle is not null) await Ui.IrAAsync("detalle-analista");
    }

    private async Task Cargar()
    {
        _cargando = true;
        _error = null;
        StateHasChanged();
        try
        {
            // (Diario TI desactivado: ya no se consultan las horas registradas.)
            _metricas = await Api.MetricasAnalistaAsync(_filtro);

            _grafico = _metricas.OrderByDescending(m => m.TotalRecibidos).Take(10).Select(m => new PuntoAnalista
            {
                Analista = Formato.NombreCorto(m.Analista),
                Nombre = m.Analista,
                Recibidos = m.TotalRecibidos,
                Cerrados = m.TotalCerrados,
                Backlog = m.TotalActivos,
                PromRecibidos = m.PromedioRecibidosDia,
                PromCerrados = m.PromedioCerradosDia
            }).ToList();

            // Tendencia mensual de cada analista para su sparkline (en paralelo, tolerante a fallos).
            var tareas = _metricas.Select(async m =>
            {
                try
                {
                    var f = ClonarFiltro(m.Analista);
                    var t = await Api.TendenciasAsync(f, "mes");
                    return (m.Analista, Serie: t.GroupBy(x => x.Periodo).OrderBy(g => g.Key).Select(g => (double)g.Sum(x => x.Abiertos)).ToList());
                }
                catch { return (m.Analista, Serie: new List<double>()); }
            });
            _series = (await Task.WhenAll(tareas)).ToDictionary(x => x.Analista, x => x.Serie);

            _detalle = _analistaSel is null ? null : _metricas.FirstOrDefault(m => m.Analista == _analistaSel);
            _esperaDe = null;
            await CargarEspera();
            _ultimaCarga = DateTime.Now;
            _version++;
        }
        catch (ApiException ex) { _error = ex.MensajeUsuario; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _cargando = false; StateHasChanged(); }
    }

    private TicketFiltro ClonarFiltro(string analista) => new()
    {
        FechaDesde = _filtro.FechaDesde, FechaHasta = _filtro.FechaHasta, TipoCaso = _filtro.TipoCaso,
        EstadoSla = _filtro.EstadoSla, AsignatarioNombre = analista
    };

    private async Task Seleccionar(string? analista)
    {
        _analistaSel = string.IsNullOrWhiteSpace(analista) || _analistaSel == analista ? null : analista;
        _detalle = _analistaSel is null ? null : _metricas.FirstOrDefault(m => m.Analista == _analistaSel);
        _tabDetalle = 0;
        StateHasChanged();
        await CargarEspera();
        if (_detalle is not null)
        {
            await Task.Yield();
            await Ui.IrAAsync("detalle-analista");
        }
    }

    /// <summary>Casos del analista en espera de proveedor (local, barato). Se recarga al cambiar de analista.</summary>
    private async Task CargarEspera()
    {
        if (_detalle is null) { _espera = new(); _esperaDe = null; return; }
        if (_esperaDe == _detalle.Analista) return;
        _cargandoEspera = true;
        try
        {
            _espera = await Api.EsperaProveedorAsync(_detalle.AnalistaUuid, _detalle.Analista);
            _esperaDe = _detalle.Analista;
        }
        catch { _espera = new(); }
        finally { _cargandoEspera = false; StateHasChanged(); }
    }

    private async Task VerEsperaProveedor()
    {
        _tabDetalle = 2;
        await CargarEspera();
    }

    private List<double>? SerieDe(string analista) => _series.TryGetValue(analista, out var s) && s.Count > 1 ? s : null;

    private static double Pct(int parte, int total) => total <= 0 ? 0 : Math.Round(parte * 100.0 / total, 1);

    private static string ColorCierre(double p) => p >= 80 ? "var(--op-cumplido)" : p >= 50 ? "var(--op-riesgo)" : "var(--op-vencido)";

    private static string Puntos(List<double> s)
    {
        double min = s.Min(), max = s.Max();
        var rango = Math.Abs(max - min) < 0.0001 ? 1 : max - min;
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        return string.Join(" ", s.Select((v, i) =>
            $"{(i * 100.0 / (s.Count - 1)).ToString("0.##", ci)},{(27 - (v - min) / rango * 24).ToString("0.##", ci)}"));
    }
}

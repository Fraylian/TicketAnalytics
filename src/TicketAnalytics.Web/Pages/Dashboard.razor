@page "/"
@inject TicketAnalyticsApi Api
@inject NavigationManager Nav

<PageTitle>Panel · TicketAnalytics</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <div>
        <h1 class="seccion-titulo">Panel de operaciones</h1>
        <p class="seccion-bajada">Sistemas · Canales &amp; Medios de Pago y Gestión e Información</p>
    </div>
</div>

<FiltroPanel Filtro="_filtro" OnAplicar="CargarTodo" Contexto="dashboard" />

@if (_cargando)
{
    <MudGrid Spacing="3">
        <MudItem xs="12"><MudSkeleton Height="120px" /></MudItem>
        @for (var i = 0; i < 4; i++)
        {
            <MudItem xs="12" sm="6" md="3"><MudSkeleton Height="150px" /></MudItem>
        }
        <MudItem xs="12" md="8"><MudSkeleton Height="340px" /></MudItem>
        <MudItem xs="12" md="4"><MudSkeleton Height="340px" /></MudItem>
    </MudGrid>
}
else
{
    <!-- ===== SIGNATURE: barra de riesgo SLA ===== -->
    <div class="panel mb-4">
        <h2 class="panel-titulo">
            <MudIcon Icon="@Icons.Material.Filled.Speed" Size="Size.Small" Color="Color.Primary" />
            Riesgo de SLA del período
        </h2>
        <BarraRiesgoSla Vencidos="_slaVencidos" EnRiesgo="_slaRiesgo" EnCurso="_slaEnCurso" Cumplidos="_slaCumplidos" />
    </div>

    <!-- ===== KPIs con sparkline ===== -->
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <div class="kpi kpi--acento-azul">
                <div>
                    <div class="kpi-etiqueta">Tickets del período</div>
                    <div class="kpi-valor" style="color:var(--bsc-azul)">@_totalTickets</div>
                    <div class="kpi-nota">@_totalAbiertos abiertos · @_totalCerrados cerrados</div>
                </div>
                @if (_sparkAperturas.Any())
                {
                    <div class="kpi-spark">
                        <ApexChart @ref="_spark1" TItem="PuntoSpark" Options="@OpcionesSpark("#15528E")" Height="38">
                            <ApexPointSeries TItem="PuntoSpark" Items="_sparkAperturas" Name="Aperturas"
                                             XValue="@(p => p.Etiqueta)" YAggregate="@(g => g.Sum(p => p.Valor))"
                                             SeriesType="SeriesType.Area" />
                        </ApexChart>
                    </div>
                }
            </div>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <div class="kpi kpi--acento-cumplido">
                <div>
                    <div class="kpi-etiqueta">Cumplimiento SLA</div>
                    <div class="kpi-valor" style="color:var(--op-cumplido)">@_pctSla<span style="font-size:1.1rem">%</span></div>
                    <div class="kpi-nota">@_resumenSla?.PromedioHorasResolucion.ToString("0.#")h promedio de resolución</div>
                </div>
                <div class="kpi-spark d-flex align-end px-2 pb-1">
                    <MudProgressLinear Color="@(_pctSla >= 90 ? Color.Success : _pctSla >= 70 ? Color.Warning : Color.Error)"
                                       Value="@((double)_pctSla)" Size="Size.Medium" Rounded="true" Class="mb-2" />
                </div>
            </div>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <div class="kpi kpi--acento-riesgo">
                <div>
                    <div class="kpi-etiqueta">Requieren atención</div>
                    <div class="kpi-valor" style="color:var(--op-riesgo)">@(_slaVencidos + _slaRiesgo)</div>
                    <div class="kpi-nota">@_slaVencidos vencidos · @_slaRiesgo por vencer</div>
                </div>
                <div class="kpi-spark d-flex align-end px-2 pb-2">
                    <MudText Typo="Typo.caption" Style="color:var(--texto-tenue)">
                        @(_totalTickets > 0 ? Math.Round(100.0 * (_slaVencidos + _slaRiesgo) / _totalTickets) : 0)% del total
                    </MudText>
                </div>
            </div>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <div class="kpi @(_totalCritico > 0 ? "kpi--acento-vencido" : "kpi--acento-azul")">
                <div>
                    <div class="kpi-etiqueta">Cerrado con OC pendiente</div>
                    <div class="kpi-valor" style="color:@(_totalCritico > 0 ? "var(--op-vencido)" : "var(--texto-tenue)")">@_totalCritico</div>
                    <div class="kpi-nota">@_totalConOc tickets con orden de cambio</div>
                </div>
                <div class="kpi-spark d-flex align-end px-2 pb-2">
                    @if (_totalCritico > 0)
                    {
                        <MudButton Href="/tickets" Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Class="pa-0">Revisar</MudButton>
                    }
                </div>
            </div>
        </MudItem>
    </MudGrid>

    <!-- ===== Control operativo (OC + analistas) ===== -->
    <div class="dash-section-header">
        <div class="icono"><MudIcon Icon="@Icons.Material.Filled.Insights" Color="Color.Primary" /></div>
        <div>
            <MudText Typo="Typo.h6" Style="font-weight:600">Control operativo</MudText>
            <MudText Typo="Typo.caption" Style="color:var(--texto-secundario)">Órdenes de cambio y carga del equipo de un vistazo</MudText>
        </div>
    </div>

    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="6" md="3"><KpiCard Titulo="OC vencidas" Valor="@_ocDash.Vencidas.ToString()" Icono="@Icons.Material.Filled.Error" Acento="vencido" Nota="órdenes de cambio" OnClick="@(() => Navegar("/ordenes-cambio"))" /></MudItem>
        <MudItem xs="6" md="3"><KpiCard Titulo="OC vencen este mes" Valor="@_ocDash.VencenEsteMes.ToString()" Icono="@Icons.Material.Filled.CalendarMonth" Acento="riesgo" OnClick="@(() => Navegar("/ordenes-cambio"))" /></MudItem>
        <MudItem xs="6" md="3"><KpiCard Titulo="OC abiertas" Valor="@_ocDash.Abiertas.ToString()" Icono="@Icons.Material.Filled.FolderOpen" Acento="azul" Nota="@($"{_ocDash.PctCompletadas:0.#}% completadas")" /></MudItem>
        <MudItem xs="6" md="3"><KpiCard Titulo="OC sin analista" Valor="@_ocDash.SinAnalista.ToString()" Icono="@Icons.Material.Filled.PersonOff" Acento="neutro" OnClick="@(() => Navegar("/ordenes-cambio"))" /></MudItem>
    </MudGrid>

    <div class="panel mb-4">
        <div class="d-flex justify-space-between align-center mb-2">
            <h2 class="panel-titulo mb-0"><MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" Color="Color.Primary" /> Carga del equipo</h2>
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward" OnClick="@(() => Navegar("/analistas"))">Ver detalle</MudButton>
        </div>
        @if (_metricas.Any())
        {
            <MudSimpleTable Dense="true" Hover="true" Elevation="0" Style="background:transparent">
                <thead>
                    <tr>
                        <th>Analista</th>
                        <th style="text-align:right">Recibidos</th>
                        <th style="text-align:right">Cerrados</th>
                        <th style="text-align:right">Abiertos</th>
                        <th style="text-align:right">Balance</th>
                        <th style="width:20%">Carga</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var maxRec = _metricas.Any() ? _metricas.Max(m => m.TotalRecibidos) : 1; }
                    @foreach (var m in _metricas.OrderByDescending(x => x.TotalRecibidos).Take(8))
                    {
                        var bal = m.TotalCerrados - m.TotalRecibidos;
                        <tr>
                            <td><b>@m.Analista</b></td>
                            <td style="text-align:right">@m.TotalRecibidos</td>
                            <td style="text-align:right;color:var(--op-cumplido)">@m.TotalCerrados</td>
                            <td style="text-align:right">@m.TotalActivos</td>
                            <td style="text-align:right">
                                <span style="@($"color:{(bal >= 0 ? "var(--op-cumplido)" : "var(--op-riesgo)")};font-weight:600")">@(bal >= 0 ? "+" : "")@bal</span>
                            </td>
                            <td>
                                <div class="barra-tiempo"><span class="tiempo-ok" style="@($"width:{(maxRec > 0 ? 100 * m.TotalRecibidos / maxRec : 0)}%;background:var(--bsc-azul)")"></span></div>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
        else { <EmptyState Mensaje="Sin datos de analistas en el período." /> }
    </div>

    <!-- ===== Gráficos ===== -->
    <MudGrid Spacing="3">
        <MudItem xs="12" md="8">
            <div class="panel">
                <div class="d-flex justify-space-between align-center mb-2">
                    <h2 class="panel-titulo mb-0">
                        <MudIcon Icon="@Icons.Material.Filled.ShowChart" Size="Size.Small" Color="Color.Primary" />
                        Flujo de trabajo: entradas contra cierres
                    </h2>
                    <MudToggleGroup T="string" Value="_granularidad" ValueChanged="OnGranularidadChanged"
                                    SelectionMode="SelectionMode.SingleSelection" Color="Color.Primary" Size="Size.Small" CheckMark="false">
                        <MudToggleItem Value="@("dia")">Día</MudToggleItem>
                        <MudToggleItem Value="@("semana")">Semana</MudToggleItem>
                        <MudToggleItem Value="@("mes")">Mes</MudToggleItem>
                    </MudToggleGroup>
                </div>
                @if (_flujo.Any())
                {
                    <ApexChart @ref="_chartFlujo" TItem="PuntoFlujo" Options="@_opcionesFlujo" Height="300">
                        <ApexPointSeries TItem="PuntoFlujo" Items="_flujo" Name="Recibidos"
                                         XValue="@(p => p.Periodo)" YValue="@(p => p.Abiertos)" SeriesType="SeriesType.Area" />
                        <ApexPointSeries TItem="PuntoFlujo" Items="_flujo" Name="Cerrados"
                                         XValue="@(p => p.Periodo)" YValue="@(p => p.Cerrados)" SeriesType="SeriesType.Area" />
                    </ApexChart>
                    <MudText Typo="Typo.caption" Style="color:var(--texto-secundario)">
                        Cuando la línea de cerrados va por debajo de recibidos, el represamiento sube.
                    </MudText>
                }
                else
                {
                    <div class="vacio"><MudText>Sin movimiento en el período seleccionado.</MudText></div>
                }
            </div>
        </MudItem>

        <MudItem xs="12" md="4">
            <div class="panel">
                <h2 class="panel-titulo">
                    <MudIcon Icon="@Icons.Material.Filled.DonutLarge" Size="Size.Small" Color="Color.Primary" />
                    Reparto por categoría
                </h2>
                @if (_porCategoria.Any())
                {
                    <ApexChart @ref="_chartCat" TItem="PuntoCategoria" Options="@_opcionesDona" Height="300">
                        <ApexPointSeries TItem="PuntoCategoria" Items="_porCategoria" Name="Tickets"
                                         XValue="@(p => p.Categoria)" YAggregate="@(g => g.Sum(p => p.Total))"
                                         SeriesType="SeriesType.Donut" />
                    </ApexChart>
                }
                else
                {
                    <div class="vacio"><MudText>Sin datos.</MudText></div>
                }
            </div>
        </MudItem>

        <MudItem xs="12" md="7">
            <div class="panel">
                <h2 class="panel-titulo">
                    <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" Color="Color.Primary" />
                    Carga por analista
                </h2>
                @if (_porAnalista.Any())
                {
                    <ApexChart @ref="_chartAnalista" TItem="PuntoAnalista" Options="@_opcionesBarras" Height="320">
                        <ApexPointSeries TItem="PuntoAnalista" Items="_porAnalista" Name="Recibidos"
                                         XValue="@(p => p.Analista)" YValue="@(p => p.Recibidos)" SeriesType="SeriesType.Bar" />
                        <ApexPointSeries TItem="PuntoAnalista" Items="_porAnalista" Name="Cerrados"
                                         XValue="@(p => p.Analista)" YValue="@(p => p.Cerrados)" SeriesType="SeriesType.Bar" />
                    </ApexChart>
                }
                else
                {
                    <div class="vacio"><MudText>Sin asignaciones en el período.</MudText></div>
                }
            </div>
        </MudItem>

        <MudItem xs="12" md="5">
            <div class="panel">
                <h2 class="panel-titulo">
                    <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Color="Color.Warning" />
                    Vencen primero
                </h2>
                @if (_proximos.Any())
                {
                    <MudTable Items="_proximos.Take(8)" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.None">
                        <HeaderContent>
                            <MudTh>Ticket</MudTh>
                            <MudTh Style="text-align:right">Restan</MudTh>
                            <MudTh style="width:35%">Consumido</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd><b>@context.NoTicket</b></MudTd>
                            <MudTd Style="text-align:right">
                                <span style="color:@(context.HorasRestantes < 8 ? "var(--op-vencido)" : "var(--op-riesgo)")">
                                    @context.HorasRestantes?.ToString("0.#")h
                                </span>
                            </MudTd>
                            <MudTd>
                                <MudProgressLinear Color="Color.Warning" Value="@(context.PctConsumido ?? 0)" Size="Size.Small" Rounded="true" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <div class="vacio">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Class="vacio-icono" Style="color:var(--op-cumplido)" />
                        <MudText>Nada por vencer. Todo bajo control.</MudText>
                    </div>
                }
            </div>
        </MudItem>
    </MudGrid>

    <!-- ===== Clasificación de la gestión (qué trabajos estamos haciendo) ===== -->
    <div class="ta-section-header mt-6">
        <div>
            <h2>Clasificación de la gestión</h2>
            <p>Qué tipo de trabajos realizamos con mayor frecuencia</p>
        </div>
    </div>

    <MudGrid Spacing="3" Class="ta-enter-1">
        <MudItem xs="12" md="6" lg="3">
            <KpiCard Titulo="Reportados a proveedor" Valor="@_ind.ReportadosProveedor.ToString()"
                     Icono="@Icons.Material.Filled.Business" Acento="azul" />
        </MudItem>
        <MudItem xs="12" md="6" lg="3">
            <KpiCard Titulo="Pendientes de escalar" Valor="@_ind.PendientesReportarProveedor.ToString()"
                     Icono="@Icons.Material.Filled.PendingActions" Acento="riesgo"
                     Nota="Requieren seguimiento con proveedor" />
        </MudItem>
        <MudItem xs="12" md="6" lg="3">
            <KpiCard Titulo="Con causa raíz" Valor="@_ind.ConCausaRaiz.ToString()"
                     Icono="@Icons.Material.Filled.Troubleshoot" Acento="cumplido"
                     Nota="@($"{_ind.SinCausaRaiz} sin identificar")" />
        </MudItem>
        <MudItem xs="12" md="6" lg="3">
            <KpiCard Titulo="Reportados al VP" Valor="@_ind.ReportadosVP.ToString()"
                     Icono="@Icons.Material.Filled.Summarize" Acento="azul" />
        </MudItem>

        <MudItem xs="12" lg="6">
            <ChartPanel Titulo="Tickets por sistema" Nota="Sistemas con mayor cantidad de incidencias">
                @if (!_ind.PorSistema.Any())
                {
                    <EmptyState Mensaje="Todavía no hay casos clasificados por sistema." />
                }
                else
                {
                    <div class="pa-2">
                        @foreach (var s in _ind.PorSistema)
                        {
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudText Typo="Typo.body2" Style="min-width:140px">@s.Nombre</MudText>
                                <div style="flex:1;height:10px;background:var(--bsc-superficie-3);border-radius:999px;overflow:hidden">
                                    <div style="@($"width:{Ancho(s.Cantidad, _ind.PorSistema)}%;height:100%;background:var(--dato-1);transition:width var(--transition-slow)")"></div>
                                </div>
                                <MudText Typo="Typo.caption" Style="min-width:76px;text-align:right;color:var(--texto-secundario)">
                                    @s.Cantidad · @s.Porcentaje%
                                </MudText>
                            </div>
                        }
                    </div>
                }
            </ChartPanel>
        </MudItem>

        <MudItem xs="12" lg="6">
            <ChartPanel Titulo="Tipos de solución más utilizados" Nota="Qué trabajos realizamos con mayor frecuencia">
                @if (!_ind.PorTipoSolucion.Any())
                {
                    <EmptyState Mensaje="Todavía no hay casos clasificados por tipo de solución." />
                }
                else
                {
                    <div class="pa-2">
                        @foreach (var t in _ind.PorTipoSolucion)
                        {
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudText Typo="Typo.body2" Style="min-width:170px">@t.Nombre</MudText>
                                <div style="flex:1;height:10px;background:var(--bsc-superficie-3);border-radius:999px;overflow:hidden">
                                    <div style="@($"width:{Ancho(t.Cantidad, _ind.PorTipoSolucion)}%;height:100%;background:var(--dato-2);transition:width var(--transition-slow)")"></div>
                                </div>
                                <MudText Typo="Typo.caption" Style="min-width:76px;text-align:right;color:var(--texto-secundario)">
                                    @t.Cantidad · @t.Porcentaje%
                                </MudText>
                            </div>
                        }
                    </div>
                }
            </ChartPanel>
        </MudItem>

        @* Caso especial: desglose de las actualizaciones de datos de BSC en Línea *@
        @if (_ind.PorTipoActualizacionDatos.Any())
        {
            <MudItem xs="12">
                <ChartPanel Titulo="@($"Actualizaciones de datos · {_ind.TotalActualizacionesDatos} casos")"
                            Nota="Desglose por tipo (BSC en Línea)">
                    <div class="pa-2">
                        @foreach (var a in _ind.PorTipoActualizacionDatos)
                        {
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudText Typo="Typo.body2" Style="min-width:220px">@a.Nombre</MudText>
                                <div style="flex:1;height:10px;background:var(--bsc-superficie-3);border-radius:999px;overflow:hidden">
                                    <div style="@($"width:{Ancho(a.Cantidad, _ind.PorTipoActualizacionDatos)}%;height:100%;background:var(--dato-3);transition:width var(--transition-slow)")"></div>
                                </div>
                                <MudText Typo="Typo.caption" Style="min-width:60px;text-align:right;color:var(--texto-secundario)">
                                    @a.Cantidad
                                </MudText>
                            </div>
                        }
                    </div>
                </ChartPanel>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private TicketFiltro _filtro = new();
    private bool _cargando = true;
    private IndicadoresGestionDto _ind = new();

    /// <summary>Ancho relativo de la barra respecto al valor máximo del conjunto.</summary>
    private static string Ancho(int valor, List<ConteoClasificacionDto> conjunto)
    {
        var max = conjunto.Count == 0 ? 1 : Math.Max(1, conjunto.Max(x => x.Cantidad));
        return (valor * 100.0 / max).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    }
    private string _granularidad = "mes";

    private ResumenSlaDto? _resumenSla;
    private List<SlaTicketDto> _proximos = new();
    private List<PuntoFlujo> _flujo = new();
    private List<PuntoCategoria> _porCategoria = new();
    private List<PuntoAnalista> _porAnalista = new();
    private List<MetricaAnalistaDto> _metricas = new();
    private OrdenCambioDashboardDto _ocDash = new();
    private List<PuntoSpark> _sparkAperturas = new();

    private int _totalTickets, _totalAbiertos, _totalCerrados, _totalConOc, _totalCritico;
    private int _slaVencidos, _slaRiesgo, _slaEnCurso, _slaCumplidos;
    private decimal _pctSla;

    private ApexChart<PuntoFlujo>? _chartFlujo;
    private ApexChart<PuntoCategoria>? _chartCat;
    private ApexChart<PuntoAnalista>? _chartAnalista;
    private ApexChart<PuntoSpark>? _spark1;

    private ApexChartOptions<PuntoFlujo> _opcionesFlujo = new();
    private ApexChartOptions<PuntoCategoria> _opcionesDona = new();
    private ApexChartOptions<PuntoAnalista> _opcionesBarras = new();

    public class PuntoFlujo { public string Periodo { get; set; } = ""; public decimal Abiertos { get; set; } public decimal Cerrados { get; set; } }
    public class PuntoCategoria { public string Categoria { get; set; } = ""; public decimal Total { get; set; } }
    public class PuntoAnalista { public string Analista { get; set; } = ""; public decimal Recibidos { get; set; } public decimal Cerrados { get; set; } }
    public class PuntoSpark { public string Etiqueta { get; set; } = ""; public decimal Valor { get; set; } }

    protected override void OnInitialized()
    {
        ConfigurarGraficos();  // solo configura opciones de gráficos, sin red
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarTodo();
    }

    // Evita re-renders innecesarios que hacen parpadear los gráficos ApexCharts.
    // Solo renderiza cuando lo pedimos explícitamente (tras cargar datos).
    private bool _debeRenderizar = true;
    protected override bool ShouldRender()
    {
        if (_debeRenderizar) { _debeRenderizar = false; return true; }
        return false;
    }
    private void Render() { _debeRenderizar = true; StateHasChanged(); }

    private void Navegar(string url) => Nav.NavigateTo(url);

    private void ConfigurarGraficos()
    {
        // Opciones minimas y estables: solo API basica de Blazor-ApexCharts
        _opcionesFlujo = new ApexChartOptions<PuntoFlujo>
        {
            Chart = new Chart { Toolbar = new Toolbar { Show = false } },
            Colors = new List<string> { "#15528E", "#76B82A" },
            Stroke = new Stroke { Curve = Curve.Smooth, Width = 3 },
            DataLabels = new ApexCharts.DataLabels { Enabled = false },
            Legend = new Legend { Position = LegendPosition.Top }
        };

        _opcionesDona = new ApexChartOptions<PuntoCategoria>
        {
            Chart = new Chart { Toolbar = new Toolbar { Show = false } },
            Colors = new List<string> { "#15528E", "#76B82A", "#0F3D6B", "#5A9BD5", "#ED6C02" },
            Legend = new Legend { Position = LegendPosition.Bottom }
        };

        _opcionesBarras = new ApexChartOptions<PuntoAnalista>
        {
            Chart = new Chart { Toolbar = new Toolbar { Show = false } },
            Colors = new List<string> { "#15528E", "#76B82A" },
            PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { Horizontal = true } },
            DataLabels = new ApexCharts.DataLabels { Enabled = false },
            Legend = new Legend { Position = LegendPosition.Top }
        };
    }

    private ApexChartOptions<PuntoSpark> OpcionesSpark(string color) => new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false }, Sparkline = new ChartSparkline { Enabled = true } },
        Colors = new List<string> { color },
        Stroke = new Stroke { Curve = Curve.Smooth, Width = 2 }
    };

    private async Task CargarTodo()
    {
        _cargando = true; Render();
        try
        {
            // Paralelizar todas las llamadas: mucho más rápido que secuencial
            var tVolumen = Api.VolumenAsync(_filtro);
            var tSla = Api.SlaResumenAsync(_filtro);
            var tProximos = Api.SlaProximosAVencerAsync(_filtro);
            var tCruce = Api.CruceOcAsync(_filtro);
            var tMetricas = Api.MetricasAnalistaAsync(_filtro);
            var tTendencias = Api.TendenciasAsync(_filtro, _granularidad);
            var tOcDash = Api.OcDashboardAsync(new OrdenCambioFiltro { AnioVencimiento = DateTime.Today.Year });
            var tInd = Api.IndicadoresGestionAsync(_filtro.FechaDesde, _filtro.FechaHasta);
            await Task.WhenAll(tVolumen, tSla, tProximos, tCruce, tMetricas, tTendencias, tOcDash, tInd);

            _ind = tInd.Result;

            var volumen = tVolumen.Result;
            _resumenSla = tSla.Result;
            _proximos = tProximos.Result;
            var cruce = tCruce.Result;
            var metricas = tMetricas.Result;
            _metricas = metricas;
            _ocDash = tOcDash.Result;

            _totalTickets = volumen.Sum(v => v.Total);
            _totalAbiertos = volumen.Sum(v => v.Abiertos);
            _totalCerrados = volumen.Sum(v => v.Cerrados);
            _totalConOc = cruce.Sum(c => c.ReqConCambio);
            _totalCritico = cruce.Sum(c => c.ReqCerradoCambioPendiente);

            _slaVencidos = _resumenSla?.Vencidos ?? 0;
            _slaRiesgo = _resumenSla?.ProximosAVencer ?? 0;
            _slaEnCurso = Math.Max(0, (_resumenSla?.EnCurso ?? 0) - _slaRiesgo);
            _slaCumplidos = _resumenSla?.DentroSla ?? 0;
            _pctSla = _resumenSla?.PctCumplimiento ?? 0;

            _porCategoria = volumen.GroupBy(v => CortarCategoria(v.Categoria))
                .Select(g => new PuntoCategoria { Categoria = g.Key, Total = g.Sum(x => x.Total) })
                .Where(p => p.Total > 0).OrderByDescending(p => p.Total).ToList();

            _porAnalista = metricas.OrderByDescending(m => m.TotalRecibidos).Take(8)
                .Select(m => new PuntoAnalista
                {
                    Analista = AcortarNombre(m.Analista),
                    Recibidos = m.TotalRecibidos,
                    Cerrados = m.TotalCerrados
                }).ToList();

            // Procesar tendencias sin StateHasChanged intermedio
            var t = tTendencias.Result;
            _flujo = t.GroupBy(x => x.Periodo).OrderBy(g => g.Key)
                .Select(g => new PuntoFlujo { Periodo = g.Key, Abiertos = g.Sum(x => x.Abiertos), Cerrados = g.Sum(x => x.Cerrados) }).ToList();
            _sparkAperturas = _flujo.Select(f => new PuntoSpark { Etiqueta = f.Periodo, Valor = f.Abiertos }).ToList();
        }
        finally { _cargando = false; Render(); }  // un solo render final controlado
    }

    private async Task OnGranularidadChanged(string valor)
    {
        _granularidad = valor;
        await CargarFlujo();
    }

    private async Task CargarFlujo()
    {
        var t = await Api.TendenciasAsync(_filtro, _granularidad);
        _flujo = t.GroupBy(x => x.Periodo).OrderBy(g => g.Key)
            .Select(g => new PuntoFlujo
            {
                Periodo = g.Key,
                Abiertos = g.Sum(x => x.Abiertos),
                Cerrados = g.Sum(x => x.Cerrados)
            }).ToList();

        _sparkAperturas = _flujo.Select(f => new PuntoSpark { Etiqueta = f.Periodo, Valor = f.Abiertos }).ToList();

        if (_chartFlujo is not null) await _chartFlujo.UpdateSeriesAsync(true);
        Render();
    }

    private static string CortarCategoria(string? c)
    {
        if (string.IsNullOrEmpty(c)) return "Sin categoría";
        var p = c.Split('.');
        return p.Length > 0 ? p[^1] : c;
    }

    private static string AcortarNombre(string nombre)
    {
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return partes.Length >= 2 ? $"{partes[0]} {partes[^1]}" : nombre;
    }
}

@page "/"
@inject TicketAnalyticsApi Api
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject UiService Ui
@inject ISnackbar Snackbar

<PageTitle>Panel · TicketAnalytics</PageTitle>

<PageHeader Titulo="Panel de operaciones" Icono="@Icons.Material.Filled.SpaceDashboard"
            Bajada="Sistemas · Canales & Medios de Pago y Gestión e Información"
            UltimaActualizacion="_ultimaCarga" Actualizando="_cargando" OnRefrescar="CargarTodo" />

<FiltroPanel Filtro="_filtro" OnAplicar="CargarTodo" Contexto="dashboard" />

@* Navegación por bloques: lleva a cada sección sin perder el contexto *@
<div class="ta-pills mb-2">
    <span class="lbl">Ir a:</span>
    @foreach (var (id, texto) in Bloques)
    {
        <button type="button" class="ta-pill" @onclick="@(() => Ui.IrAAsync(id))">@texto</button>
    }
</div>

@if (_error is not null)
{
    <ErrorState Mensaje="No pudimos cargar el panel." Detalle="@_error" OnReintentar="CargarTodo" />
}
else if (_cargando && !_cargadoAlgunaVez)
{
    <MudGrid Spacing="3" Class="mt-2">
        <MudItem xs="12" md="3"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="250px" Animation="Animation.Wave" /></MudItem>
        <MudItem xs="12" md="9"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="250px" Animation="Animation.Wave" /></MudItem>
        @for (var i = 0; i < 4; i++)
        {
            <MudItem xs="12" sm="6" md="3"><KpiCard Cargando="true" /></MudItem>
        }
        <MudItem xs="12" md="8"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="340px" Animation="Animation.Wave" /></MudItem>
        <MudItem xs="12" md="4"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="340px" Animation="Animation.Wave" /></MudItem>
    </MudGrid>
}
else
{
    <div class="@(_cargando ? "ta-actualizando" : "")" @key="_version">

    @* ================= 1. ESTADO GENERAL ================= *@
    <SeccionBloque Id="b-estado" Titulo="Estado general" Icono="@Icons.Material.Filled.MonitorHeart" Primero="true"
                   Bajada="Cumplimiento de SLA y volumen del período filtrado" />

    <MudGrid Spacing="3">
        <MudItem xs="12" md="3">
            <div class="panel d-flex flex-column align-center justify-center ta-alto-total">
                <GaugeRadial Valor="@((double)_pctSla)" Meta="90" Etiqueta="Cumplimiento SLA"
                             Pie="@($"{_resumenSla?.DentroSla ?? 0} de {_resumenSla?.Total ?? 0} dentro de SLA · meta 90%")" />
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" Class="mt-1"
                           EndIcon="@Icons.Material.Filled.ArrowForward" Href="/sla">Abrir monitor SLA</MudButton>
            </div>
        </MudItem>
        <MudItem xs="12" md="9">
            <div class="panel mb-3 ta-alto-auto">
                <div class="panel-cab">
                    <div>
                        <h2 class="panel-titulo"><MudIcon Icon="@Icons.Material.Filled.Speed" Size="Size.Small" Color="Color.Primary" /> Riesgo de SLA del período</h2>
                        <div class="panel-sub">Qué parte del trabajo está en rojo, en riesgo, en curso o cumplida</div>
                    </div>
                </div>
                <BarraRiesgoSla Vencidos="_slaVencidos" EnRiesgo="_slaRiesgo" EnCurso="_slaEnCurso" Cumplidos="_slaCumplidos" />
            </div>
            <MudGrid Spacing="3" Class="ta-stagger">
                <MudItem xs="6" lg="3">
                    <KpiCard Titulo="Tickets del período" Valor="@_totalTickets.ToString()" Icono="@Icons.Material.Filled.ConfirmationNumber"
                             Acento="azul" Nota="@($"{_totalAbiertos} abiertos · {_totalCerrados} cerrados")"
                             Sparkline="@SparkAperturas" TextoAccion="Ver tickets"
                             OnClick="@(() => Nav.NavigateTo("/tickets?vista=todos"))" />
                </MudItem>
                <MudItem xs="6" lg="3">
                    <KpiCard Titulo="Abiertos ahora" Valor="@_totalAbiertos.ToString()" Icono="@Icons.Material.Filled.FolderOpen"
                             Acento="curso" Progreso="@Pct(_totalAbiertos, _totalTickets)"
                             Nota="@($"{Formato.Porcentaje(_totalAbiertos, _totalTickets)} del período sigue abierto")"
                             TextoAccion="Ver abiertos" OnClick="@(() => Nav.NavigateTo("/tickets?vista=abiertos"))" />
                </MudItem>
                <MudItem xs="6" lg="3">
                    <KpiCard Titulo="Requieren atención" Valor="@((_slaVencidos + _slaRiesgo).ToString())" Icono="@Icons.Material.Filled.PriorityHigh"
                             Acento="riesgo" Nota="@($"{_slaVencidos} vencidos · {_slaRiesgo} por vencer")"
                             TextoAccion="Abrir monitor" OnClick="@(() => Nav.NavigateTo("/sla"))" />
                </MudItem>
                <MudItem xs="6" lg="3">
                    <KpiCard Titulo="Resolución promedio" Valor="@($"{_resumenSla?.PromedioHorasResolucion ?? 0:0.#}h")"
                             Icono="@Icons.Material.Filled.Timelapse" Acento="neutro"
                             Nota="desde la apertura hasta el cierre" />
                </MudItem>
            </MudGrid>
        </MudItem>
    </MudGrid>

    @* ================= 2. RIESGO OPERATIVO ================= *@
    <SeccionBloque Id="b-riesgo" Titulo="Riesgo operativo" Icono="@Icons.Material.Filled.Warning"
                   Bajada="Lo que vence primero y dónde se concentran los incumplimientos" />

    <MudGrid Spacing="3">
        <MudItem xs="12" md="5">
            <div class="panel ta-alto-total">
                <div class="panel-cab">
                    <div>
                        <h2 class="panel-titulo"><MudIcon Icon="@Icons.Material.Filled.HourglassBottom" Size="Size.Small" Color="Color.Warning" /> Vencen primero</h2>
                        <div class="panel-sub">Clic en un ticket para ver el detalle y gestionarlo</div>
                    </div>
                    @if (_proximos.Count > 8)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Href="/sla" EndIcon="@Icons.Material.Filled.ArrowForward">Ver los @_proximos.Count</MudButton>
                    }
                </div>
                @if (_proximos.Any())
                {
                    <MudTable Items="_proximos.Take(8)" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.None"
                              Class="ta-tabla-click" OnRowClick="@((TableRowClickEventArgs<SlaTicketDto> a) => AbrirTicket(a.Item!.NoTicket))" T="SlaTicketDto">
                        <HeaderContent>
                            <MudTh>Ticket</MudTh>
                            <MudTh Style="text-align:right">Restan</MudTh>
                            <MudTh Style="width:42%">SLA consumido</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd><b>@context.NoTicket</b></MudTd>
                            <MudTd Style="text-align:right">
                                <span style="@($"color:{(context.HorasRestantes < 8 ? "var(--op-vencido)" : "var(--op-riesgo)")};font-weight:600")">
                                    @Formato.Horas(context.HorasRestantes)
                                </span>
                            </MudTd>
                            <MudTd>
                                <MudTooltip Text="@($"{context.PctConsumido:0}% del tiempo de SLA consumido")">
                                    <MudProgressLinear Color="@(context.PctConsumido >= 95 ? Color.Error : Color.Warning)"
                                                       Value="@(Math.Min(100, context.PctConsumido ?? 0))" Size="Size.Small" Rounded="true" />
                                </MudTooltip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <EmptyState Icono="@Icons.Material.Filled.CheckCircle" ColorIcono="var(--op-cumplido)"
                                Mensaje="Nada por vencer. Todo bajo control." />
                }
            </div>
        </MudItem>
        <MudItem xs="12" md="7">
            <div class="panel ta-alto-total">
                <div class="panel-cab">
                    <div>
                        <h2 class="panel-titulo"><MudIcon Icon="@Icons.Material.Filled.StackedBarChart" Size="Size.Small" Color="Color.Primary" /> Cumplimiento de SLA por categoría</h2>
                        <div class="panel-sub">Proporción dentro de SLA, en curso y fuera de SLA en cada categoría del alcance</div>
                    </div>
                </div>
                <StackedBar100 Filas="_slaCategorias" Unidad="ticket" UnidadPlural="tickets" Meta="90"
                               MensajeVacio="Sin tickets con SLA en el período." />
            </div>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Titulo="Vencidos" Valor="@_slaVencidos.ToString()" Icono="@Icons.Material.Filled.Error" Acento="vencido"
                     Nota="pasaron su fecha de SLA" TextoAccion="Ver vencidos" OnClick="@(() => Nav.NavigateTo("/tickets?vista=vencidos"))" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Titulo="Por vencer" Valor="@_slaRiesgo.ToString()" Icono="@Icons.Material.Filled.Schedule" Acento="riesgo"
                     Nota="80% o más del SLA consumido" TextoAccion="Abrir monitor" OnClick="@(() => Nav.NavigateTo("/sla"))" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Titulo="Cerrado con OC pendiente" Valor="@_totalCritico.ToString()" Icono="@Icons.Material.Filled.LinkOff"
                     Acento="@(_totalCritico > 0 ? "vencido" : "neutro")" Nota="@($"{_totalConOc} tickets con orden de cambio")"
                     TextoAccion="Revisar" OnClick="@(() => Nav.NavigateTo("/tickets?vista=ocpendiente"))" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Titulo="Pendientes de escalar" Valor="@_ind.PendientesReportarProveedor.ToString()" Icono="@Icons.Material.Filled.PendingActions"
                     Acento="riesgo" Nota="requieren seguimiento con proveedor"
                     TextoAccion="Ver casos" OnClick="@(() => Nav.NavigateTo("/tickets?vista=proveedor"))" />
        </MudItem>
    </MudGrid>

    @* ================= 3. FLUJO ================= *@
    <SeccionBloque Id="b-flujo" Titulo="Flujo de trabajo" Icono="@Icons.Material.Filled.ShowChart"
                   Bajada="Entradas contra cierres: si los cierres van por debajo, el represamiento crece" />

    <MudGrid Spacing="3">
        <MudItem xs="12" md="9">
            <ChartPanel Titulo="Entradas contra cierres" Icono="@Icons.Material.Filled.AreaChart" Vacio="@(!_flujo.Any())"
                        MensajeVacio="Sin movimiento en el período seleccionado.">
                <ExtraHeader>
                    <MudToggleGroup T="string" Value="_granularidad" ValueChanged="OnGranularidadChanged"
                                    SelectionMode="SelectionMode.SingleSelection" Color="Color.Primary" Size="Size.Small" CheckMark="false">
                        <MudToggleItem Value="@("dia")">Día</MudToggleItem>
                        <MudToggleItem Value="@("semana")">Semana</MudToggleItem>
                        <MudToggleItem Value="@("mes")">Mes</MudToggleItem>
                    </MudToggleGroup>
                </ExtraHeader>
                <ChildContent>
                    <ApexChart @ref="_chartFlujo" TItem="PuntoFlujo" Options="_opcionesFlujo" Height="310">
                        <ApexPointSeries TItem="PuntoFlujo" Items="_flujo" Name="Recibidos"
                                         XValue="@(p => p.Periodo)" YValue="@(p => p.Abiertos)" SeriesType="SeriesType.Area" />
                        <ApexPointSeries TItem="PuntoFlujo" Items="_flujo" Name="Cerrados"
                                         XValue="@(p => p.Periodo)" YValue="@(p => p.Cerrados)" SeriesType="SeriesType.Area" />
                    </ApexChart>
                </ChildContent>
            </ChartPanel>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudGrid Spacing="3" Class="ta-stagger">
                <MudItem xs="6" md="12">
                    <KpiCard Titulo="Entradas" Valor="@EntradasFlujo.ToString()" Icono="@Icons.Material.Filled.MoveToInbox" Acento="azul"
                             Sparkline="@SparkAperturas" Nota="tickets recibidos" />
                </MudItem>
                <MudItem xs="6" md="12">
                    <KpiCard Titulo="Cierres" Valor="@CierresFlujo.ToString()" Icono="@Icons.Material.Filled.TaskAlt" Acento="cumplido"
                             Sparkline="@SparkCierres" Nota="@($"tasa de cierre {Formato.Porcentaje(CierresFlujo, EntradasFlujo)}")" />
                </MudItem>
                <MudItem xs="12">
                    <KpiCard Titulo="Balance neto" Valor="@($"{(CierresFlujo - EntradasFlujo >= 0 ? "+" : "")}{CierresFlujo - EntradasFlujo}")"
                             Icono="@Icons.Material.Filled.Balance" Acento="@(CierresFlujo >= EntradasFlujo ? "cumplido" : "riesgo")"
                             Nota="@(CierresFlujo >= EntradasFlujo ? "el represamiento baja" : "el represamiento sube")" />
                </MudItem>
            </MudGrid>
        </MudItem>
    </MudGrid>

    @* ================= 4. EQUIPO ================= *@
    <SeccionBloque Id="b-equipo" Titulo="Equipo" Icono="@Icons.Material.Filled.Groups"
                   Bajada="Carga y ritmo de cada analista del grupo">
        <Acciones>
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward" Href="/analistas">Ver analistas</MudButton>
        </Acciones>
    </SeccionBloque>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="7">
            <ChartPanel Titulo="Recibidos contra cerrados" Icono="@Icons.Material.Filled.BarChart" Vacio="@(!_porAnalista.Any())"
                        MensajeVacio="Sin asignaciones en el período." Clicable="true" Nota="Clic en un analista para abrir su detalle">
                <ApexChart TItem="PuntoAnalista" Options="_opcionesBarras" Height="320"
                           OnDataPointSelection="@((SelectedData<PuntoAnalista> e) => IrAAnalista(e.DataPoint?.Items?.FirstOrDefault()?.NombreCompleto))">
                    <ApexPointSeries TItem="PuntoAnalista" Items="_porAnalista" Name="Recibidos"
                                     XValue="@(p => p.Analista)" YValue="@(p => p.Recibidos)" SeriesType="SeriesType.Bar" />
                    <ApexPointSeries TItem="PuntoAnalista" Items="_porAnalista" Name="Cerrados"
                                     XValue="@(p => p.Analista)" YValue="@(p => p.Cerrados)" SeriesType="SeriesType.Bar" />
                </ApexChart>
            </ChartPanel>
        </MudItem>
        <MudItem xs="12" md="5">
            <div class="panel ta-alto-total">
                <div class="panel-cab">
                    <div>
                        <h2 class="panel-titulo"><MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Small" Color="Color.Primary" /> Backlog por analista</h2>
                        <div class="panel-sub">Tickets abiertos ahora · clic para ver su cola</div>
                    </div>
                </div>
                <BarList Items="_backlog" Color="var(--bsc-azul)" OnSeleccionar="@(i => IrAAnalista(i.Clave))"
                         MensajeVacio="Sin tickets abiertos asignados." />
            </div>
        </MudItem>
    </MudGrid>

    @* ================= 5. CATEGORÍAS ================= *@
    <SeccionBloque Id="b-categorias" Titulo="Categorías" Icono="@Icons.Material.Filled.Category"
                   Bajada="Reparto del volumen y estado de cada categoría del alcance" />

    <MudGrid Spacing="3">
        <MudItem xs="12" md="5">
            <ChartPanel Titulo="Reparto por categoría" Icono="@Icons.Material.Filled.DonutLarge" Vacio="@(!_porCategoria.Any())"
                        Clicable="true" Nota="Clic en una porción para ver sus estados">
                <ApexChart TItem="PuntoCategoria" Options="_opcionesDona" Height="320"
                           OnDataPointSelection="@((SelectedData<PuntoCategoria> e) => SeleccionarCategoria(e.DataPoint?.X?.ToString()))">
                    <ApexPointSeries TItem="PuntoCategoria" Items="_porCategoria" Name="Tickets"
                                     XValue="@(p => p.Categoria)" YAggregate="@(g => g.Sum(p => p.Total))"
                                     SeriesType="SeriesType.Donut" />
                </ApexChart>
            </ChartPanel>
        </MudItem>
        <MudItem xs="12" md="7">
            <div class="panel ta-alto-total">
                <div class="panel-cab">
                    <div>
                        <h2 class="panel-titulo">
                            <MudIcon Icon="@Icons.Material.Filled.ListAlt" Size="Size.Small" Color="Color.Primary" />
                            @(_categoriaSel is null ? "Estados de todas las categorías" : $"Estados · {_categoriaSel}")
                        </h2>
                        <div class="panel-sub">@(_categoriaSel is null ? "Elige una categoría en la dona o en la lista para enfocarla" : "Distribución por estado de la categoría seleccionada")</div>
                    </div>
                    @if (_categoriaSel is not null)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Close" OnClick="@(() => SeleccionarCategoria(null))">Quitar</MudButton>
                    }
                </div>
                <div class="ta-pills mb-3">
                    @foreach (var c in _porCategoria)
                    {
                        <button type="button" class="@($"ta-pill {(_categoriaSel == c.Categoria ? "activa" : "")}")"
                                @onclick="@(() => SeleccionarCategoria(c.Categoria))">
                            @c.Categoria <span class="cnt">@c.Total</span>
                        </button>
                    }
                </div>
                <BarList Items="EstadosCategoria" Color="var(--dato-2)" MensajeVacio="Sin datos de estado." />
            </div>
        </MudItem>
    </MudGrid>

    @* ================= 6. ÓRDENES DE CAMBIO ================= *@
    <SeccionBloque Id="b-oc" Titulo="Órdenes de cambio" Icono="@Icons.Material.Filled.ChangeCircle"
                   Bajada="@($"Vencimientos de OC del año {DateTime.Today.Year} · clic para abrir el listado filtrado")">
        <Acciones>
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward" Href="/ordenes-cambio">Ver órdenes</MudButton>
        </Acciones>
    </SeccionBloque>

    <MudGrid Spacing="3" Class="ta-stagger">
        <MudItem xs="6" md="3">
            <KpiCard Titulo="OC vencidas" Valor="@_ocDash.Vencidas.ToString()" Icono="@Icons.Material.Filled.Error" Acento="vencido"
                     Nota="abiertas que pasaron su fecha" TextoAccion="Ver vencidas" OnClick="@(() => Nav.NavigateTo("/ordenes-cambio?vista=vencidas"))" />
        </MudItem>
        <MudItem xs="6" md="3">
            <KpiCard Titulo="Vencen en 7 días" Valor="@_ocDash.VencenProximos7.ToString()" Icono="@Icons.Material.Filled.Schedule" Acento="riesgo"
                     Nota="@($"{_ocDash.VencenEsteMes} vencen este mes")" TextoAccion="Ver próximas" OnClick="@(() => Nav.NavigateTo("/ordenes-cambio?vista=semana"))" />
        </MudItem>
        <MudItem xs="6" md="3">
            <KpiCard Titulo="OC abiertas" Valor="@_ocDash.Abiertas.ToString()" Icono="@Icons.Material.Filled.FolderOpen" Acento="azul"
                     Progreso="@_ocDash.PctCompletadas" Nota="@($"{_ocDash.PctCompletadas:0.#}% completadas")"
                     TextoAccion="Ver listado" OnClick="@(() => Nav.NavigateTo("/ordenes-cambio?vista=listado"))" />
        </MudItem>
        <MudItem xs="6" md="3">
            <KpiCard Titulo="OC sin analista" Valor="@_ocDash.SinAnalista.ToString()" Icono="@Icons.Material.Filled.PersonOff" Acento="neutro"
                     Nota="pendientes de asignar" TextoAccion="Ver sin analista" OnClick="@(() => Nav.NavigateTo("/ordenes-cambio?vista=sinanalista"))" />
        </MudItem>
    </MudGrid>

    @* ================= 7. CLASIFICACIÓN DE LA GESTIÓN ================= *@
    <SeccionBloque Id="b-gestion" Titulo="Clasificación de la gestión" Icono="@Icons.Material.Filled.Insights"
                   Bajada="Qué tipo de trabajos realizamos y dónde se presentan · clic para ver los tickets" />

    <MudGrid Spacing="3">
        <MudItem xs="6" lg="3">
            <KpiCard Titulo="Casos gestionados" Valor="@_ind.TotalGestionados.ToString()" Icono="@Icons.Material.Filled.Assignment" Acento="azul"
                     Nota="con gestión registrada en el período" TextoAccion="Ver seguimiento" OnClick="@(() => Nav.NavigateTo("/seguimiento"))" />
        </MudItem>
        <MudItem xs="6" lg="3">
            <KpiCard Titulo="Reportados a proveedor" Valor="@_ind.ReportadosProveedor.ToString()" Icono="@Icons.Material.Filled.Business" Acento="azul"
                     Nota="@($"{_ind.NoRequierenProveedor} resueltos internamente")" TextoAccion="Ver proveedores" OnClick="@(() => Nav.NavigateTo("/proveedores"))" />
        </MudItem>
        <MudItem xs="6" lg="3">
            <KpiCard Titulo="Con causa raíz" Valor="@_ind.ConCausaRaiz.ToString()" Icono="@Icons.Material.Filled.Troubleshoot" Acento="cumplido"
                     Progreso="@Pct(_ind.ConCausaRaiz, _ind.ConCausaRaiz + _ind.SinCausaRaiz)"
                     Nota="@($"{_ind.SinCausaRaiz} sin identificar")" />
        </MudItem>
        <MudItem xs="6" lg="3">
            <KpiCard Titulo="Reportados al VP" Valor="@_ind.ReportadosVP.ToString()" Icono="@Icons.Material.Filled.Summarize" Acento="violeta"
                     Nota="@($"{_ind.ConJira} con JIRA")" TextoAccion="Ver reporte" OnClick="@(() => Nav.NavigateTo("/reporte-vp"))" />
        </MudItem>

        <MudItem xs="12" lg="6">
            <ChartPanel Titulo="Tickets por sistema" Icono="@Icons.Material.Filled.Dns" Subtitulo="Sistemas con mayor cantidad de incidencias">
                <BarList Items="@ItemsClasificacion(_ind.PorSistema)" Color="var(--dato-1)"
                         OnSeleccionar="@(i => Nav.NavigateTo($"/tickets?vista=todos&sistema={i.Clave}"))"
                         MensajeVacio="Todavía no hay casos clasificados por sistema." />
            </ChartPanel>
        </MudItem>
        <MudItem xs="12" lg="6">
            <ChartPanel Titulo="Tipos de solución más utilizados" Icono="@Icons.Material.Filled.Build" Subtitulo="Qué trabajos realizamos con mayor frecuencia">
                <BarList Items="@ItemsClasificacion(_ind.PorTipoSolucion)" Color="var(--dato-2)"
                         OnSeleccionar="@(i => Nav.NavigateTo($"/tickets?vista=todos&tiposolucion={i.Clave}"))"
                         MensajeVacio="Todavía no hay casos clasificados por tipo de solución." />
            </ChartPanel>
        </MudItem>
        @if (_ind.PorTipoActualizacionDatos.Any())
        {
            <MudItem xs="12">
                <ChartPanel Titulo="@($"Actualizaciones de datos · {_ind.TotalActualizacionesDatos} casos")" Icono="@Icons.Material.Filled.ManageAccounts"
                            Subtitulo="Desglose por tipo (BSC en Línea)">
                    <BarList Items="@ItemsClasificacion(_ind.PorTipoActualizacionDatos)" Color="var(--dato-3)" />
                </ChartPanel>
            </MudItem>
        }
    </MudGrid>
    </div>
}

@code {
    private static readonly (string Id, string Texto)[] Bloques =
    {
        ("b-estado", "Estado"), ("b-riesgo", "Riesgo"), ("b-flujo", "Flujo"), ("b-equipo", "Equipo"),
        ("b-categorias", "Categorías"), ("b-oc", "Órdenes de cambio"), ("b-gestion", "Gestión")
    };

    private TicketFiltro _filtro = new();
    private bool _cargando = true;
    private bool _cargadoAlgunaVez;
    private string? _error;
    private DateTime? _ultimaCarga;
    private int _version;
    private string _granularidad = "mes";

    private IndicadoresGestionDto _ind = new();
    private ResumenSlaDto? _resumenSla;
    private List<SlaTicketDto> _proximos = new();
    private List<VolumenPorEstadoDto> _volumen = new();
    private List<PuntoFlujo> _flujo = new();
    private List<PuntoCategoria> _porCategoria = new();
    private List<PuntoAnalista> _porAnalista = new();
    private List<BarList.Item> _backlog = new();
    private List<StackedBar100.Fila> _slaCategorias = new();
    private OrdenCambioDashboardDto _ocDash = new();
    private string? _categoriaSel;

    private int _totalTickets, _totalAbiertos, _totalCerrados, _totalConOc, _totalCritico;
    private int _slaVencidos, _slaRiesgo, _slaEnCurso, _slaCumplidos;
    private decimal _pctSla;

    private ApexChart<PuntoFlujo>? _chartFlujo;
    private readonly ApexChartOptions<PuntoFlujo> _opcionesFlujo = ChartTheme.Area<PuntoFlujo>(new() { ChartTheme.Azul, ChartTheme.Verde });
    private readonly ApexChartOptions<PuntoCategoria> _opcionesDona = ChartTheme.Dona<PuntoCategoria>(null, "Tickets");
    private readonly ApexChartOptions<PuntoAnalista> _opcionesBarras = ChartTheme.Barras<PuntoAnalista>(new() { ChartTheme.Azul, ChartTheme.Verde }, horizontal: true);

    public class PuntoFlujo { public string Periodo { get; set; } = ""; public decimal Abiertos { get; set; } public decimal Cerrados { get; set; } }
    public class PuntoCategoria { public string Categoria { get; set; } = ""; public decimal Total { get; set; } }
    public class PuntoAnalista { public string Analista { get; set; } = ""; public string NombreCompleto { get; set; } = ""; public decimal Recibidos { get; set; } public decimal Cerrados { get; set; } }

    private int EntradasFlujo => (int)_flujo.Sum(f => f.Abiertos);
    private int CierresFlujo => (int)_flujo.Sum(f => f.Cerrados);
    private List<double>? SparkAperturas => _flujo.Count > 1 ? _flujo.Select(f => (double)f.Abiertos).ToList() : null;
    private List<double>? SparkCierres => _flujo.Count > 1 ? _flujo.Select(f => (double)f.Cerrados).ToList() : null;

    private static double Pct(int parte, int total) => total <= 0 ? 0 : Math.Round(parte * 100.0 / total, 1);

    protected override async Task OnInitializedAsync() => await CargarTodo();

    private async Task CargarTodo()
    {
        _cargando = true;
        _error = null;
        StateHasChanged();
        try
        {
            // Todas las consultas en paralelo; un solo render al final.
            var tVolumen = Api.VolumenAsync(_filtro);
            var tSla = Api.SlaResumenAsync(_filtro);
            var tSlaCat = Api.SlaCategoriaAsync(_filtro);
            var tProximos = Api.SlaProximosAVencerAsync(_filtro);
            var tCruce = Api.CruceOcAsync(_filtro);
            var tMetricas = Api.MetricasAnalistaAsync(_filtro);
            var tTendencias = Api.TendenciasAsync(_filtro, _granularidad);
            var tOcDash = Api.OcDashboardAsync(new OrdenCambioFiltro { AnioVencimiento = DateTime.Today.Year });
            var tInd = Api.IndicadoresGestionAsync(_filtro.FechaDesde, _filtro.FechaHasta);
            await Task.WhenAll(tVolumen, tSla, tSlaCat, tProximos, tCruce, tMetricas, tTendencias, tOcDash, tInd);

            _ind = tInd.Result;
            _volumen = tVolumen.Result;
            _resumenSla = tSla.Result;
            _proximos = tProximos.Result.OrderBy(p => p.HorasRestantes ?? double.MaxValue).ToList();
            _ocDash = tOcDash.Result;
            var cruce = tCruce.Result;
            var metricas = tMetricas.Result;

            _totalTickets = _volumen.Sum(v => v.Total);
            _totalAbiertos = _volumen.Sum(v => v.Abiertos);
            _totalCerrados = _volumen.Sum(v => v.Cerrados);
            _totalConOc = cruce.Sum(c => c.ReqConCambio);
            _totalCritico = cruce.Sum(c => c.ReqCerradoCambioPendiente);

            _slaVencidos = _resumenSla.Vencidos;
            _slaRiesgo = _resumenSla.ProximosAVencer;
            _slaEnCurso = Math.Max(0, _resumenSla.EnCurso - _slaRiesgo);
            _slaCumplidos = _resumenSla.DentroSla;
            _pctSla = _resumenSla.PctCumplimiento;

            _slaCategorias = tSlaCat.Result
                .Where(c => c.TotalTickets > 0)
                .OrderByDescending(c => c.TotalTickets)
                .Select(c => new StackedBar100.Fila(c.Categoria, Formato.CategoriaCorta(c.Categoria), new()
                {
                    new("Dentro de SLA", c.SlaCumplido, "var(--op-cumplido)"),
                    new("En curso", c.SlaEnCurso, "var(--op-curso)"),
                    new("Fuera de SLA", c.SlaIncumplido, "var(--op-vencido)")
                })).ToList();

            _porCategoria = _volumen.GroupBy(v => Formato.CategoriaCorta(v.Categoria))
                .Select(g => new PuntoCategoria { Categoria = g.Key, Total = g.Sum(x => x.Total) })
                .Where(p => p.Total > 0).OrderByDescending(p => p.Total).ToList();
            if (_categoriaSel is not null && _porCategoria.All(c => c.Categoria != _categoriaSel)) _categoriaSel = null;

            _porAnalista = metricas.OrderByDescending(m => m.TotalRecibidos).Take(8)
                .Select(m => new PuntoAnalista
                {
                    Analista = Formato.NombreCorto(m.Analista),
                    NombreCompleto = m.Analista,
                    Recibidos = m.TotalRecibidos,
                    Cerrados = m.TotalCerrados
                }).ToList();

            _backlog = metricas.Where(m => m.TotalActivos > 0).OrderByDescending(m => m.TotalActivos)
                .Select(m => new BarList.Item(m.Analista, Formato.NombreCorto(m.Analista), m.TotalActivos,
                                              Formato.ColorAvatar(m.Analista), $"{m.TotalRecibidos} recibidos"))
                .ToList();

            _flujo = AgruparFlujo(tTendencias.Result);
            _ultimaCarga = DateTime.Now;
            _cargadoAlgunaVez = true;
            _version++;
        }
        catch (ApiException ex) { _error = ex.MensajeUsuario; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _cargando = false; StateHasChanged(); }
    }

    private static List<PuntoFlujo> AgruparFlujo(List<TendenciaDto> t)
        => t.GroupBy(x => x.Periodo).OrderBy(g => g.Key)
            .Select(g => new PuntoFlujo { Periodo = g.Key, Abiertos = g.Sum(x => x.Abiertos), Cerrados = g.Sum(x => x.Cerrados) })
            .ToList();

    private async Task OnGranularidadChanged(string valor)
    {
        _granularidad = valor;
        try
        {
            _flujo = AgruparFlujo(await Api.TendenciasAsync(_filtro, _granularidad));
            StateHasChanged();
            if (_chartFlujo is not null) await _chartFlujo.UpdateSeriesAsync(true);
        }
        catch (ApiException ex) { Snackbar.Add(ex.MensajeUsuario, Severity.Error); }
    }

    private void SeleccionarCategoria(string? categoria)
        => _categoriaSel = string.IsNullOrWhiteSpace(categoria) || _categoriaSel == categoria ? null : categoria;

    private List<BarList.Item> EstadosCategoria
        => _volumen.Where(v => _categoriaSel is null || Formato.CategoriaCorta(v.Categoria) == _categoriaSel)
                   .GroupBy(v => string.IsNullOrWhiteSpace(v.Estado) ? "Sin estado" : v.Estado)
                   .Select(g => new BarList.Item(g.Key, g.Key, g.Sum(x => x.Total)))
                   .Where(i => i.Valor > 0)
                   .OrderByDescending(i => i.Valor).ToList();

    private static List<BarList.Item> ItemsClasificacion(List<ConteoClasificacionDto> l)
        => l.Select(x => new BarList.Item(x.Valor.ToString(), x.Nombre, x.Cantidad)).ToList();

    private void IrAAnalista(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return;
        Nav.NavigateTo(UrlQuery.Url("/analistas", ("analista", nombre)));
    }

    private async Task AbrirTicket(string refNum)
    {
        try
        {
            var t = await Api.ObtenerTicketAsync(refNum);
            if (t is null) { Snackbar.Add($"No encontramos el ticket {refNum}.", Severity.Warning); return; }
            await DialogService.ShowAsync<TicketDetalleDialog>($"Ticket {refNum}", new DialogParameters { ["Ticket"] = t },
                new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        }
        catch (Exception) { Snackbar.Add($"No pudimos abrir el ticket {refNum}.", Severity.Error); }
    }
}

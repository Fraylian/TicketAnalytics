@page "/proveedores"
@inject TicketAnalyticsApi Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject FileDownloadService Descargas

<PageTitle>Proveedores · TicketAnalytics</PageTitle>

<div class="d-flex justify-space-between align-center mb-2 flex-wrap gap-2">
    <div>
        <h1 class="seccion-titulo">Matriz de proveedores</h1>
        <p class="seccion-bajada">Casos reportados a proveedores por mes calendario, con control de SLA</p>
    </div>
    <div class="d-flex gap-2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AbrirReporte(null))">Registrar reporte</MudButton>
    </div>
</div>

<!-- ===== Selector de mes + filtros ===== -->
<MudPaper Class="pa-3 mb-3" Elevation="0" Style="border:1px solid var(--bsc-borde);border-radius:12px;">
    <MudGrid Spacing="2" AlignItems="Center">
        <MudItem xs="6" md="2">
            <MudSelect T="int" Value="_mes" ValueChanged="OnMesChanged" Label="Mes" Variant="Variant.Outlined" Margin="Margin.Dense">
                @for (int m = 1; m <= 12; m++)
                {
                    var mm = m;
                    <MudSelectItem T="int" Value="@mm">@NombreMes(mm)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" md="2">
            <MudSelect T="int" Value="_anio" ValueChanged="OnAnioChanged" Label="Año" Variant="Variant.Outlined" Margin="Margin.Dense">
                @for (int a = DateTime.Today.Year - 2; a <= DateTime.Today.Year + 1; a++)
                {
                    var aa = a;
                    <MudSelectItem T="int" Value="@aa">@aa</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudSelect T="int?" Value="_filtro.ProveedorId" ValueChanged="OnProveedorChanged" Label="Proveedor" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var p in _proveedores)
                {
                    <MudSelectItem T="int?" Value="@p.ProveedorId">@p.Nombre</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudSelect T="string" Value="_filtro.ResponsableInterno" ValueChanged="OnResponsableChanged" Label="Responsable" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var r in _grupo)
                {
                    <MudSelectItem T="string" Value="@r">@r</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="2" Class="d-flex gap-1">
            <MudButton Variant="Variant.Filled" Color="Color.Success"
                                   StartIcon="@(_exportando ? null : Icons.Material.Filled.TableView)"
                                   OnClick="ExportarExcel" Disabled="_exportando" FullWidth="true">
                            @if (_exportando)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>Generando…</span>
                            }
                            else
                            {
                                <span>Excel</span>
                            }
                        </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_cargando)
{
    <MudGrid Spacing="3">
        @for (var i = 0; i < 4; i++) { <MudItem xs="6" md="3"><MudSkeleton Height="110px" /></MudItem> }
        <MudItem xs="12"><MudSkeleton Height="360px" /></MudItem>
    </MudGrid>
}
else
{
    <!-- ===== KPIs ===== -->
    <MudGrid Spacing="3" Class="mb-3">
        <MudItem xs="6" md="2"><KpiCard Titulo="Reportes del mes" Valor="@_resumen.TotalReportes.ToString()" Icono="@Icons.Material.Filled.Assignment" Acento="azul" Nota="@($"{_resumen.Abiertos} abiertos")" /></MudItem>
        <MudItem xs="6" md="2"><KpiCard Titulo="SLA cumplido" Valor="@_resumen.SlaCumplidos.ToString()" Icono="@Icons.Material.Filled.CheckCircle" Acento="cumplido" Nota="@($"{_resumen.PctCumplimientoSla:0.#}%")" /></MudItem>
        <MudItem xs="6" md="2"><KpiCard Titulo="SLA incumplido" Valor="@_resumen.SlaIncumplidos.ToString()" Icono="@Icons.Material.Filled.Error" Acento="vencido" OnClick="ToggleIncumplidos" /></MudItem>
        <MudItem xs="6" md="2"><KpiCard Titulo="Sin evaluar" Valor="@_resumen.SlaSinEvaluar.ToString()" Icono="@Icons.Material.Filled.HelpOutline" Acento="riesgo" /></MudItem>
        <MudItem xs="6" md="2"><KpiCard Titulo="Con asistencia" Valor="@_resumen.ConAsistencia.ToString()" Icono="@Icons.Material.Filled.Support" Acento="cumplido" /></MudItem>
        <MudItem xs="6" md="2"><KpiCard Titulo="Cerrados" Valor="@_resumen.Cerrados.ToString()" Icono="@Icons.Material.Filled.TaskAlt" Acento="neutro" /></MudItem>
    </MudGrid>

    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-4" @bind-ActivePanelIndex="_tab">

        <!-- ===== Matriz de control ===== -->
        <MudTabPanel Text="Matriz de control" Icon="@Icons.Material.Filled.GridView">
            <div class="panel mb-3">
                <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-2">
                    <div>
                        <MudText Typo="Typo.overline" Style="color:var(--texto-secundario)">PERÍODO</MudText>
                        <MudText Typo="Typo.h6">@NombreMes(_mes).ToUpper() @_anio</MudText>
                    </div>
                    <div>
                        <MudText Typo="Typo.overline" Style="color:var(--texto-secundario)">PROVEEDOR</MudText>
                        <MudText Typo="Typo.h6">@(_proveedores.FirstOrDefault(p => p.ProveedorId == _filtro.ProveedorId)?.Nombre ?? "Todos")</MudText>
                    </div>
                    <div class="text-center">
                        <MudText Typo="Typo.overline" Style="color:var(--texto-secundario)">CUMPLIMIENTO</MudText>
                        <MudText Typo="Typo.h4" Style="@($"color:{(_resumen.PctCumplimientoSla >= 90 ? "var(--op-cumplido)" : _resumen.PctCumplimientoSla >= 70 ? "var(--op-riesgo)" : "var(--op-vencido)")};font-weight:700")">@($"{_resumen.PctCumplimientoSla:0}%")</MudText>
                    </div>
                </div>

                <MudSimpleTable Dense="true" Hover="true" Elevation="0" Style="background:transparent">
                    <thead>
                        <tr style="background:var(--bsc-azul)">
                            <th style="color:#fff">Severidad</th>
                            <th style="color:#fff">SLA</th>
                            <th style="color:#fff;text-align:center">Cantidad soportes</th>
                            <th style="color:#fff;text-align:center">Resueltos dentro del SLA</th>
                            <th style="color:#fff;text-align:center">Resultado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fila in _resumen.Control)
                        {
                            <tr>
                                <td><b>@fila.Severidad</b></td>
                                <td>@fila.SlaTexto</td>
                                <td style="text-align:center">@(fila.CantidadSoportes == 0 ? "—" : fila.CantidadSoportes.ToString())</td>
                                <td style="text-align:center">@(fila.CantidadSoportes == 0 ? "—" : fila.ResueltosDentroSla.ToString())</td>
                                <td style="text-align:center">
                                    @if (fila.CantidadSoportes > 0)
                                    {
                                        <MudChip T="string" Size="Size.Small" Style="@($"background:{(fila.PctCumplimiento >= 90 ? "var(--op-cumplido)" : fila.PctCumplimiento >= 70 ? "var(--op-riesgo)" : "var(--op-vencido)")};color:#fff")">@($"{fila.PctCumplimiento:0}%")</MudChip>
                                    }
                                    else { <span style="color:var(--texto-tenue)">—</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>

            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    <ChartPanel Titulo="Reportes por proveedor" Icono="@Icons.Material.Filled.Business" Vacio="@(!_resumen.PorProveedor.Any())">
                        <ApexChart TItem="ConteoProveedor" Options="@_optBarras" Height="260">
                            <ApexPointSeries TItem="ConteoProveedor" Items="_resumen.PorProveedor" Name="Reportes" XValue="@(x => x.Etiqueta)" YValue="@(x => (decimal)x.Cantidad)" SeriesType="SeriesType.Bar" />
                        </ApexChart>
                    </ChartPanel>
                </MudItem>
                <MudItem xs="12" md="6">
                    <ChartPanel Titulo="Reportes por responsable" Icono="@Icons.Material.Filled.Groups" Vacio="@(!_resumen.PorResponsable.Any())">
                        <ApexChart TItem="ConteoProveedor" Options="@_optBarrasV" Height="260">
                            <ApexPointSeries TItem="ConteoProveedor" Items="_resumen.PorResponsable" Name="Reportes" XValue="@(x => Acortar(x.Etiqueta))" YValue="@(x => (decimal)x.Cantidad)" SeriesType="SeriesType.Bar" />
                        </ApexChart>
                    </ChartPanel>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <!-- ===== Detalles ===== -->
        <MudTabPanel Text="Detalles" Icon="@Icons.Material.Filled.List">
            <div class="panel">
                <div class="d-flex justify-space-between align-center mb-2 flex-wrap gap-2">
                    <h2 class="panel-titulo mb-0"><MudIcon Icon="@Icons.Material.Filled.GridOn" Size="Size.Small" Color="Color.Primary" /> Casos de @NombreMes(_mes) @_anio</h2>
                    <MudTextField @bind-Value="_filtro.Texto" Placeholder="Buscar título, caso…" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="max-width:300px"
                                  OnKeyUp="@(async e => { if (e.Key == "Enter") await Recargar(); })" />
                </div>

                @if (!_reportes.Any())
                {
                    <EmptyState Icono="@Icons.Material.Filled.Inbox" Mensaje="@($"Sin reportes en {NombreMes(_mes)} {_anio}.")" TextoAccion="Registrar reporte" OnAccion="@(() => AbrirReporte(null))" />
                }
                else
                {
                    <MudTable Items="_reportes" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.Md">
                        <HeaderContent>
                            <MudTh>Ticket sist.</MudTh><MudTh>Caso prov.</MudTh><MudTh>Título</MudTh><MudTh>Proveedor</MudTh><MudTh>Responsable</MudTh>
                            <MudTh>Fecha</MudTh><MudTh>Sever.</MudTh><MudTh>SLA ref.</MudTh><MudTh>Cumplió</MudTh><MudTh>Asist.</MudTh><MudTh>Estado</MudTh><MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Ticket sist.">@(string.IsNullOrEmpty(context.RefNumSistema) ? "—" : context.RefNumSistema)</MudTd>
                            <MudTd DataLabel="Caso prov.">@(context.NumeroCasoExterno ?? "—")</MudTd>
                            <MudTd DataLabel="Título" Style="max-width:200px"><MudTooltip Text="@context.Descripcion">@context.Titulo</MudTooltip></MudTd>
                            <MudTd DataLabel="Proveedor">@context.Proveedor</MudTd>
                            <MudTd DataLabel="Responsable">@(context.ResponsableInterno ?? "—")</MudTd>
                            <MudTd DataLabel="Fecha">@context.FechaReporte.ToString("dd/MM/yyyy")</MudTd>
                            <MudTd DataLabel="Sever."><MudChip T="string" Size="Size.Small" Color="@SevColor(context.Urgencia)" Variant="Variant.Text">@context.Urgencia</MudChip></MudTd>
                            <MudTd DataLabel="SLA ref.">@SlaRefTexto(context.SlaReferenciaHoras)</MudTd>
                            <MudTd DataLabel="Cumplió">
                                @if (context.CumplioSla == true) { <MudChip T="string" Size="Size.Small" Style="background:var(--op-cumplido);color:#fff">Sí</MudChip> }
                                else if (context.CumplioSla == false) { <MudChip T="string" Size="Size.Small" Style="background:var(--op-vencido);color:#fff">No</MudChip> }
                                else { <span style="color:var(--texto-tenue)">—</span> }
                            </MudTd>
                            <MudTd DataLabel="Asist.">
                                @if (context.BrindoAsistencia == true) { <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" /> }
                                else if (context.BrindoAsistencia == false) { <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small" /> }
                                else { <span>—</span> }
                            </MudTd>
                            <MudTd DataLabel="Estado"><MudChip T="string" Size="Size.Small" Variant="Variant.Text">@context.EstadoTexto</MudChip></MudTd>
                            <MudTd>
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true">
                                    <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(() => AbrirReporte(context))">Editar</MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="@(() => Eliminar(context))">Eliminar</MudMenuItem>
                                </MudMenu>
                            </MudTd>
                        </RowTemplate>
                        <PagerContent><MudTablePager PageSizeOptions="new[]{25,50,100}" /></PagerContent>
                    </MudTable>
                }
            </div>
        </MudTabPanel>

        <!-- ===== Catálogo de proveedores ===== -->
        <MudTabPanel Text="Catálogo y SLA" Icon="@Icons.Material.Filled.Business">
            <div class="panel">
                <div class="d-flex justify-space-between align-center mb-2">
                    <h2 class="panel-titulo mb-0"><MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" Color="Color.Primary" /> Proveedores y su SLA</h2>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AbrirProveedor(null))">Nuevo proveedor</MudButton>
                </div>
                <MudTable Items="_proveedores" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.Md">
                    <HeaderContent>
                        <MudTh>Proveedor</MudTh><MudTh>Contacto</MudTh><MudTh>Email</MudTh><MudTh>Teléfono</MudTh>
                        <MudTh>Crítico</MudTh><MudTh>Alto</MudTh><MudTh>Medio</MudTh><MudTh>Bajo</MudTh><MudTh>Activo</MudTh><MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Proveedor"><b>@context.Nombre</b></MudTd>
                        <MudTd DataLabel="Contacto">@(context.Contacto ?? "—")</MudTd>
                        <MudTd DataLabel="Email">@(context.Email ?? "—")</MudTd>
                        <MudTd DataLabel="Teléfono">@(context.Telefono ?? "—")</MudTd>
                        <MudTd DataLabel="Crítico">@SlaRefTexto(context.SlaCriticoHoras)</MudTd>
                        <MudTd DataLabel="Alto">@SlaRefTexto(context.SlaAltoHoras)</MudTd>
                        <MudTd DataLabel="Medio">@SlaRefTexto(context.SlaMedioHoras)</MudTd>
                        <MudTd DataLabel="Bajo">@SlaRefTexto(context.SlaBajoHoras)</MudTd>
                        <MudTd DataLabel="Activo">
                            @if (context.Activo) { <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" /> }
                            else { <MudIcon Icon="@Icons.Material.Filled.Block" Color="Color.Error" Size="Size.Small" /> }
                        </MudTd>
                        <MudTd>
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true">
                                <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(() => AbrirProveedor(context))">Editar</MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="@(() => EliminarProveedor(context))">Eliminar</MudMenuItem>
                            </MudMenu>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        </MudTabPanel>
    </MudTabs>
}

@code {
    private int _tab;
    private bool _cargando = true;
    private int _mes = DateTime.Today.Month;
    private int _anio = DateTime.Today.Year;
    private ReporteProveedorFiltro _filtro = new() { Mes = DateTime.Today.Month, Anio = DateTime.Today.Year };

    private List<ReporteProveedorMatrizDto> _reportes = new();
    private MatrizProveedorResumenDto _resumen = new();
    private List<ProveedorCatalogoDto> _proveedores = new();
    private List<string> _grupo = new();

    private ApexChartOptions<ConteoProveedor> _optBarras = new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false } },
        Colors = new() { "#15528E" },
        PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { Horizontal = true } },
        DataLabels = new ApexCharts.DataLabels { Enabled = false }
    };
    private ApexChartOptions<ConteoProveedor> _optBarrasV = new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false } },
        Colors = new() { "#76B82A" },
        DataLabels = new ApexCharts.DataLabels { Enabled = false }
    };

    private bool _debeRenderizar = true;
    protected override bool ShouldRender()
    {
        if (_debeRenderizar) { _debeRenderizar = false; return true; }
        return false;
    }
    private void Render() { _debeRenderizar = true; StateHasChanged(); }

    protected override async Task OnInitializedAsync()
    {
        _proveedores = await Api.CatalogoProveedoresAsync();
        _grupo = await Api.GrupoAnalistasAsync();
        await Recargar();
    }

    private string NombreMes(int m) => new System.Globalization.CultureInfo("es-DO").DateTimeFormat.GetMonthName(m);

    private async Task Recargar()
    {
        _cargando = true; Render();
        try
        {
            _filtro.Mes = _mes; _filtro.Anio = _anio;
            var tRep = Api.MatrizBuscarAsync(_filtro);
            var tRes = Api.MatrizResumenAsync(_filtro);
            await Task.WhenAll(tRep, tRes);
            _reportes = tRep.Result;
            _resumen = tRes.Result;
        }
        catch (Exception ex) { Snackbar.Add($"Error al cargar: {ex.Message}", Severity.Error); }
        finally { _cargando = false; Render(); }
    }

    private async Task OnMesChanged(int m) { _mes = m; await Recargar(); }
    private async Task OnAnioChanged(int a) { _anio = a; await Recargar(); }
    private async Task OnProveedorChanged(int? p) { _filtro.ProveedorId = p; await Recargar(); }
    private async Task OnResponsableChanged(string? r) { _filtro.ResponsableInterno = r; await Recargar(); }
    private async Task ToggleIncumplidos() { _filtro.SoloIncumplidosSla = _filtro.SoloIncumplidosSla == true ? null : true; _tab = 1; await Recargar(); }

    private async Task AbrirReporte(ReporteProveedorMatrizDto? existente)
    {
        var p = new DialogParameters
        {
            ["Proveedores"] = _proveedores,
            ["Responsables"] = _grupo,
            ["Existente"] = existente,
            ["Usuario"] = ""
        };
        var d = await DialogService.ShowAsync<ReporteProveedorDialog>(existente is null ? "Registrar reporte" : "Editar reporte", p,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var res = await d.Result;
        if (!res.Canceled) await Recargar();
    }

    private async Task AbrirProveedor(ProveedorCatalogoDto? existente)
    {
        var p = new DialogParameters { ["Existente"] = existente };
        var d = await DialogService.ShowAsync<ProveedorCatalogoDialog>(existente is null ? "Nuevo proveedor" : "Editar proveedor", p,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var res = await d.Result;
        if (!res.Canceled) { _proveedores = await Api.CatalogoProveedoresAsync(); Render(); }
    }

    private async Task Eliminar(ReporteProveedorMatrizDto r)
    {
        var ok = await DialogService.ShowMessageBox("Eliminar reporte", $"¿Eliminar el reporte de {r.Proveedor}?", yesText: "Eliminar", cancelText: "Cancelar");
        if (ok == true)
        {
            try { await Api.MatrizEliminarAsync(r.ReporteId); Snackbar.Add("Eliminado", Severity.Success); await Recargar(); }
            catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        }
    }

    private async Task EliminarProveedor(ProveedorCatalogoDto p)
    {
        var ok = await DialogService.ShowMessageBox("Eliminar proveedor", $"¿Eliminar {p.Nombre}? Si tiene reportes, se desactivará en vez de borrarse.", yesText: "Aceptar", cancelText: "Cancelar");
        if (ok == true)
        {
            try { await Api.CatalogoEliminarAsync(p.ProveedorId); _proveedores = await Api.CatalogoProveedoresAsync(); Render(); }
            catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        }
    }

    private bool _exportando;

    private async Task ExportarExcel()
    {
        if (_exportando) return;                       // anti doble clic
        if (!_reportes.Any()) { Snackbar.Add("No hay reportes para exportar", Severity.Info); return; }

        _exportando = true;
        try
        {
            // El backend genera el Excel respetando los filtros visibles.
            var bytes = await Api.MatrizExcelBytesAsync(_filtro);
            var nombre = $"Matriz_Cumplimiento_{Capitalizar(NombreMes(_mes))}_{_anio}.xlsx";
            await Descargas.DescargarExcelAsync(nombre, bytes);
            Snackbar.Add($"Excel generado con {_reportes.Count} casos", Severity.Success);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.MensajeUsuario, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("No pudimos generar el Excel. Intenta de nuevo.", Severity.Error);
        }
        finally { _exportando = false; }
    }

    private static string Capitalizar(string s) => string.IsNullOrEmpty(s) ? s : char.ToUpper(s[0]) + s[1..];

    private static string Acortar(string n) { var p = n.Split(' ', StringSplitOptions.RemoveEmptyEntries); return p.Length >= 2 ? $"{p[0]} {p[^1]}" : n; }
    private static Color SevColor(string s) => s?.ToLowerInvariant() switch { "critico" => Color.Error, "alto" => Color.Warning, "medio" => Color.Info, _ => Color.Default };
    private static string SlaRefTexto(int? horas)
    {
        if (!horas.HasValue) return "—";
        return horas.Value % 24 == 0 && horas.Value >= 24 ? $"{horas.Value / 24}D" : $"{horas.Value}h";
    }
}

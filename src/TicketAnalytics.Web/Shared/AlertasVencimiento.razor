@* Campana de alertas de vencimiento (barra superior).
   - Al cargar o recargar la aplicación muestra un aviso emergente con los tickets cuyo SLA
     vence en la próxima hora (ReglaAlertas.MinutosAntelacion).
   - Mientras la app sigue abierta, vuelve a consultar cada ReglaAlertas.IntervaloConsulta y avisa
     (snackbar + notificación del escritorio) cuando un ticket nuevo entra en esa ventana.
   - Solo lee la bandeja del equipo (API); no escribe nada. *@
@inject TicketAnalyticsApi Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject UiService Ui
@inject NavigationManager Nav
@implements IDisposable

<MudTooltip Text="@TextoTooltip">
    <MudBadge Content="@_proximos.Count" Color="Color.Error" Overlap="true" Visible="@(_proximos.Count > 0)" Class="mr-3">
        <MudIconButton Icon="@(_proximos.Count > 0 ? Icons.Material.Filled.NotificationsActive : Icons.Material.Filled.NotificationsNone)"
                       Color="Color.Inherit" Class="@(_proximos.Count > 0 ? "ta-campana" : "")"
                       aria-label="Alertas de vencimiento" OnClick="AbrirAviso" />
    </MudBadge>
</MudTooltip>

@code {
    private List<AlertaTicket> _proximos = new();
    private readonly HashSet<string> _avisados = new();
    private Timer? _timer;
    private bool _consultando;
    private bool _dialogoAbierto;

    private string TextoTooltip => _proximos.Count switch
    {
        0 => $"Sin tickets que venzan en los próximos {ReglaAlertas.MinutosAntelacion} min",
        1 => "1 ticket vence en la próxima hora",
        _ => $"{_proximos.Count} tickets vencen en la próxima hora"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // Pequeña espera para no competir con la carga inicial de la página.
        await Task.Delay(1200);
        await Revisar(esCargaInicial: true);
        _timer = new Timer(_ => InvokeAsync(() => Revisar(esCargaInicial: false)), null,
                           ReglaAlertas.IntervaloConsulta, ReglaAlertas.IntervaloConsulta);
    }

    private async Task Revisar(bool esCargaInicial)
    {
        if (_consultando) return;
        _consultando = true;
        try
        {
            var bandeja = await Api.BandejaAnalistasAsync(new TicketFiltro { FechaDesde = new DateTime(DateTime.Today.Year, 1, 1) });
            _proximos = ReglaAlertas.Proximos(bandeja);
            var nuevos = _proximos.Where(t => !_avisados.Contains(t.NoTicket)).ToList();
            foreach (var t in nuevos) _avisados.Add(t.NoTicket);
            StateHasChanged();

            if (esCargaInicial && _proximos.Count > 0)
            {
                await NotificarEscritorio(_proximos);
                await AbrirAviso();
            }
            else if (nuevos.Count > 0)
            {
                await NotificarEscritorio(nuevos);
                foreach (var t in nuevos)
                {
                    Snackbar.Add($"Ticket {t.NoTicket} ({Formato.NombreCorto(t.Analista)}) {t.TextoRestante}", Severity.Warning, cfg =>
                    {
                        cfg.Icon = Icons.Material.Filled.AlarmOn;
                        cfg.RequireInteraction = true;
                        cfg.Action = "Ver";
                        cfg.ActionColor = Color.Primary;
                        cfg.Onclick = _ => { Nav.NavigateTo($"/tickets?vista=todos&ticket={Uri.EscapeDataString(t.NoTicket)}"); return Task.CompletedTask; };
                    });
                }
            }
        }
        catch
        {
            // La alerta es un apoyo: si la API no responde, se reintenta en el próximo ciclo sin molestar.
        }
        finally { _consultando = false; }
    }

    private async Task NotificarEscritorio(List<AlertaTicket> tickets)
    {
        var primero = tickets[0];
        var titulo = tickets.Count == 1 ? $"Ticket {primero.NoTicket} a punto de vencer" : $"{tickets.Count} tickets a punto de vencer";
        var cuerpo = tickets.Count == 1
            ? $"{primero.Analista} · {primero.TextoRestante} (a las {primero.FechaVencimiento:HH:mm})"
            : string.Join(" · ", tickets.Take(4).Select(t => $"{t.NoTicket} {t.TextoRestante}"));
        await Ui.NotificarAsync(titulo, cuerpo, "ta-vencimientos");
    }

    private async Task AbrirAviso()
    {
        if (_dialogoAbierto) return;
        if (_proximos.Count == 0)
        {
            Snackbar.Add($"No hay tickets que venzan en los próximos {ReglaAlertas.MinutosAntelacion} minutos.", Severity.Success);
            return;
        }
        _dialogoAbierto = true;
        try
        {
            var d = await DialogService.ShowAsync<AlertaVencimientoDialog>("", new DialogParameters { ["Tickets"] = _proximos },
                new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
            await d.Result;
        }
        finally { _dialogoAbierto = false; }
    }

    public void Dispose() => _timer?.Dispose();
}

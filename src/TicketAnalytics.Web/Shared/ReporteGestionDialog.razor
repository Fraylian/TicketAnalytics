    private async Task Guardar() => await GuardarInterno();

    /// <summary>Guarda la gestión. Devuelve true solo si el backend la aceptó.</summary>
    private async Task<bool> GuardarInterno()
    {
        // Se puede registrar una gestión PARCIAL: basta con llenar una sección.
        // Estos avisos informan de datos incompletos, pero no bloquean el guardado.
        if (ProveedorYaRegistrado is null && _reportadoProveedor == 1 && _proveedorId == 0)
            Snackbar.Add("Marcaste que se reportó al proveedor, pero no seleccionaste cuál.", Severity.Info);
        if (AplicaTipoActualizacion && _tipoActualizacion == 0)
            Snackbar.Add("Falta el tipo de actualización de datos; podrás completarlo luego.", Severity.Info);

        // Cerrar exige clasificación: sin sistema ni solución el caso no cuenta en el dashboard.
        if (ClasificacionObligatoria && (_sistema == 0 || _tipoSolucion == 0))
        {
            Snackbar.Add("Para cerrar el caso indica el sistema y el tipo de solución (pestaña Clasificación).", Severity.Warning);
            _tab = 3;
            return false;
        }

        _guardando = true;
        try
        {
            // Una sola llamada atómica: seguimiento + clasificación + proveedor + JIRA + avance + VP.
            // Si algo falla, el backend revierte todo (nada queda a medias).
            var req = new GestionCasoRequest
            {
                RefNum = RefNum,
                TipoOrigen = EsOrdenCambio ? "chg" : "cr",
                TipoCaso = EsOrdenCambio ? "Orden de Cambio" : null,
                Usuario = _autor,
                TecnicoResponsable = _autor,
                NuevaEtapa = _nuevaEtapa,
                ProximosPasos = _proximosPasos,

                // Clasificación estructurada
                Sistema = _sistema,                     // 0 = sin sistema
                TipoCorreccionId = _tipoCorreccion,     // 0 = sin tipo de corrección
                TipoSolucion = _tipoSolucion > 0 ? _tipoSolucion : null,
                TipoActualizacionDatos = AplicaTipoActualizacion ? _tipoActualizacion : 0,
                AreaDestino = _areaDestino,
                CausaRaiz = _causaRaiz,
                TicketCausaRaiz = _ticketCausaRaiz,

                // Avance (el historial se conserva: cada gestión agrega una entrada)
                Comentarios = ConstruirResumen(),
                Avance = new AvanceGestionDto { Tipo = IndiceTipoAvance(_tipoAvance), Detalle = ConstruirResumen() },

                // Proveedor
                ReportadoProveedor = ProveedorYaRegistrado is not null ? 1 : _reportadoProveedor,
                FechaReporteProveedor = _fechaReporte,
                TicketProveedor = _casoExterno,
                // Si ya hay un reporte, no se manda otro: el backend además lo bloquea.
                Proveedor = ProveedorYaRegistrado is null && _reportadoProveedor == 1 && _proveedorId > 0
                    ? new ProveedorGestionDto
                      {
                          ProveedorId = _proveedorId,
                          NumeroCasoExterno = _casoExterno,
                          Titulo = _titulo,
                          Descripcion = _descripcionProblema,
                          ContextoEnviado = _descripcionProblema,
                          RespuestasRecibidas = _respuesta,
                          ResultadoSolucion = _donde,
                          Urgencia = _severidad,
                          Estado = _estadoProveedor,
                          CumplioSla = _cumplioSla,
                          FechaReporte = _fechaReporte ?? DateTime.Today,
                          ResponsableInterno = _autor
                      }
                    : null,

                // JIRA
                Jira = PuedeCapturarJira && !string.IsNullOrWhiteSpace(_claveJira)
                    ? new JiraGestionDto
                      {
                          ClaveJira = _claveJira!,
                          Titulo = _esParaPase ? $"[Pase a producción] {_tituloJira}" : _tituloJira,
                          Url = _urlJira
                      }
                    : null,

                // Reporte VP
                ReporteVP = new ReporteVPGestionDto
                {
                    Incluir = _vaReporteVP,
                    Periodo = _periodoVP,
                    CategoriaId = _categoriaVPId,
                    Estado = _estadoVP,
                    Nota = _notaVP
                }
            };

            var res = await Api.RegistrarGestionAsync(RefNum, req);

            var msg = YaTieneGestion ? "Seguimiento agregado al historial" : "Gestión registrada";
            Snackbar.Add(msg, Severity.Success);
            if (res?.Mensajes is { Count: > 0 })
                foreach (var m in res.Mensajes) Snackbar.Add(m, Severity.Info);

            MudDialog.Close(DialogResult.Ok(true));
            return true;
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.MensajeUsuario, Severity.Error);
            _guardando = false;
            return false;
        }
        catch (Exception)
        {
            Snackbar.Add("No pudimos guardar la gestión. Intenta de nuevo.", Severity.Error);
            _guardando = false;
            return false;
        }
    }

    /// <summary>
    /// Guarda la gestión con el caso incluido en el Reporte VP, llevando el contexto completo
    /// (ticket, sistema, categoría, asignatario, gestión, solución, JIRA, causa raíz) en la nota,
    /// y navega al reporte. Si el guardado falla, se queda en el formulario para corregir.
    /// </summary>
    private async Task GuardarYRegistrarVP()
    {
        _vaReporteVP = true;                 // el caso va al reporte
        if (_estadoVP == 0 && _tipoSolucion == 4) _estadoVP = 4;   // "Solucionado" => Completado
        if (string.IsNullOrWhiteSpace(_notaVP)) await RellenarNotaVP();
        if (await GuardarInterno())
            Nav.NavigateTo($"/reporte-vp?periodo={_periodoVP}", forceLoad: false);
    }

    /// <summary>Arma la nota ejecutiva del VP con todo el contexto disponible del caso.</summary>
    private async Task RellenarNotaVP()
    {
        _generandoNota = true;
        try
        {
            var t = Contexto;
            if (t is null && !EsOrdenCambio)
            {
                try { t = await Api.ObtenerTicketAsync(RefNum); } catch { /* seguimos con lo que hay */ }
            }

            var partes = new List<string>();
            var cabecera = EsOrdenCambio ? $"OC {RefNum}" : $"Ticket {RefNum}";
            if (!string.IsNullOrWhiteSpace(t?.Categoria)) cabecera += $" · {Formato.CategoriaCorta(t!.Categoria)}";
            partes.Add(cabecera + ".");

            var sistema = _sistemas.FirstOrDefault(x => x.Valor == _sistema)?.Nombre;
            if (_sistema > 0 && !string.IsNullOrWhiteSpace(sistema)) partes.Add($"Sistema: {sistema}.");
            var asignatario = t?.Asignatario ?? _seguimiento?.TecnicoResponsable ?? (string.IsNullOrWhiteSpace(_autor) ? null : _autor);
            if (!string.IsNullOrWhiteSpace(asignatario)) partes.Add($"Asignatario: {asignatario}.");

            var gestion = !string.IsNullOrWhiteSpace(_avance) ? _avance : _seguimiento?.ProximosPasos;
            if (!string.IsNullOrWhiteSpace(gestion)) partes.Add($"Gestión realizada: {gestion!.Trim().TrimEnd('.')}.");

            var solucion = _tiposSolucion.FirstOrDefault(x => x.Valor == _tipoSolucion)?.Nombre;
            if (_tipoSolucion > 0 && !string.IsNullOrWhiteSpace(solucion)) partes.Add($"Tipo de solución: {solucion}.");

            var jiras = JirasRegistrados.Select(j => j.ClaveJira).ToList();
            if (!string.IsNullOrWhiteSpace(_claveJira) && !jiras.Contains(_claveJira!)) jiras.Add(_claveJira!);
            if (jiras.Any()) partes.Add($"JIRA: {string.Join(", ", jiras)}.");

            if (ProveedorYaRegistrado is { } rp) partes.Add($"Reportado a {rp.Proveedor} ({rp.EstadoTexto.ToLowerInvariant()}).");
            else if (_reportadoProveedor == 1 && ProvSel is not null) partes.Add($"Reportado a {ProvSel.Nombre}.");

            if (!string.IsNullOrWhiteSpace(_causaRaiz)) partes.Add($"Causa raíz: {_causaRaiz!.Trim().TrimEnd('.')}.");
            if (!string.IsNullOrWhiteSpace(_proximosPasos)) partes.Add($"Próximos pasos: {_proximosPasos!.Trim().TrimEnd('.')}.");

            _notaVP = string.Join(" ", partes);
        }
        finally { _generandoNota = false; }
    }

    private static int IndiceTipoAvance(string tipo)
        => Array.IndexOf(TiposAvance, tipo) is var i && i >= 0 ? i : 0;

    private string ConstruirResumen()
    {
        var partes = new List<string>();
        if (!string.IsNullOrWhiteSpace(_avance)) partes.Add(_avance);
        if ((_reportadoProveedor == 1) && ProvSel is not null)
        {
            partes.Add($"Reportado a {ProvSel.Nombre}" + (string.IsNullOrWhiteSpace(_casoExterno) ? "" : $" (caso {_casoExterno})") + ".");
            if (!string.IsNullOrWhiteSpace(_respuesta)) partes.Add($"Respuesta: {_respuesta}");
            if (!string.IsNullOrWhiteSpace(_donde)) partes.Add($"Solución en: {_donde}");
        }
        if (!string.IsNullOrWhiteSpace(_claveJira))
            partes.Add($"JIRA {_claveJira}" + (_esParaPase ? " para pase a producción." : "."));
        return string.Join(" ", partes);
    }

    private void Cancelar() => MudDialog.Cancel();

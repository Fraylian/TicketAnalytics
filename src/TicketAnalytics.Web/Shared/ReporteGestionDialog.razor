@inject TicketAnalyticsApi Api
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<MudDialog>
    <DialogContent>
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-4" @bind-ActivePanelIndex="_tab">

            <!-- ===== PROVEEDOR ===== -->
            <MudTabPanel Text="Proveedor" Icon="@Icons.Material.Filled.Business">
                @if (ProveedorYaRegistrado is { } rp)
                {
                    @* Ya existe un reporte: se muestra la info y no se permite crear otro *@
                    <MudAlert Severity="Severity.Success" Class="mb-3" Icon="@Icons.Material.Filled.CheckCircle">
                        <MudText Typo="Typo.subtitle2"><b>Este caso ya fue reportado al proveedor</b></MudText>
                        <MudText Typo="Typo.body2" Class="mt-1">
                            <b>@rp.Proveedor</b>@(string.IsNullOrWhiteSpace(rp.NumeroCasoExterno) ? "" : $" · caso {rp.NumeroCasoExterno}")
                        </MudText>
                        @if (!string.IsNullOrWhiteSpace(rp.Titulo))
                        {
                            <MudText Typo="Typo.body2">@rp.Titulo</MudText>
                        }
                        <MudText Typo="Typo.body2" Class="mt-1">
                            Reportado el @rp.FechaReporte.ToString("dd/MM/yyyy") ·
                            estado <b>@rp.EstadoTexto</b> · severidad @rp.Urgencia
                        </MudText>
                        @if (!string.IsNullOrWhiteSpace(rp.ResultadoSolucion))
                        {
                            <MudText Typo="Typo.body2" Class="mt-1"><b>Solución:</b> @rp.ResultadoSolucion</MudText>
                        }
                    </MudAlert>
                    <MudText Typo="Typo.caption" Style="color:var(--texto-secundario)">
                        Para dar seguimiento a este reporte usa la pantalla de Proveedores.
                        Aquí puedes seguir registrando avances del caso.
                    </MudText>
                }
                else
                {
                <MudText Typo="Typo.body2" Class="mb-1">¿Se reportó al proveedor?</MudText>
                <div class="d-flex gap-2 mb-3 flex-wrap">
                    @foreach (var op in ReportadoProveedorOpciones.Todos)
                    {
                        <MudChip T="string" Size="Size.Medium"
                                 OnClick="@(() => OnReportadoProveedorChanged(op.Valor))"
                                 Style="@(_reportadoProveedor == op.Valor
                                          ? $"background:{ColorOpcionProveedor(op.Valor)};color:#fff;cursor:pointer;font-weight:600"
                                          : $"background:transparent;color:{ColorOpcionProveedor(op.Valor)};border:1px solid {ColorOpcionProveedor(op.Valor)};cursor:pointer")">
                            @op.Nombre
                        </MudChip>
                    }
                </div>

                @if (_reportadoProveedor == 2)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                        Queda marcado como pendiente de escalar. No se crea un reporte al proveedor todavía;
                        aparecerá en la bandeja de casos por escalar.
                    </MudAlert>
                }
                else if (_reportadoProveedor == 0)
                {
                    <MudAlert Severity="Severity.Normal" Dense="true" Class="mb-3">
                        El caso se resolvió internamente y no requiere proveedor.
                    </MudAlert>
                }

                @if (_reportadoProveedor == 1)
                {
                    <MudSelect T="int" Value="_proveedorId" ValueChanged="OnProveedorChanged" Label="Proveedor *" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                        @foreach (var p in Proveedores)
                        {
                            <MudSelectItem T="int" Value="@p.ProveedorId">@p.Nombre</MudSelectItem>
                        }
                    </MudSelect>

                    <MudTextField @bind-Value="_casoExterno" Label="No. de caso del proveedor" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" Class="mb-3"
                                  HelperText="Ticket que abrió el proveedor, o el correo al que se envió" />

                    <MudTextField @bind-Value="_titulo" Label="Título del caso *" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

                    <MudDatePicker @bind-Date="_fechaReporte" Label="Fecha del reporte" DateFormat="dd/MM/yyyy"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

                    <MudGrid Spacing="2" Class="mb-1">
                        <MudItem xs="12" md="6">
                            <MudSelect T="string" Value="_severidad" ValueChanged="OnSeveridadChanged" Label="Severidad" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var s in SlaProveedorCatalogo.Severidades)
                                {
                                    <MudSelectItem T="string" Value="@s">@s</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="6" Class="d-flex align-center">
                            <MudAlert Severity="Severity.Info" Dense="true" Class="py-1" Style="width:100%">SLA ref.: <b>@SlaReferenciaTexto</b></MudAlert>
                        </MudItem>
                    </MudGrid>

                    <MudTextField @bind-Value="_descripcionProblema" Label="Descripción del problema" Variant="Variant.Outlined"
                                  Lines="3" Margin="Margin.Dense" Class="mb-3" />

                    <MudTextField @bind-Value="_respuesta" Label="Respuesta del proveedor" Variant="Variant.Outlined"
                                  Lines="2" Margin="Margin.Dense" Class="mb-3" />

                    <MudDatePicker @bind-Date="_fechaResp" Label="Fecha primera respuesta del proveedor" DateFormat="dd/MM/yyyy"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-3" HelperText="@HorasRespuestaTexto" />

                    <MudSelect T="int" @bind-Value="_estadoProveedor" Label="Estado del reporte al proveedor"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                               HelperText="Ciclo de vida del reporte con el proveedor">
                        @foreach (var e in EstadosReporteProveedor.Todos)
                        {
                            <MudSelectItem T="int" Value="@e.Valor">@e.Nombre</MudSelectItem>
                        }
                    </MudSelect>

                    <MudTextField @bind-Value="_donde" Label="Dónde se encuentra la solución" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" Class="mb-3" HelperText="Ruta, ambiente, repositorio o documento" />

                    <div class="pa-2" style="background:rgba(21,82,142,.04);border-radius:8px">
                        <MudText Typo="Typo.caption" Style="color:var(--texto-secundario)">Evaluación</MudText>
                        <div class="d-flex flex-wrap gap-3 mt-1">
                            <MudCheckBox T="bool" Value="@(_brindoAsistencia == true)" ValueChanged="@((bool v) => _brindoAsistencia = v)" Label="Brindó asistencia" Color="Color.Success" />
                            <MudCheckBox T="bool" Value="@(_entregoCambio == true)" ValueChanged="@((bool v) => _entregoCambio = v)" Label="Entregó cambio" Color="Color.Success" />
                            <MudCheckBox T="bool" Value="@(_cumplioSla == true)" ValueChanged="@((bool v) => _cumplioSla = v)" Label="¿Cumplió el SLA?" Color="Color.Primary" />
                        </div>
                    </div>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        El caso se resolvió internamente. No se creará un reporte de proveedor. Registra el detalle en la pestaña Avance.
                    </MudAlert>
                }
                }
            </MudTabPanel>

            <!-- ===== JIRA ===== -->
            <MudTabPanel Text="JIRA" Icon="@Icons.Material.Filled.BugReport">
                @if (JirasRegistrados.Any())
                {
                    @* Ya hay JIRA vinculado: se muestra y no se permite duplicar *@
                    <MudAlert Severity="Severity.Success" Class="mb-3" Icon="@Icons.Material.Filled.CheckCircle">
                        <MudText Typo="Typo.subtitle2"><b>Este caso ya tiene JIRA vinculado</b></MudText>
                        @foreach (var j in JirasRegistrados)
                        {
                            <MudText Typo="Typo.body2" Class="mt-1">
                                <b>@j.ClaveJira</b>@(string.IsNullOrWhiteSpace(j.Titulo) ? "" : $" · {j.Titulo}")
                                — @j.EstadoTexto, vinculado el @j.VinculadoEn.ToString("dd/MM/yyyy")
                            </MudText>
                            @if (!string.IsNullOrWhiteSpace(j.Url))
                            {
                                <MudLink Href="@j.Url" Target="_blank" Typo="Typo.body2">Abrir en JIRA</MudLink>
                            }
                        }
                    </MudAlert>

                    <MudSwitch T="bool" @bind-Value="_agregarOtroJira" Color="Color.Primary"
                               Label="Vincular otro JIRA a este caso" Class="mb-2" />
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="mb-1">¿Este caso tiene JIRA?</MudText>
                    <div class="d-flex gap-2 mb-3">
                        <MudChip T="string" Size="Size.Medium" OnClick="@(() => _tieneJira = true)"
                                 Style="@(_tieneJira
                                          ? "background:#2E7D32;color:#fff;cursor:pointer;font-weight:600"
                                          : "background:transparent;color:#2E7D32;border:1px solid #2E7D32;cursor:pointer")">
                            Sí
                        </MudChip>
                        <MudChip T="string" Size="Size.Medium" OnClick="@(() => _tieneJira = false)"
                                 Style="@(!_tieneJira
                                          ? "background:#667085;color:#fff;cursor:pointer;font-weight:600"
                                          : "background:transparent;color:#667085;border:1px solid #667085;cursor:pointer")">
                            No / todavía no
                        </MudChip>
                    </div>
                    @if (!_tieneJira)
                    {
                        <MudAlert Severity="Severity.Normal" Dense="true">
                            El caso queda sin JIRA. Puedes vincularlo más adelante desde esta misma pantalla.
                        </MudAlert>
                    }
                }

                @if (PuedeCapturarJira)
                {
                    <MudTextField @bind-Value="_claveJira" Label="No. de JIRA" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Class="mb-3" HelperText="Ej. BSC-1234" />
                    <MudTextField @bind-Value="_tituloJira" Label="Título" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                    <MudTextField @bind-Value="_urlJira" Label="Enlace" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                    <MudCheckBox T="bool" @bind-Value="_esParaPase" Label="Creado para pase a producción" Color="Color.Primary" />
                }
            </MudTabPanel>

            <!-- ===== AVANCE ===== -->
            <MudTabPanel Text="Avance" Icon="@Icons.Material.Filled.Timeline">
                <MudSelect T="string" @bind-Value="_tipoAvance" Label="Tipo" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                    @foreach (var t in TiposAvance)
                    {
                        <MudSelectItem T="string" Value="@t">@t</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="_avance" Label="Qué se hizo con el caso" Variant="Variant.Outlined"
                              Lines="4" Margin="Margin.Dense" Class="mb-3" />
                <MudSelect T="int" @bind-Value="_nuevaEtapa" Label="Estatus actual" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                    @foreach (var e in EtapasSeguimiento.Todas)
                    {
                        <MudSelectItem T="int" Value="@e.Id">@e.Texto</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="_proximosPasos" Label="Próximos pasos" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudTabPanel>

            <!-- ===== CLASIFICACIÓN (datos estructurados para medir) ===== -->
            <MudTabPanel Text="Clasificación" Icon="@Icons.Material.Filled.Category">
                @* El sistema es el eje: al elegir proveedor se filtran sus sistemas; al elegir sistema el proveedor sale solo. *@
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="5">
                        <MudSelect T="int?" Value="_proveedorFiltro" ValueChanged="OnProveedorFiltroChanged" Label="Proveedor"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                                   HelperText="Opcional: filtra los sistemas de ese proveedor">
                            @foreach (var p in _proveedoresCat)
                            {
                                <MudSelectItem T="int?" Value="@((int?)p.Valor)">@p.Nombre</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="7">
                        <MudSelect T="int" Value="_sistema" ValueChanged="OnSistemaChanged" Label="@(ClasificacionObligatoria ? "Sistema donde se presentó *" : "Sistema donde se presentó")"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Error="@(ClasificacionObligatoria && _sistema == 0)"
                                   HelperText="@TextoProveedorSistema">
                            <MudSelectItem T="int" Value="0">— Sin sistema —</MudSelectItem>
                            @foreach (var s in SistemasFiltrados)
                            {
                                <MudSelectItem T="int" Value="@s.Valor">@s.Nombre@(s.Proveedor is null ? "" : $" · {s.Proveedor}")</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>
                <div class="mb-3"></div>

                <MudSelect T="int" Value="_tipoSolucion" ValueChanged="OnTipoSolucionChanged" Label="@(ClasificacionObligatoria ? "Tipo de solución *" : "Tipo de solución")"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Error="@(ClasificacionObligatoria && _tipoSolucion == 0)">
                    @foreach (var t in _tiposSolucion)
                    {
                        <MudSelectItem T="int" Value="@t.Valor">@t.Nombre</MudSelectItem>
                    }
                </MudSelect>

                @* Caso especial: sistemas que exigen subtipo (BSC en Línea) + Actualización de datos *@
                @if (AplicaTipoActualizacion)
                {
                    <MudSelect T="int" @bind-Value="_tipoActualizacion" Label="Tipo de actualización de datos *"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                               HelperText="Necesario para medir cuántos casos hay de cada tipo">
                        @foreach (var t in _tiposActualizacion)
                        {
                            <MudSelectItem T="int" Value="@t.Valor">@t.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                }

                <MudSelect T="int" @bind-Value="_tipoCorreccion" Label="Tipo de corrección" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                           HelperText="@(_tiposCorreccion.Any() ? "Catálogo propio, distinto del tipo de solución" : "Aún no hay tipos definidos: agrégalos en Proveedores · Tipos de corrección")"
                           Disabled="@(!_tiposCorreccion.Any())">
                    <MudSelectItem T="int" Value="0">— Sin tipo de corrección —</MudSelectItem>
                    @foreach (var t in _tiposCorreccion)
                    {
                        <MudSelectItem T="int" Value="@t.Valor">@t.Nombre</MudSelectItem>
                    }
                </MudSelect>

                <MudTextField @bind-Value="_areaDestino" Label="Área destino" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Class="mb-3"
                              HelperText="Área responsable o involucrada" />

                <MudDivider Class="my-3" />

                <MudTextField @bind-Value="_causaRaiz" Label="Causa raíz" Variant="Variant.Outlined"
                              Lines="2" Margin="Margin.Dense" Class="mb-3"
                              HelperText="Motivo identificado del incidente" />

                <MudTextField @bind-Value="_ticketCausaRaiz" Label="Ticket de causa raíz" Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              HelperText="Ticket asociado a la corrección definitiva" />

                @* Contexto al clasificar: cómo se reparten hoy los casos por sistema y por solución. *@
                @if (_distribucion is { TotalGestionados: > 0 })
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Cómo se distribuyen los casos</MudText>
                    <MudText Typo="Typo.caption" Class="ta-tenue d-block mb-2">@_distribucion.TotalGestionados casos gestionados · para clasificar con criterio común</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.caption"><b>Por sistema</b></MudText>
                            <BarList Items="@ItemsDistribucion(_distribucion.PorSistema, porSolucion: false)" MaxVisibles="5" Seleccionado="@_sistema.ToString()"
                                     MensajeVacio="Sin casos con sistema." />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.caption"><b>Por tipo de solución</b></MudText>
                            <BarList Items="@ItemsDistribucion(_distribucion.PorTipoSolucion, porSolucion: true)" MaxVisibles="5" Seleccionado="@_tipoSolucion.ToString()"
                                     MensajeVacio="Sin casos con solución." />
                        </MudItem>
                    </MudGrid>
                }
            </MudTabPanel>

            <!-- ===== REPORTE VP ===== -->
            <MudTabPanel Text="Reporte VP" Icon="@Icons.Material.Filled.Summarize">
                @if (_yaEstabaEnVP)
                {
                    <MudAlert Severity="Severity.Info" Class="mb-3" Icon="@Icons.Material.Filled.Summarize">
                        <MudText Typo="Typo.subtitle2"><b>Este caso ya está en el reporte del VP</b></MudText>
                        <MudText Typo="Typo.body2" Class="mt-1">
                            Período @TextoPeriodo(_periodoVP) · estado <b>@EstadosVP.Nombre(_estadoVP)</b>.
                            Puedes actualizar la información; no se creará un registro nuevo.
                        </MudText>
                    </MudAlert>
                }

                <MudSwitch T="bool" Value="_vaReporteVP" ValueChanged="OnVaVPChanged" Color="Color.Primary"
                           Label="Incluir en el reporte mensual del VP" Class="mb-3" />

                @if (_vaReporteVP)
                {
                    <MudSelect T="string" @bind-Value="_periodoVP" Label="Período" Variant="Variant.Outlined"
                               Margin="Margin.Dense" Class="mb-3">
                        @foreach (var per in PeriodosVP())
                        {
                            <MudSelectItem T="string" Value="@per">@TextoPeriodo(per)</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="int?" @bind-Value="_categoriaVPId" Label="Categoría del reporte"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Clearable="true">
                        @foreach (var cat in _categoriasVP)
                        {
                            <MudSelectItem T="int?" Value="@((int?)cat.CategoriaId)">@cat.Nombre</MudSelectItem>
                        }
                    </MudSelect>

                    <MudText Typo="Typo.caption" Style="color:var(--texto-secundario)">Estado ejecutivo</MudText>
                    <div class="d-flex gap-1 flex-wrap mt-1 mb-3">
                        @foreach (var e in EstadosVP.Todos)
                        {
                            <MudChip T="string" Size="Size.Small" OnClick="@(() => _estadoVP = e.Valor)"
                                     Style="@(_estadoVP == e.Valor
                                              ? $"background:{e.Color};color:#fff;cursor:pointer;font-weight:600"
                                              : $"background:transparent;color:{e.Color};border:1px solid {e.Color};cursor:pointer")">
                                @e.Nombre
                            </MudChip>
                        }
                    </div>

                    <div class="d-flex justify-space-between align-center mb-1">
                        <MudText Typo="Typo.caption" Style="color:var(--texto-secundario)">Nota ejecutiva</MudText>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.AutoFixHigh" OnClick="RellenarNotaVP" Disabled="_generandoNota">
                            @(_generandoNota ? "Armando…" : "Completar con el contexto del caso")
                        </MudButton>
                    </div>
                    <MudTextField @bind-Value="_notaVP" Variant="Variant.Outlined"
                                  Lines="5" Margin="Margin.Dense" Immediate="true"
                                  HelperText="Es el texto que se lee en la reunión con el VP. Se arma con ticket, sistema, categoría, asignatario, gestión, tipo de solución, JIRA y causa raíz." />

                    @* Previsualización de cómo se verá en el reporte *@
                    <MudText Typo="Typo.caption" Class="mt-3" Style="color:var(--texto-secundario)">
                        Así se verá en el reporte
                    </MudText>
                    <div class="ta-cat-bloque mt-1">
                        <div class="ta-caso" style="border-top:none">
                            <div class="d-flex align-center gap-2 flex-wrap">
                                <span class="ta-caso-ref">@RefNum</span>
                                <MudChip T="string" Size="Size.Small"
                                         Style="@($"background:{EstadosVP.Color(_estadoVP)};color:#fff")">
                                    @EstadosVP.Nombre(_estadoVP)
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@NombreCategoriaVP()</MudChip>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_notaVP))
                            {
                                <div class="ta-caso-nota"><b>Nota:</b> @_notaVP</div>
                            }
                        </div>
                    </div>
                }
            </MudTabPanel>
        </MudTabs>

        <MudDivider Class="my-3" />
        <MudSelect T="string" @bind-Value="_autor" Label="Tu nombre *" Variant="Variant.Outlined" Margin="Margin.Dense"
                   AdornmentIcon="@Icons.Material.Filled.Person" Required="true">
            @foreach (var g in Grupo)
            {
                <MudSelectItem T="string" Value="@g">@g</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Secondary" Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Summarize" OnClick="GuardarYRegistrarVP"
                   Disabled="@(string.IsNullOrWhiteSpace(_autor) || _guardando)">
            Registrar al VP
        </MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Guardar"
                   Disabled="@(string.IsNullOrWhiteSpace(_autor) || _guardando)">
            @(_guardando ? "Guardando…" : (YaTieneGestion ? "Agregar seguimiento" : "Guardar gestión"))
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string RefNum { get; set; } = default!;
    [Parameter] public bool EsOrdenCambio { get; set; }
    [Parameter] public string? OrdenCambioRef { get; set; }

    /// <summary>Pestaña inicial: 0 Proveedor, 1 JIRA, 2 Avance, 3 Clasificación, 4 Reporte VP.</summary>
    [Parameter] public int TabInicial { get; set; }
    /// <summary>Si es true, el caso se marca para el reporte del VP al abrir (acción rápida "Agregar al VP").</summary>
    [Parameter] public bool IncluirEnVP { get; set; }
    /// <summary>Datos del ticket desde MDB (si ya se tienen) para armar la nota del VP sin otra consulta.</summary>
    [Parameter] public TicketEnriquecidoDto? Contexto { get; set; }

    private int _tab;
    private bool _generandoNota;

    [Parameter] public List<ProveedorCatalogoDto> Proveedores { get; set; } = new();
    [Parameter] public List<string> Grupo { get; set; } = new();

    // ===== Clasificación estructurada =====
    private int _sistema;
    private int _tipoSolucion;
    private int _tipoActualizacion;
    private int _tipoCorreccion;
    private int? _proveedorFiltro;
    private string? _areaDestino;
    private string? _causaRaiz;
    private string? _ticketCausaRaiz;

    private List<SistemaOpcion> _sistemas = new();
    private List<OpcionCatalogo> _proveedoresCat = new();
    private List<OpcionCatalogo> _tiposSolucion = new();
    private List<OpcionCatalogo> _tiposActualizacion = new();
    private List<OpcionCatalogo> _tiposCorreccion = new();
    private IndicadoresGestionDto? _distribucion;

    private SistemaOpcion? SistemaSel => _sistemas.FirstOrDefault(s => s.Valor == _sistema);

    /// <summary>Sistemas del proveedor elegido (o todos si no hay filtro).</summary>
    private IEnumerable<SistemaOpcion> SistemasFiltrados
        => _proveedorFiltro is null ? _sistemas : _sistemas.Where(s => s.ProveedorId == _proveedorFiltro || s.Valor == _sistema);

    private string TextoProveedorSistema => SistemaSel is null
        ? "Elige el sistema; el proveedor responsable se completa solo"
        : SistemaSel.Proveedor is null ? "Proveedor responsable: por asignar" : $"Proveedor responsable: {SistemaSel.Proveedor}";

    /// <summary>Etapa Cerrado (12): para cerrar, el caso debe quedar clasificado (sistema y tipo de solución).</summary>
    private bool ClasificacionObligatoria => _nuevaEtapa == 12;

    // ===== Reporte VP =====
    private bool _vaReporteVP;
    private string _periodoVP = $"{DateTime.Today:yyyy-MM}";
    private int? _categoriaVPId;
    private int _estadoVP;
    private string? _notaVP;
    private List<CategoriaVPDto> _categoriasVP = new();
    private bool _yaEstabaEnVP;


    private bool _agregarOtroJira;

    /// <summary>Reporte a proveedor ya existente, si lo hay.</summary>
    private ReporteProveedorResumenDto? ProveedorYaRegistrado => _seguimiento?.ReportesProveedor.FirstOrDefault();

    /// <summary>JIRAs ya vinculados al caso.</summary>
    private List<JiraResumenDto> JirasRegistrados => _seguimiento?.Jiras ?? new();

    /// <summary>Solo se capturan datos de JIRA si el usuario dijo que tiene y no está bloqueado.</summary>
    private bool PuedeCapturarJira => JirasRegistrados.Any() ? _agregarOtroJira : _tieneJira;

    /// <summary>Regla del punto 7: el subtipo solo aplica si el sistema lo exige (catálogo) y la solución es Actualización de datos.</summary>
    private bool AplicaTipoActualizacion => SistemaSel?.AplicaSubtipoActualizacion == true && _tipoSolucion == 1;

    protected override async Task OnInitializedAsync()
    {
        _tab = TabInicial;
        // Catálogos base del diálogo (proveedores y analistas del grupo)
        if (!Proveedores.Any())
        {
            try { Proveedores = await Api.CatalogoProveedoresAsync(); } catch { }
        }
        if (!Grupo.Any())
        {
            try { Grupo = await Api.GrupoAnalistasAsync(); } catch { }
        }

        try
        {
            var tCat = Api.CatalogosGestionAsync();
            var tVp = Api.ReporteVPCategoriasAsync();
            var tDist = Api.IndicadoresGestionAsync(null, null);
            await Task.WhenAll(tCat, tVp);
            var cat = tCat.Result;
            _sistemas = cat.Sistemas;
            _proveedoresCat = cat.Proveedores;
            _tiposSolucion = cat.TiposSolucion;
            _tiposActualizacion = cat.TiposActualizacion;
            _tiposCorreccion = cat.TiposCorreccion;
            _categoriasVP = tVp.Result;
            try { _distribucion = await tDist; } catch { /* el gráfico es solo contexto */ }
        }
        catch
        {
            // Sin catálogos el formulario sigue usable; los selectores quedan vacíos.
        }

        // Si el caso ya tiene gestión, precargamos lo que ya está registrado.
        try
        {
            var seg = await Api.ObtenerSeguimientoAsync(RefNum);
            if (seg is not null)
            {
                _seguimiento = seg;
                YaTieneGestion = true;
                _yaEstabaEnVP = seg.VaReporteVP;
                _reportadoProveedor = seg.ReportadoProveedor;
                _sistema = seg.Sistema;
                _proveedorFiltro = seg.ProveedorSistemaId;
                _tipoCorreccion = seg.TipoCorreccionId;
                _tipoSolucion = seg.TipoSolucion;
                _tipoActualizacion = seg.TipoActualizacionDatos;
                _areaDestino = seg.AreaDestino;
                _causaRaiz = seg.CausaRaiz;
                _ticketCausaRaiz = seg.TicketCausaRaiz;
                _vaReporteVP = seg.VaReporteVP;
                _categoriaVPId = seg.CategoriaReporteVPId;
                _estadoVP = seg.EstadoReporteVP;
                _notaVP = seg.NotaReporteVP;
                if (seg.PeriodoReporteVP is { } per) _periodoVP = $"{per.Year:0000}-{per.Month:00}";
                _tieneJira = seg.Jiras.Any();
                // Antes la etapa arrancaba siempre en 1 y cada gestión la devolvía a "Pendiente de análisis".
                if (seg.EtapaActual > 0) _nuevaEtapa = seg.EtapaActual;
                if (!string.IsNullOrWhiteSpace(seg.TecnicoResponsable) && Grupo.Contains(seg.TecnicoResponsable))
                    _autor = seg.TecnicoResponsable;
            }
        }
        catch { /* si falla, se trata como gestión nueva */ }

        if (IncluirEnVP && !_vaReporteVP)
        {
            _vaReporteVP = true;
            if (string.IsNullOrWhiteSpace(_notaVP)) await RellenarNotaVP();
        }
    }

    /// <summary>True si el caso ya tenía gestión: cambia el texto del botón.</summary>
    public bool YaTieneGestion { get; private set; }

    private void OnSistemaChanged(int v)
    {
        _sistema = v;
        // El proveedor sale del sistema: se refleja en el filtro y, si aún no se eligió uno
        // para el reporte, se propone en la pestaña Proveedor.
        if (SistemaSel?.ProveedorId is int prov)
        {
            _proveedorFiltro = prov;
            if (_proveedorId == 0 && Proveedores.Any(p => p.ProveedorId == prov)) _proveedorId = prov;
        }
        if (!AplicaTipoActualizacion) _tipoActualizacion = 0;   // limpia el subtipo si ya no aplica
        StateHasChanged();
    }

    private void OnProveedorFiltroChanged(int? v)
    {
        _proveedorFiltro = v;
        // Si el sistema elegido no es de ese proveedor, se limpia para no guardar una combinación incoherente.
        if (v is not null && SistemaSel is not null && SistemaSel.ProveedorId != v) _sistema = 0;
        if (!AplicaTipoActualizacion) _tipoActualizacion = 0;
        StateHasChanged();
    }

    private static List<BarList.Item> ItemsDistribucion(List<ConteoClasificacionDto> l, bool porSolucion)
        => l.Select(x => new BarList.Item(x.Valor.ToString(), x.Nombre, x.Cantidad,
                                          porSolucion ? SistemasSolucion.ColorSolucion(x.Valor) : x.Color)).ToList();

    private void OnTipoSolucionChanged(int v)
    {
        _tipoSolucion = v;
        if (!AplicaTipoActualizacion) _tipoActualizacion = 0;
        StateHasChanged();
    }

    private void OnVaVPChanged(bool v) { _vaReporteVP = v; StateHasChanged(); }

    private string NombreCategoriaVP()
        => _categoriasVP.FirstOrDefault(x => x.CategoriaId == _categoriaVPId)?.Nombre ?? "Sin categoría";

    private List<string> PeriodosVP()
    {
        var b = DateTime.TryParse($"{_periodoVP}-01", out var d) ? d : DateTime.Today;
        return Enumerable.Range(-3, 5).Select(i => b.AddMonths(i).ToString("yyyy-MM"))
                         .Distinct().OrderByDescending(x => x).ToList();
    }

    private static string TextoPeriodo(string per)
    {
        if (!DateTime.TryParse($"{per}-01", out var d)) return per;
        var cul = new System.Globalization.CultureInfo("es-DO");
        var m = cul.DateTimeFormat.GetMonthName(d.Month);
        return $"{char.ToUpper(m[0])}{m[1..]} {d.Year}";
    }


@* Panel de trabajo de un técnico: sus casos listados con las mismas columnas
   que la cola de CA Service Desk, con sub-filtros rápidos por vencimiento. *@
@inject TicketAnalyticsApi Api
@inject CatalogoCache Cache
@inject FileDownloadService Descargas
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudPaper Elevation="0" Class="pa-4 mt-3 ta-enter"
          Style="border:1px solid var(--bsc-borde);border-radius:var(--radius-md)">

    <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-3">
        <div>
            <MudText Typo="Typo.h6" Style="color:var(--texto-primario)">@Tecnico</MudText>
            <MudText Typo="Typo.caption" Style="color:var(--texto-secundario)">
                @(_cargando ? "Cargando casos…" : $"{_total} {(EsOrdenCambio ? "órdenes de cambio" : "tickets")} · vista: {EtiquetaVista()}")
            </MudText>
        </div>
        <div class="d-flex gap-1">
            <MudTooltip Text="Exportar esta vista a Excel (todas las filas)">
                <MudIconButton Icon="@(_exportando ? Icons.Material.Filled.HourglassTop : Icons.Material.Filled.TableView)" Size="Size.Small" Color="Color.Success"
                               aria-label="Exportar a Excel" OnClick="Exportar" Disabled="_cargando || _exportando || _total == 0" />
            </MudTooltip>
            <MudTooltip Text="Cerrar panel">
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                               aria-label="Cerrar" OnClick="OnCerrar" />
            </MudTooltip>
        </div>
    </div>

    @* Sub-filtros rápidos: mismas categorías del semáforo *@
    <div class="ta-pills mb-3">
        @foreach (var v in Vistas)
        {
            <button type="button" class="@($"ta-pill {(_vista == v.Clave ? "activa" : "")}")" style="@($"--pill:{v.Color}")"
                    @onclick="@(() => CambiarVista(v.Clave))">@v.Texto</button>
        }
    </div>

    @if (_cargando)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-3" />
    }
    else if (_error is not null)
    {
        <ErrorState Mensaje="@_error" OnReintentar="Cargar" />
    }
    else if (EsOrdenCambio && !_ocs.Any())
    {
        <EmptyState Mensaje="@($"No hay órdenes de cambio de {Tecnico} en esta vista.")" />
    }
    else if (!EsOrdenCambio && !_tickets.Any())
    {
        <EmptyState Mensaje="@($"No hay tickets de {Tecnico} en esta vista.")" />
    }
    else if (EsOrdenCambio)
    {
        <MudTable Items="_ocs" Dense="true" Hover="true" Elevation="0" Class="ta-tabla-sticky ta-tabla-click" T="OrdenCambioConTicketsDto"
                  OnRowClick="@((TableRowClickEventArgs<OrdenCambioConTicketsDto> a) => VerOc(a.Item!))"
                  Breakpoint="Breakpoint.Md" FixedHeader="true" Height="55vh">
            <HeaderContent>
                <MudTh>No. OC</MudTh>
                <MudTh>Resumen</MudTh>
                <MudTh>Categoría</MudTh>
                <MudTh>Estado</MudTh>
                <MudTh>Complejidad</MudTh>
                <MudTh>Apertura</MudTh>
                <MudTh>Vencimiento</MudTh>
                <MudTh>Situación</MudTh>
                <MudTh>Tickets</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="No. OC"><b>@context.NoOC</b></MudTd>
                <MudTd DataLabel="Resumen" Style="max-width:300px">
                    <MudTooltip Text="@(context.ResumenOC ?? "")">
                        <MudText Typo="Typo.body2" Style="white-space:normal">@Corto(context.ResumenOC, 80)</MudText>
                    </MudTooltip>
                </MudTd>
                <MudTd DataLabel="Categoría">@Corto(context.CategoriaOC, 40)</MudTd>
                <MudTd DataLabel="Estado">@(context.EstadoOC ?? "—")</MudTd>
                <MudTd DataLabel="Complejidad">@(context.ComplejidadOC ?? "—")</MudTd>
                <MudTd DataLabel="Apertura">@(context.FechaAperturaOC?.ToString("dd/MM/yyyy") ?? "—")</MudTd>
                <MudTd DataLabel="Vencimiento">@(context.FechaVencimientoOC?.ToString("dd/MM/yyyy") ?? "—")</MudTd>
                <MudTd DataLabel="Situación">
                    <EstadoVencimientoChip Estado="@context.EstadoVencimiento" DiasRestantes="context.DiasRestantes" />
                </MudTd>
                <MudTd DataLabel="Tickets">@context.CantidadTickets</MudTd>
            </RowTemplate>
        </MudTable>
        @Paginador
    }
    else
    {
        <MudTable Items="_tickets" Dense="true" Hover="true" Elevation="0" Class="ta-tabla-sticky ta-tabla-click" T="TicketEnriquecidoDto"
                  OnRowClick="@((TableRowClickEventArgs<TicketEnriquecidoDto> a) => VerTicket(a.Item!))"
                  Breakpoint="Breakpoint.Md" FixedHeader="true" Height="55vh">
            <HeaderContent>
                <MudTh>Solicitud núm.</MudTh>
                <MudTh>Resumen</MudTh>
                <MudTh>Categoría</MudTh>
                <MudTh>Estado</MudTh>
                <MudTh>Usuario final afectado</MudTh>
                <MudTh>Grupo</MudTh>
                <MudTh>Fecha de apertura</MudTh>
                <MudTh>Incumplimiento previsto</MudTh>
                <MudTh>Situación</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Solicitud núm."><b>@context.NoTicket</b></MudTd>
                <MudTd DataLabel="Resumen" Style="max-width:300px">
                    <MudTooltip Text="@(context.Descripcion ?? "")">
                        <MudText Typo="Typo.body2" Style="white-space:normal">@Corto(context.Descripcion, 80)</MudText>
                    </MudTooltip>
                </MudTd>
                <MudTd DataLabel="Categoría">@Corto(context.Categoria, 40)</MudTd>
                <MudTd DataLabel="Estado">@(context.Estado ?? "—")</MudTd>
                <MudTd DataLabel="Usuario final afectado">@(context.UsuarioFinalAfectado ?? "—")</MudTd>
                <MudTd DataLabel="Grupo">@(context.Grupo ?? "—")</MudTd>
                <MudTd DataLabel="Fecha de apertura">@(context.FechaApertura?.ToString("dd/MM/yyyy HH:mm") ?? "—")</MudTd>
                <MudTd DataLabel="Incumplimiento previsto">
                    @(context.FechaVencimiento?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                </MudTd>
                <MudTd DataLabel="Situación">
                    <EstadoVencimientoChip Estado="@context.EstadoVencimiento" DiasRestantes="context.DiasParaVencer" />
                </MudTd>
            </RowTemplate>
        </MudTable>
        @Paginador
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public string Tecnico { get; set; } = "";
    /// <summary>true = listado de órdenes de cambio; false = listado de tickets.</summary>
    [Parameter] public bool EsOrdenCambio { get; set; }
    /// <summary>Vista inicial: todas | vencidas | mes | pronto | abiertas.</summary>
    [Parameter] public string VistaInicial { get; set; } = "todas";
    /// <summary>Mes/año de vencimiento a considerar en la vista "mes".</summary>
    [Parameter] public int? Mes { get; set; }
    [Parameter] public int? Anio { get; set; }
    [Parameter] public EventCallback OnCerrar { get; set; }

    /// <summary>Filas por página: la página se pide al servidor (antes se traían hasta 500 de golpe).</summary>
    private const int TamPagina = 25;
    private int _pagina = 1;
    private int Paginas => Math.Max(1, (int)Math.Ceiling(_total / (double)TamPagina));

    private RenderFragment Paginador => @<text>
        @if (_total > TamPagina)
        {
            <div class="d-flex justify-space-between align-center flex-wrap gap-2 mt-2">
                <MudText Typo="Typo.caption" Class="ta-muted">@($"{(_pagina - 1) * TamPagina + 1}–{Math.Min(_pagina * TamPagina, _total)} de {_total}") · el Excel incluye todas las filas</MudText>
                <MudPagination Count="Paginas" Selected="_pagina" SelectedChanged="IrAPagina" Size="Size.Small" Color="Color.Primary" BoundaryCount="1" MiddleCount="3" />
            </div>
        }
    </text>;

    private List<OrdenCambioConTicketsDto> _ocs = new();
    private List<TicketEnriquecidoDto> _tickets = new();
    private int _total;
    private bool _cargando = true;
    private string? _error;
    private string _vista = "todas";
    private string? _tecnicoCargado;

    public record VistaRapida(string Clave, string Texto, string Color);

    public static readonly VistaRapida[] Vistas =
    {
        new("todas",    "Todas",           "#15528E"),
        new("abiertas", "Abiertas",        "#1976D2"),
        new("vencidas", "Vencidas",        "#C62828"),
        new("mes",      "Vencen este mes", "#ED6C02"),
        new("pronto",   "Por vencer",      "#6B4EFF")
    };

    protected override async Task OnParametersSetAsync()
    {
        // Recargamos solo cuando cambia el técnico seleccionado.
        if (_tecnicoCargado == Tecnico) return;
        _tecnicoCargado = Tecnico;
        _vista = VistaInicial;
        _pagina = 1;
        await Cargar();
    }

    private async Task CambiarVista(string clave)
    {
        _vista = clave;
        _pagina = 1;
        await Cargar();
    }

    private async Task IrAPagina(int pagina)
    {
        _pagina = pagina;
        await Cargar();
    }

    private async Task Cargar()
    {
        _cargando = true;
        _error = null;
        StateHasChanged();
        try
        {
            if (EsOrdenCambio) await CargarOcAsync();
            else await CargarTicketsAsync();
        }
        catch (ApiException ex) { _error = ex.MensajeUsuario; }
        catch (Exception) { _error = "No pudimos cargar los casos de este técnico."; }
        finally { _cargando = false; StateHasChanged(); }
    }

    private async Task CargarOcAsync()
    {
        var f = new OrdenCambioFiltro
        {
            AsignatarioNombre = Tecnico,
            Page = _pagina,
            PageSize = TamPagina,
            OrderBy = "vencimiento"
        };
        // "Por vencer" usa OC.DiasVencePronto (parámetro), igual que el semáforo del backend.
        AplicarVistaOc(f, (await Cache.ParametrosAsync(Api)).OcDiasVencePronto);
        _ultimoFiltroOc = f;

        var r = await Api.BuscarOcAvanzadoAsync(f);
        _ocs = r.Items.ToList();
        _total = r.TotalCount;
    }

    private void AplicarVistaOc(OrdenCambioFiltro f, int diasVencePronto)
    {
        switch (_vista)
        {
            case "abiertas": f.SoloAbiertas = true; break;
            case "vencidas": f.Vencidas = true; break;
            case "mes":
                f.MesVencimiento = Mes ?? DateTime.Today.Month;
                f.AnioVencimiento = Anio ?? DateTime.Today.Year;
                break;
            case "pronto": f.VencenEnDias = diasVencePronto; break;
        }
    }

    private async Task CargarTicketsAsync()
    {
        var f = new TicketFiltro
        {
            AsignatarioNombre = Tecnico,
            Page = _pagina,
            PageSize = TamPagina,
            OrderBy = "fechaapertura",
            OrderDesc = true
        };
        switch (_vista)
        {
            case "abiertas": f.SoloAbiertos = true; break;
            case "vencidas": f.EstadoSla = "NO"; break;
            case "mes":
                var m = Mes ?? DateTime.Today.Month;
                var a = Anio ?? DateTime.Today.Year;
                f.FechaDesde = new DateTime(a, m, 1);
                f.FechaHasta = new DateTime(a, m, 1).AddMonths(1).AddDays(-1);
                break;
            // Abiertos que vencen hoy o en los próximos días (Ticket.DiasVencePronto); se filtra en el servidor.
            case "pronto": f.ProximoAVencer = true; break;
        }

        _ultimoFiltroTickets = f;
        var r = await Api.BuscarTicketsAsync(f);
        _tickets = r.Items.ToList();
        _total = r.TotalCount;
    }

    private string EtiquetaVista()
        => Vistas.FirstOrDefault(v => v.Clave == _vista)?.Texto ?? "Todas";

    private OrdenCambioFiltro? _ultimoFiltroOc;
    private TicketFiltro? _ultimoFiltroTickets;
    private bool _exportando;

    /// <summary>Excel real con TODAS las filas de la vista actual (mismo filtro que la tabla).</summary>
    private async Task Exportar()
    {
        if (_exportando) return;
        _exportando = true;
        try
        {
            var sufijo = $"{Tecnico.Replace(' ', '_')}_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";
            if (EsOrdenCambio && _ultimoFiltroOc is not null)
                await Descargas.DescargarExcelAsync($"OC_{sufijo}", await Api.OcExcelBytesAsync(_ultimoFiltroOc));
            else if (!EsOrdenCambio && _ultimoFiltroTickets is not null)
                await Descargas.DescargarExcelAsync($"Tickets_{sufijo}", await Api.TicketsExcelBytesAsync(_ultimoFiltroTickets));
            Snackbar.Add("Excel generado", Severity.Success);
        }
        catch (ApiException ex) { Snackbar.Add(ex.MensajeUsuario, Severity.Error); }
        catch (Exception) { Snackbar.Add("No pudimos generar el Excel.", Severity.Error); }
        finally { _exportando = false; }
    }

    private async Task VerTicket(TicketEnriquecidoDto t)
        => await DialogService.ShowAsync<TicketDetalleDialog>($"Ticket {t.NoTicket}", new DialogParameters { ["Ticket"] = t },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });

    private async Task VerOc(OrdenCambioConTicketsDto oc)
        => await DialogService.ShowAsync<OrdenCambioDetalleDialog>($"OC {oc.NoOC}", new DialogParameters { ["Orden"] = oc },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });

    private static string Corto(string? t, int max)
        => string.IsNullOrWhiteSpace(t) ? "—" : (t.Length > max ? t[..max] + "…" : t);
}

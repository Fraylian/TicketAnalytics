@* Chip visual del estado de vencimiento. Acepta los estados de OC (vencida, completada…)
   y los de ticket (vencido, cerrado…), que el backend nombra distinto. *@
<MudChip T="string" Size="@Size" Variant="Variant.Filled" Style="@($"background:{Fondo};color:#fff")">
    <MudIcon Icon="@Icono" Size="Size.Small" Class="mr-1" /> @Texto
</MudChip>

@code {
    [Parameter] public string Estado { get; set; } = "sin_fecha";
    [Parameter] public int? DiasRestantes { get; set; }
    [Parameter] public Size Size { get; set; } = Size.Small;

    private string Texto => Estado switch
    {
        "vencida" => DiasRestantes.HasValue ? $"Vencida ({Math.Abs(DiasRestantes.Value)}d)" : "Vencida",
        "vencido" => DiasRestantes.HasValue ? $"Vencido ({Math.Abs(DiasRestantes.Value)}d)" : "Vencido",
        "cerrado" => "Cerrado",
        "vence_hoy" => "Vence hoy",
        "vence_pronto" => DiasRestantes.HasValue ? $"Vence en {DiasRestantes}d" : "Vence pronto",
        "en_curso" => DiasRestantes.HasValue ? $"{DiasRestantes}d restantes" : "En curso",
        "completada" => "Completada",
        _ => "Sin fecha"
    };
    private string Fondo => Estado switch
    {
        "vencida" or "vencido" => "var(--op-vencido)",
        "cerrado" => "var(--op-cumplido)",
        "vence_hoy" => "var(--op-vencido)",
        "vence_pronto" => "var(--op-riesgo)",
        "en_curso" => "var(--op-curso)",
        "completada" => "var(--op-cumplido)",
        _ => "var(--texto-tenue)"
    };
    private string Icono => Estado switch
    {
        "vencida" or "vencido" => Icons.Material.Filled.Error,
        "cerrado" => Icons.Material.Filled.CheckCircle,
        "vence_hoy" => Icons.Material.Filled.Today,
        "vence_pronto" => Icons.Material.Filled.Schedule,
        "en_curso" => Icons.Material.Filled.HourglassBottom,
        "completada" => Icons.Material.Filled.CheckCircle,
        _ => Icons.Material.Filled.HelpOutline
    };
}

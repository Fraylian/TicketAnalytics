<MudItem xs="12" sm="6">
    <MudText Typo="Typo.caption" Class="mud-text-secondary">@Label</MudText>
    <MudText Typo="Typo.body2">@(string.IsNullOrWhiteSpace(Valor) ? "—" : Valor)</MudText>
</MudItem>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Valor { get; set; }
}

@* Detalle de una orden de cambio: estado de vencimiento, tiempo consumido, acciones
   rápidas y sus tickets relacionados (clic para abrir cada ticket). *@
@inject IDialogService DialogService
@inject TicketAnalyticsApi Api
@inject UiService Ui
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <div class="ta-detalle-cab mb-3">
            <MudIcon Icon="@Icons.Material.Filled.ChangeCircle" Color="Color.Secondary" />
            <span class="ref">@Orden.NoOC</span>
            <span class="ta-tag">@(Orden.EstadoOC ?? "Sin estado")</span>
            <MudSpacer />
            <EstadoVencimientoChip Estado="@Orden.EstadoVencimiento" DiasRestantes="@Orden.DiasRestantes" />
        </div>

        <div class="ta-acciones-rapidas mb-4">
            <button type="button" class="ta-accion" @onclick="AbrirGestion">
                <MudIcon Icon="@Icons.Material.Filled.EditNote" /> Registrar gestión
            </button>
            <button type="button" class="ta-accion" @onclick="VerTimeline">
                <MudIcon Icon="@Icons.Material.Filled.Timeline" /> Ver timeline
            </button>
            <button type="button" class="ta-accion" @onclick="Copiar">
                <MudIcon Icon="@(_copiado ? Icons.Material.Filled.Check : Icons.Material.Filled.ContentCopy)" /> @(_copiado ? "¡Copiado!" : "Copiar No. OC")
            </button>
        </div>

        @if (Orden.PctTiempoConsumido.HasValue)
        {
            var pct = Orden.PctTiempoConsumido.Value;
            var color = pct >= 100 ? "var(--op-vencido)" : pct >= 80 ? "var(--op-riesgo)" : "var(--op-cumplido)";
            <div class="mb-4">
                <div class="d-flex justify-space-between" style="font-size:.78rem">
                    <span class="ta-muted">Tiempo consumido del plazo (@(Orden.ComplejidadOC ?? "sin complejidad"))</span>
                    <b style="@($"color:{color}")">@pct.ToString("0")%</b>
                </div>
                <div class="kpi-prog" style="@($"height:8px;--kpi-color:{color}")">
                    <span style="@($"--w:{Math.Min(100, pct).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}%")"></span>
                </div>
            </div>
        }

        <div class="ta-campos mb-3">
            <div class="c"><span>Analista</span><b>@(Orden.AsignatarioOC ?? "Sin asignar")</b></div>
            <div class="c"><span>Categoría</span><b>@(Orden.CategoriaOC ?? "—")</b></div>
            <div class="c"><span>Complejidad</span><b>@(Orden.ComplejidadOC ?? "Sin asignar")</b></div>
            <div class="c"><span>Apertura</span><b>@(Orden.FechaAperturaOC?.ToString("dd/MM/yyyy") ?? "—")</b></div>
            <div class="c"><span>Vencimiento</span><b>@(Orden.FechaVencimientoOC?.ToString("dd/MM/yyyy") ?? "Sin fecha")</b></div>
            <div class="c"><span>Cierre</span><b>@(Orden.FechaCierreOC?.ToString("dd/MM/yyyy") ?? "Abierta")</b></div>
            <div class="c"><span>Días restantes</span><b>@(Orden.DiasRestantes?.ToString() ?? "—")</b></div>
            <div class="c"><span>Última gestión</span><b>@(Orden.UltimaGestion.HasValue ? Formato.Hace(Orden.UltimaGestion.Value.ToLocalTime()) : "Sin gestión")</b></div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Orden.ResumenOC))
        {
            <MudText Typo="Typo.overline" Class="ta-tenue">Resumen</MudText>
            <MudText Typo="Typo.body2" Class="mb-3" Style="white-space:pre-wrap">@Orden.ResumenOC</MudText>
        }

        <MudText Typo="Typo.overline" Class="ta-tenue">Tickets relacionados (@Orden.CantidadTickets)</MudText>
        @if (Orden.TieneTicketCerradoOcPendiente)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">Hay tickets cerrados mientras esta OC sigue abierta.</MudAlert>
        }
        @if (Orden.Tickets.Any())
        {
            <MudTable Items="Orden.Tickets" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.None" Class="ta-tabla-click"
                      T="TicketRelacionadoDto" OnRowClick="@((TableRowClickEventArgs<TicketRelacionadoDto> a) => AbrirTicket(a.Item!.NoTicket))">
                <HeaderContent><MudTh>Ticket</MudTh><MudTh>Tipo</MudTh><MudTh>Estado</MudTh><MudTh>Asignatario</MudTh><MudTh>SLA</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd><b>@context.NoTicket</b></MudTd>
                    <MudTd>@context.TipoCaso</MudTd>
                    <MudTd>
                        @context.Estado
                        @if (context.CerradoConCambioPendiente) { <span class="ta-tag warn ml-1">OC pendiente</span> }
                    </MudTd>
                    <MudTd>@Formato.NombreCorto(context.Asignatario)</MudTd>
                    <MudTd>
                        <span class="@($"ta-tag {(context.ResueltoDentroSLA == "SI" ? "ok" : context.ResueltoDentroSLA == "NO" ? "err" : "")}")">@context.ResueltoDentroSLA</span>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        else { <MudText Typo="Typo.caption" Class="ta-muted">Sin tickets relacionados.</MudText> }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cerrar">Cerrar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.EditNote" OnClick="AbrirGestion">Registrar gestión</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public OrdenCambioConTicketsDto Orden { get; set; } = default!;

    private bool _copiado;
    private bool _huboCambios;

    private void Cerrar()
    {
        if (_huboCambios) MudDialog.Close(DialogResult.Ok(true));
        else MudDialog.Cancel();
    }

    private async Task AbrirGestion()
    {
        var d = await DialogService.ShowAsync<ReporteGestionDialog>($"Gestión · {Orden.NoOC}",
            new DialogParameters { ["RefNum"] = Orden.NoOC, ["EsOrdenCambio"] = true },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        var r = await d.Result;
        if (r is { Canceled: false }) _huboCambios = true;
    }

    private async Task VerTimeline()
        => await DialogService.ShowAsync<TimelineDialog>($"Timeline · {Orden.NoOC}", new DialogParameters { ["RefNum"] = Orden.NoOC },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });

    private async Task Copiar()
    {
        if (!await Ui.CopiarAsync(Orden.NoOC)) { Snackbar.Add("No se pudo copiar al portapapeles.", Severity.Warning); return; }
        _copiado = true;
        StateHasChanged();
        await Task.Delay(1600);
        _copiado = false;
    }

    private async Task AbrirTicket(string refNum)
    {
        try
        {
            var t = await Api.ObtenerTicketAsync(refNum);
            if (t is null) { Snackbar.Add($"No encontramos el ticket {refNum}.", Severity.Warning); return; }
            await DialogService.ShowAsync<TicketDetalleDialog>($"Ticket {refNum}", new DialogParameters { ["Ticket"] = t },
                new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        }
        catch (Exception) { Snackbar.Add($"No pudimos abrir el ticket {refNum}.", Severity.Error); }
    }
}

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <div class="d-flex gap-2 align-center mb-2">
                    <MudChip T="string" Size="Size.Small" Color="@(Ticket.TipoCaso == "Incidente" ? Color.Error : Color.Primary)">@Ticket.TipoCaso</MudChip>
                    <MudText Typo="Typo.h6">@Ticket.NoTicket</MudText>
                    <MudSpacer />
                    <MudChip T="string" Size="Size.Small" Color="@(Ticket.ResueltoDentroSLA == "SI" ? Color.Success : Ticket.ResueltoDentroSLA == "NO" ? Color.Error : Color.Default)">SLA: @Ticket.ResueltoDentroSLA</MudChip>
                </div>
            </MudItem>
            <MudItem xs="12"><MudDivider /></MudItem>
            <Campo Label="Categoría" Valor="@Ticket.Categoria" />
            <Campo Label="Estado" Valor="@Ticket.Estado" />
            <Campo Label="Usuario final afectado" Valor="@Ticket.UsuarioFinalAfectado" />
            <Campo Label="Asignatario" Valor="@Ticket.Asignatario" />
            <Campo Label="Grupo" Valor="@Ticket.Grupo" />
            <Campo Label="Fecha de apertura" Valor="@Ticket.FechaApertura?.ToString("dd/MM/yyyy HH:mm")" />
            <Campo Label="Fecha cierre solicitado" Valor="@Ticket.FechaCierreSolicitado?.ToString("dd/MM/yyyy HH:mm")" />
            <MudItem xs="12">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Descripción</MudText>
                <MudText Typo="Typo.body2">@Ticket.Descripcion</MudText>
            </MudItem>

            @if (Ticket.TieneOrdenCambio)
            {
                <MudItem xs="12" Class="mt-2">
                    <MudPaper Class="@OcCardClass" Elevation="0" Outlined="true">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.ChangeCircle" Size="Size.Small" /> Orden de cambio @Ticket.NoOC
                        </MudText>
                        @if (Ticket.ReqCerradoConCambioPendiente)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">Ticket cerrado, pero la orden de cambio sigue pendiente.</MudAlert>
                        }
                        <MudGrid Spacing="2">
                            <Campo Label="Estado OC" Valor="@Ticket.EstadoOC" />
                            <Campo Label="Asignatario OC" Valor="@Ticket.AsignatarioOC" />
                            <Campo Label="Apertura OC" Valor="@Ticket.FechaAperturaOC?.ToString("dd/MM/yyyy")" />
                            <Campo Label="Cierre OC" Valor="@Ticket.FechaCierreSolicitadoOC?.ToString("dd/MM/yyyy")" />
                            <Campo Label="Complejidad OC" Valor="@(Ticket.ComplejidadOC ?? "Sin asignar")" />
                            <Campo Label="OC dentro de SLA" Valor="@Ticket.OCResueltoDentroSLA" />
                        </MudGrid>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cerrar">Cerrar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Assignment"
                   OnClick="AbrirGestion">Registrar gestión</MudButton>
    </DialogActions>
</MudDialog>

@inject IDialogService DialogService

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public TicketEnriquecidoDto Ticket { get; set; } = default!;
    private string OcCardClass => "pa-3 oc-card" + (Ticket.ReqCerradoConCambioPendiente ? " pendiente" : "");
    private void Cerrar() => MudDialog.Close();

    private async Task AbrirGestion()
    {
        var p = new DialogParameters
        {
            ["RefNum"] = Ticket.NoTicket,
            ["EsOrdenCambio"] = false,
            ["OrdenCambioRef"] = Ticket.NoOC   // si el trabajo sigue bajo la OC, queda enlazado
        };
        await DialogService.ShowAsync<ReporteGestionDialog>($"Gestión · {Ticket.NoTicket}", p,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
    }
}

@* Encabezado de página: título, bajada, indicador de actualización y acciones. *@
<div class="d-flex justify-space-between align-center flex-wrap gap-3 mb-4">
    <div>
        <MudText Typo="Typo.h5" Style="color:var(--texto-primario);font-weight:600">@Titulo</MudText>
        @if (!string.IsNullOrWhiteSpace(Bajada))
        {
            <MudText Typo="Typo.body2" Style="color:var(--texto-secundario)">@Bajada</MudText>
        }
    </div>
    <div class="d-flex align-center gap-2">
        @if (UltimaActualizacion.HasValue)
        {
            <MudText Typo="Typo.caption" Style="color:var(--texto-tenue)">
                @(Actualizando ? "Actualizando…" : $"Actualizado {Hace(UltimaActualizacion.Value)}")
            </MudText>
        }
        @Acciones
    </div>
</div>

@code {
    [Parameter] public string Titulo { get; set; } = "";
    [Parameter] public string? Bajada { get; set; }
    [Parameter] public DateTime? UltimaActualizacion { get; set; }
    [Parameter] public bool Actualizando { get; set; }
    [Parameter] public RenderFragment? Acciones { get; set; }

    private static string Hace(DateTime t)
    {
        var s = (DateTime.Now - t).TotalSeconds;
        if (s < 60) return $"hace {(int)s} s";
        if (s < 3600) return $"hace {(int)(s / 60)} min";
        return t.ToString("HH:mm");
    }
}

@* Encabezado de página: icono, título, bajada, indicador de actualización y acciones. *@
<header class="ta-page-header">
    <div class="titulo">
        @if (!string.IsNullOrEmpty(Icono))
        {
            <span class="icono"><MudIcon Icon="@Icono" /></span>
        }
        <div>
            <h1>@Titulo</h1>
            @if (!string.IsNullOrWhiteSpace(Bajada))
            {
                <p>@Bajada</p>
            }
        </div>
    </div>
    <div class="acciones">
        @if (Actualizando || UltimaActualizacion.HasValue)
        {
            <span class="@($"ta-actualizado {(Actualizando ? "cargando" : "")}")" title="@UltimaActualizacion?.ToString("dd/MM/yyyy HH:mm:ss")">
                <span class="punto"></span>
                @(Actualizando ? "Actualizando…" : $"Actualizado {UltimaActualizacion!.Value:HH:mm}")
            </span>
        }
        @if (OnRefrescar.HasDelegate)
        {
            <MudTooltip Text="Actualizar datos">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" Size="Size.Small"
                               aria-label="Actualizar datos" Disabled="Actualizando" OnClick="OnRefrescar" />
            </MudTooltip>
        }
        @Acciones
    </div>
</header>

@code {
    [Parameter] public string Titulo { get; set; } = "";
    [Parameter] public string? Bajada { get; set; }
    [Parameter] public string? Icono { get; set; }
    [Parameter] public DateTime? UltimaActualizacion { get; set; }
    [Parameter] public bool Actualizando { get; set; }
    [Parameter] public EventCallback OnRefrescar { get; set; }
    [Parameter] public RenderFragment? Acciones { get; set; }
}

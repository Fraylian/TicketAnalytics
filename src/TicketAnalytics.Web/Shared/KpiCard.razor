@* Tarjeta KPI: valor, icono, comparación con período anterior, sparkline y drill-down. *@
@if (Cargando)
{
    <div class="kpi @AcentoClass">
        <MudSkeleton Width="60%" Height="14px" />
        <MudSkeleton Width="45%" Height="34px" Class="mt-2" />
        <MudSkeleton Width="70%" Height="12px" Class="mt-2" />
    </div>
}
else
{
    <div class="kpi @AcentoClass @(EsClickable ? "kpi--clickable ta-clickable" : "") ta-hover-card"
         @onclick="Clic" @onkeydown="Tecla"
         tabindex="@(EsClickable ? 0 : -1)"
         aria-label="@($"{Titulo}: {Valor}")">
        <div>
            <div class="d-flex justify-space-between align-start">
                <div class="kpi-etiqueta">@Titulo</div>
                @if (!string.IsNullOrEmpty(Icono))
                {
                    <MudIcon Icon="@Icono" Size="Size.Small" Style="@($"color:{ColorHex};opacity:.55")" />
                }
            </div>
            <div class="kpi-valor" style="@($"color:{ColorHex}")">@Valor</div>
            @if (!string.IsNullOrEmpty(Nota))
            {
                <div class="kpi-nota">@Nota</div>
            }
        </div>

        <div class="d-flex justify-space-between align-end gap-2">
            @if (Delta.HasValue || Tendencia.HasValue)
            {
                <div class="kpi-nota d-flex align-center gap-1" style="@($"color:{ColorDelta}")">
                    <MudIcon Icon="@IconoDelta" Size="Size.Small" />
                    <span>@TextoDelta</span>
                </div>
            }
            @if (Sparkline is { Count: > 1 })
            {
                <svg class="kpi-spark" viewBox="0 0 100 28" preserveAspectRatio="none" aria-hidden="true">
                    <polyline points="@PuntosSpark" fill="none" stroke="@ColorHex" stroke-width="2"
                              stroke-linecap="round" stroke-linejoin="round" opacity=".7" />
                </svg>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string Titulo { get; set; } = "";
    [Parameter] public string Valor { get; set; } = "";
    [Parameter] public string? Nota { get; set; }
    [Parameter] public string? Icono { get; set; }
    /// <summary>azul | verde | vencido | riesgo | cumplido | curso | neutro</summary>
    [Parameter] public string Acento { get; set; } = "azul";
    [Parameter] public double? Tendencia { get; set; }
    [Parameter] public string TendenciaSufijo { get; set; } = "%";
    /// <summary>Diferencia absoluta contra el período anterior (ej. +3).</summary>
    [Parameter] public int? Delta { get; set; }
    /// <summary>Texto del período con el que se compara (ej. "julio").</summary>
    [Parameter] public string? ComparadoCon { get; set; }
    /// <summary>Serie corta para el sparkline (opcional).</summary>
    [Parameter] public List<double>? Sparkline { get; set; }
    [Parameter] public bool Cargando { get; set; }
    /// <summary>True si un delta positivo es malo (ej. "vencidos"): invierte el color.</summary>
    [Parameter] public bool DeltaPositivoEsMalo { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private bool EsClickable => OnClick.HasDelegate;

    private string AcentoClass => Acento switch
    {
        "vencido" => "kpi--acento-vencido",
        "riesgo" => "kpi--acento-riesgo",
        "cumplido" or "verde" => "kpi--acento-cumplido",
        "curso" or "azul" => "kpi--acento-azul",
        _ => ""
    };

    private string ColorHex => Acento switch
    {
        "vencido" => "var(--op-vencido)",
        "riesgo" => "var(--op-riesgo)",
        "cumplido" or "verde" => "var(--op-cumplido)",
        "curso" or "azul" => "var(--bsc-azul)",
        _ => "var(--texto-primario)"
    };

    private double ValorComparacion => Delta ?? Tendencia ?? 0;

    private string ColorDelta
    {
        get
        {
            var v = ValorComparacion;
            if (v == 0) return "var(--texto-tenue)";
            var bueno = DeltaPositivoEsMalo ? v < 0 : v > 0;
            return bueno ? "var(--op-cumplido)" : "var(--op-vencido)";
        }
    }

    private string IconoDelta => ValorComparacion > 0 ? Icons.Material.Filled.TrendingUp
                               : ValorComparacion < 0 ? Icons.Material.Filled.TrendingDown
                               : Icons.Material.Filled.TrendingFlat;

    private string TextoDelta
    {
        get
        {
            if (Delta.HasValue)
            {
                var signo = Delta.Value > 0 ? "+" : "";
                var comp = string.IsNullOrWhiteSpace(ComparadoCon) ? "" : $" vs {ComparadoCon}";
                return $"{signo}{Delta.Value}{comp}";
            }
            return Tendencia.HasValue ? $"{Math.Abs(Tendencia.Value)}{TendenciaSufijo}" : "";
        }
    }

    /// <summary>Convierte la serie a puntos del polyline, normalizada al alto del SVG.</summary>
    private string PuntosSpark
    {
        get
        {
            var s = Sparkline!;
            double min = s.Min(), max = s.Max();
            double rango = Math.Abs(max - min) < 0.0001 ? 1 : max - min;
            var pasos = s.Count - 1;
            var ci = System.Globalization.CultureInfo.InvariantCulture;
            return string.Join(" ", s.Select((v, i) =>
            {
                var x = pasos == 0 ? 0 : i * 100.0 / pasos;
                var y = 26 - ((v - min) / rango * 24);
                return $"{x.ToString("0.##", ci)},{y.ToString("0.##", ci)}";
            }));
        }
    }

    private async Task Clic() { if (EsClickable) await OnClick.InvokeAsync(); }

    private async Task Tecla(KeyboardEventArgs e)
    {
        if (EsClickable && (e.Key == "Enter" || e.Key == " ")) await OnClick.InvokeAsync();
    }
}
